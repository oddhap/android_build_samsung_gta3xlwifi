@@ -658,6 +658,45 @@ static ssize_t set_min_lock_dvfs(struct device *dev, struct device_attribute *at
 	return count;
 }
 
+/* Framework owns a separate minimum request; thermal maximums still win. */
+static ssize_t show_framework_min_lock(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	unsigned long flags;
+	int clock;
+	struct exynos_context *platform = pkbdev->platform_context;
+
+	if (!platform)
+		return -ENODEV;
+	spin_lock_irqsave(&platform->gpu_dvfs_spinlock, flags);
+	clock = platform->user_min_lock[FRAMEWORK_LOCK];
+	spin_unlock_irqrestore(&platform->gpu_dvfs_spinlock, flags);
+	return scnprintf(buf, PAGE_SIZE, "%d\n", clock);
+}
+
+static ssize_t set_framework_min_lock(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	int clock, ret;
+	struct exynos_context *platform = pkbdev->platform_context;
+
+	if (!platform)
+		return -ENODEV;
+	ret = kstrtoint(buf, 0, &clock);
+	if (ret)
+		return ret;
+	if (!clock) {
+		ret = gpu_dvfs_clock_lock(GPU_DVFS_MIN_UNLOCK, FRAMEWORK_LOCK, 0);
+	} else {
+		if (clock < platform->gpu_min_clock || clock > platform->gpu_max_clock ||
+				gpu_dvfs_get_level(clock) < 0)
+			return -EINVAL;
+		clock = min(clock, platform->gpu_max_clock_limit);
+		ret = gpu_dvfs_clock_lock(GPU_DVFS_MIN_LOCK, FRAMEWORK_LOCK, clock);
+	}
+	return ret < 0 ? ret : count;
+}
+
 static ssize_t show_down_staycount(struct device *dev, struct device_attribute *attr, char *buf)
 {
 	ssize_t ret = 0;
@@ -1450,6 +1489,7 @@ DEVICE_ATTR(dvfs_max_lock_status, S_IRUGO, show_max_lock_status, NULL);
