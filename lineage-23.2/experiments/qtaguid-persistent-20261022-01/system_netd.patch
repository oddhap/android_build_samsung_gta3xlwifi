+++ b/server/Gta3xlwifiQtaguidTransport.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <sys/types.h>
+
+namespace android::net::gta3xlwifi {
+
+// Trusted low-level I/O only, NOT a public tagSocket policy endpoint or backend
+// readiness proof. The owner must authorize charge UID/CLAT, enforce tag budgets,
+// and validate the entire backend before publishing any state/callback.
+// One instance owns the process's sole /dev/xt_qtaguid session. Never silently
+// reuse another owner's session on EBUSY. Requires the private socket-owned
+// kernel ioctl: legacy process-owned cleanup loses live tags on Netd restart.
+// Tags are deliberately not owned by this session after the ioctl succeeds;
+// explicit untag/UID deletion/final socket release retire them. Opening this
+// transport does not reconstruct authorization or firewall state after restart.
+class QtaguidTransport final {
+  public:
+    QtaguidTransport() = default;
+    ~QtaguidTransport();
+    QtaguidTransport(const QtaguidTransport&) = delete;
+    QtaguidTransport& operator=(const QtaguidTransport&) = delete;
+
+    int start();
+    int tagSocket(int socketFd, uint32_t tag, uid_t chargeUid);
+    int untagSocket(int socketFd);
+
+  private:
+    int commandLocked(int socketFd, uint32_t tag, uid_t chargeUid, bool untag);
+    void closeLocked();
+    std::mutex mMutex;
+    int mDevice = -1;
+    int mControl = -1;
+};
+
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiQtaguidProtocol.h b/server/Gta3xlwifiQtaguidProtocol.h
new file mode 100644
--- /dev/null
+++ b/server/Gta3xlwifiQtaguidProtocol.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_XT_QTAGUID_SOCK_H
+#define _UAPI_XT_QTAGUID_SOCK_H
+
+#include <linux/ioctl.h>
+
+/* Private, opt-in gta3xlwifi ABI. No argument, same command on 32/64 bit.
+ * Requires initial-namespace root plus CAP_NET_ADMIN and an empty own session.
+ * New/retagged sockets then own their tags until explicit untag, UID deletion
+ * or inet_release, not until the tagging daemon's process/session exits.
+ * This does not authorize a caller or implement accounting budgets/readiness.
+ */
+#define QTAGUID_SOCKET_OWNED_SESSION _IO('q', 0x51)
+
+#endif
