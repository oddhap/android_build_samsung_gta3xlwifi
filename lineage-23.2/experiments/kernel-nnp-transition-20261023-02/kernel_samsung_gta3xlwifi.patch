 	{ "binder", { "impersonate", "call", "set_context_mgr", "transfer",
 		      NULL } },
+	/* Append: preserve every pre-existing kernel class/permission ID. */
+	{ "process2", { "nnp_transition", "nosuid_transition", NULL } },
 	{ NULL }
   };
