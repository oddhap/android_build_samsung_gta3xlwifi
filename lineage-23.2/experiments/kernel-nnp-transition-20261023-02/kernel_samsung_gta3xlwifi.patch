diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -2299,8 +2299,21 @@
 			    const struct task_security_struct *new_tsec)
 {
 	int nnp = (bprm->unsafe & LSM_UNSAFE_NO_NEW_PRIVS);
-	int nosuid = (bprm->file->f_path.mnt->mnt_flags & MNT_NOSUID);
+	int nosuid = (bprm->file->f_path.mnt->mnt_flags & MNT_NOSUID) ||
+		     !our_mnt(bprm->file->f_path.mnt);
 	int rc;
+	u32 av;
+
+	/*
+	 * Equivalent to modern mnt_may_suid() for this USER_NS=n kernel:
+	 * our_mnt() is check_mnt(real_mount(mnt)), and current_in_userns()
+	 * is always true without user namespaces. Foreign mounts must not
+	 * bypass nosuid checks through inherited FDs or /proc paths.
+	 * A USER_NS build needs a full superblock-owner backport first.
+	 */
+#ifdef CONFIG_USER_NS
+#error "gta3xlwifi NNP backport requires CONFIG_USER_NS=n"
+#endif
 
 	if (!nnp && !nosuid)
 		return 0; /* neither NNP nor nosuid */
@@ -2309,8 +2322,25 @@
 		return 0; /* No change in credentials */
 
 	/*
-	 * The only transitions we permit under NNP or nosuid
-	 * are transitions to bounded SIDs, i.e. SIDs that are
+	 * The policy may explicitly allow the transition under NNP/nosuid.
+	 * Require every applicable process2 permission, not just either one.
+	 * Regular process:transition and file:entrypoint checks still follow
+	 * in selinux_bprm_set_creds(). Keep the bounded-SID fallback below.
+	 */
+	if (selinux_policycap_nnp_nosuid_transition) {
+		av = 0;
+		if (nnp)
+			av |= PROCESS2__NNP_TRANSITION;
+		if (nosuid)
+			av |= PROCESS2__NOSUID_TRANSITION;
+		rc = avc_has_perm(old_tsec->sid, new_tsec->sid,
+				  SECCLASS_PROCESS2, av, NULL);
+		if (!rc)
+			return 0;
+	}
+
+	/*
+	 * We also permit transitions to bounded SIDs, i.e. SIDs that are
 	 * guaranteed to only be allowed a subset of the permissions
 	 * of the current SID.
 	 */
