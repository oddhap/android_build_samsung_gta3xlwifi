+    int ret;
+    do {
+        if (!sendSignalToProcessGroup(uid, pid, signal) && errno != ENOENT) return -1;
+        ret = RemoveCgroup(root.c_str(), uid, pid, false);
+        if (ret && errno != EBUSY) return ret;
