+    ssize_t count = TEMP_FAILURE_RETRY(write(fd, command.data(), command.size()));
+    int err = count == static_cast<ssize_t>(command.size()) ? 0 : (count < 0 ? -errno : -EIO);
+    close(fd);
+    return err;
+}
 
