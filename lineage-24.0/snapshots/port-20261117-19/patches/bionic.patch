+++ b/libc/upstream-openbsd/android/include/arc4random.h
@@ -18,7 +18,9 @@
  * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
  */
 
+#include <errno.h>
 #include <pthread.h>
+#include <sys/random.h>
 #include <sys/mman.h>
 #include <sys/prctl.h>
 
@@ -41,6 +43,43 @@ static inline void _getentropy_fail(void) {
   async_safe_fatal("getentropy failed: %m");
 }
 
+// Linux 4.4 lacks MADV_WIPEONFORK. Never use a fork-inherited userspace
+// generator on that kernel: obtain every requested byte from blocking getrandom.
+// This mode stores no entropy/keystream and therefore has no inherited RNG state.
+// The mode probe is serialized by the existing arc4random/fork mutex protocol.
+static inline int _rs_kernel_entropy_only(void) {
+  static int mode;  // 0 unprobed, 1 original WIPEONFORK generator, 2 kernel-only.
+  if (mode == 0) {
+    const size_t size = 4096;
+    void* p = mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_ANON|MAP_PRIVATE, -1, 0);
+    if (p == MAP_FAILED) async_safe_fatal("arc4random feature allocation failed: %m");
+    int rc = madvise(p, size, MADV_WIPEONFORK);
+    int error = errno;
+    if (munmap(p, size) == -1) async_safe_fatal("arc4random feature cleanup failed: %m");
+    if (rc == 0) mode = 1;
+    else if (error == EINVAL) mode = 2;
+    else {
+      errno = error;
+      async_safe_fatal("arc4random fork-wipe probe failed: %m");
+    }
+  }
+  return mode == 2;
+}
+
+static inline void _rs_kernel_entropy_buf(void* buffer, size_t n) {
+  unsigned char* out = buffer;
+  while (n != 0) {
+    // Blocking kernel CSPRNG, no weak entropy, cached seed or urandom fallback.
+    size_t request = n > 256 ? 256 : n;
+    ssize_t count = getrandom(out, request, 0);
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0 || (size_t)count > request)
+      async_safe_fatal("arc4random kernel entropy failed: %m");
+    out += count;
+    n -= (size_t)count;
+  }
+}
+
 static inline void _rs_forkdetect(void) {
   // Not needed thanks to the MADV_WIPEONFORK below.
 }
