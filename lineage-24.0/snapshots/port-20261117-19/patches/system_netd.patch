+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <cerrno>
+#include <sys/types.h>
+namespace android::net::gta3xlwifi {
+// Trusted native transport dependency. No authorization/readiness implied by
+// connection. The sole policy owner checks permissions/budgets and invokes I/O
+// under its transaction mutex. Never accept such an object from a Binder caller.
+class SocketTagger {
+ public:
+  virtual ~SocketTagger() = default;
+  virtual bool connected() const = 0;
+  virtual int tagSocket(int fd, uint32_t tag, uid_t uid) = 0;
+  virtual int untagSocket(int fd) = 0;
+  // Dedicated trusted CLAT operation; older explicit fixtures fail unavailable.
+  virtual int tagClatSocket(int fd) { (void)fd; return -EOPNOTSUPP; }
+};
+}  // namespace android::net::gta3xlwifi
