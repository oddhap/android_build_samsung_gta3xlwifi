@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstdint>
+#include <array>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "IptablesRestoreController.h"
+
+namespace android::net::gta3xlwifi {
+
+// Checked updates of EXISTING owned chains in ONE address family. This is an
+// I/O component, not complete packet policy, cross-family atomicity, attachment
+// ownership, startup, persistence or network readiness. Its caller must be the
+// sole owner and hold the netd firewall transaction lock across each operation.
+class CheckedUidChains {
+public:
+    enum class Table { Filter, Socket };
+    struct UidRange {
+        uint32_t first;
+        uint32_t last;
+        bool operator==(const UidRange& b) const { return first == b.first && last == b.last; }
+    };
+    enum class Verdict { Return, Drop, Reject, DataSaverGoto, UidCall };
+    enum class Selector { Owner, LookupAppId, RawUid, RawAppId, OwnerSkip, NonLoopback };
+    struct IngressDiscard {
+        std::array<uint8_t,16> daddr{};
+        std::array<uint32_t,2> allowedIfIndex{};
+        bool operator==(const IngressDiscard& b) const {
+            return daddr == b.daddr && allowedIfIndex == b.allowedIfIndex;
+        }
+    };
+    struct Rule {
+        std::optional<UidRange> uid;
+        Verdict verdict;
+        Selector selector = Selector::Owner;
+        uint8_t targetUidChain = 0;
+        std::optional<uint32_t> ingressIfIndex = std::nullopt;
+        std::optional<IngressDiscard> ingressDiscard = std::nullopt;
+        bool operator==(const Rule& b) const {
+            return uid == b.uid && verdict == b.verdict && selector == b.selector && targetUidChain == b.targetUidChain &&
+                   ingressIfIndex == b.ingressIfIndex && ingressDiscard == b.ingressDiscard;
+        }
+    };
+    struct Chain {
+        std::string name;
+        std::vector<Rule> rules;
+        bool operator==(const Chain& b) const { return name == b.name && rules == b.rules; }
+    };
+    // Use the exact encoder/limits without any kernel I/O.
+    static int validateImage(const std::vector<Chain>& image, Table table = Table::Filter);
+    explicit CheckedUidChains(IptablesRestoreInterface& kernel, Table table = Table::Filter)
+        : mKernel(kernel), mTable(table) {}
+    int read(IptablesTarget family, const std::vector<std::string>& names,
+             std::vector<Chain>* output);
+    // Success requires exact ordered kernel readback. Any failed write or
+    // mismatch restores the actual before-image and verifies it. -EUCLEAN means
+    // restoration could not be verified: caller MUST quarantine/fail closed;
+    // no callback, readiness or cached policy may be published from this result.
+    int replace(IptablesTarget family, const std::vector<Chain>& desired);
+
+private:
+    int readLocked(IptablesTarget family, const std::vector<std::string>& names,
+                   std::vector<Chain>* output);
+    int writeLocked(IptablesTarget family, const std::vector<Chain>& image);
+    static int encode(const std::vector<Chain>& image, std::string* output, Table table);
+    static bool validTableNames(Table table, const std::vector<std::string>& names);
+    static bool validTableImage(Table table, const std::vector<Chain>& image);
+    static bool validNames(const std::vector<std::string>& names);
+    static bool validImage(const std::vector<Chain>& image);
+    IptablesRestoreInterface& mKernel;
+    const Table mTable;
+    std::mutex mMutex;
+};
+
+}  // namespace android::net::gta3xlwifi
