--- /dev/null
+++ b/server/Gta3xlwifiNetpolicyService.cpp
@@ -0,0 +1,332 @@
+#include "Gta3xlwifiHeldProvider.h"
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiNetpolicyService.h"
+#include <binder/IPCThreadState.h>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+namespace android::net::gta3xlwifi {
+namespace {
+using ::android::binder::Status;
+Status status(int result) {
+  return result ? Status::fromServiceSpecificError(result < 0 ? -result : EPROTO) : Status::ok();
+}
+Status denied() { return Status::fromExceptionCode(Status::EX_SECURITY); }
+}
+class NetpolicyService::ClientDeath final : public IBinder::DeathRecipient {
+ public:
+  ClientDeath(const wp<NetpolicyService>& service,int64_t session)
+      : mService(service),mSession(session) {}
+  void binderDied(const wp<IBinder>&) override {
+    if (auto service=mService.promote()) service->clientDied(mSession);
+  }
+ private:
+  wp<NetpolicyService> mService;
+  int64_t mSession;
+};
+bool NetpolicyService::authorized() {
+  // Full UID, not appId; root, network-stack and secondary-user system IDs are
+  // not implicit policy owners. Checked on every RPC, not just handle lookup.
+  return IPCThreadState::self()->getCallingUid()==1000;
+}
+int NetpolicyService::validateSession(int64_t session) const {
+  return mClient && session>0 && session==mSession ? 0 : -ESTALE;
+}
+Status NetpolicyService::openSession(const sp<IBinder>& client,int32_t version,int64_t* output) {
+  if (!authorized()) return denied();
+  if (!client || !output || version!=1) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  if (mClient) {
+    if (mClient!=client) return status(-EBUSY);
+    *output=mSession;
+    return Status::ok();
+  }
+  if (mSerial==INT64_MAX) return status(-EOVERFLOW);
+  int result=mOwner.verifyHeldProviderStartup();
+  if (result) return status(result);
+  const int64_t session=++mSerial;
+  auto death=sp<ClientDeath>::make(wp<NetpolicyService>::fromExisting(this),session);
+  if (client->linkToDeath(death)!=OK) return status(-EPIPE);
+  mClient=client; mDeath=death; mSession=session;
+  *output=session;
+  return Status::ok();
+}
+Status NetpolicyService::beginFrame(int64_t session,int64_t expected,
+    const std::vector<int32_t>& counts,int32_t flags,bool loopback,bool migration,bool dataSaver) {
+  if (!authorized()) return denied();
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  if (expected<0) return status(-EINVAL);
+  uint64_t generation=0;
+  result=mOwner.frameworkGeneration(&generation);
+  if (result) return status(result);
+  if (static_cast<uint64_t>(expected)!=generation) return status(-ESTALE);
+  result=mFrame.begin(counts,static_cast<uint32_t>(flags),loopback,migration,dataSaver);
+  if (!result) mExpected=generation;
+  return status(result);
+}
+Status NetpolicyService::appendFrame(int64_t session,int32_t section,int32_t offset,
+                                     const std::vector<int32_t>& words) {
+  if (!authorized()) return denied();
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  if (section<0 || offset<0) return status(-EINVAL);
+  return status(mFrame.append(section,offset,words));
+}
+Status NetpolicyService::commitFrame(int64_t session,int64_t* output) {
+  if (!authorized()) return denied();
+  if (!output) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  SocketPolicyProjection::State next;
+  result=mFrame.compile(&next);
+  if (result) return status(result);
+  uint64_t generation=0;
+  result=mOwner.replaceWithGeneration(next,mExpected,&generation);
+  // An uncertain kernel commit must never be retried implicitly. Explicit new
+  // state collection/lease recovery is required; no old frame remains staged.
+  mFrame.clear();
+  if (result) return status(result);
+  if (generation>INT64_MAX) {
+    mOwner.suspendFrameworkClient();
+    return status(-EOVERFLOW);
+  }
+  *output=static_cast<int64_t>(generation);
+  return Status::ok();
+}
+Status NetpolicyService::abandonFrame(int64_t session) {
+  if (!authorized()) return denied();
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  mFrame.clear();
+  return Status::ok();
+}
+Status NetpolicyService::readGeneration(int64_t session,int64_t* output) {
+  if (!authorized()) return denied();
+  if (!output) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  uint64_t generation=0;
+  result=mOwner.frameworkGeneration(&generation);
+  if (result) return status(result);
+  if (generation>INT64_MAX) return status(-EOVERFLOW);
+  *output=static_cast<int64_t>(generation);
+  return Status::ok();
+}
+Status NetpolicyService::closeSession(const sp<IBinder>& client) {
+  if (!authorized()) return denied();
+  std::lock_guard lock(mMutex);
+  if (!client || !mClient || client!=mClient) return status(-ESTALE);
+  mFrame.clear();
+  int result=mOwner.suspendFrameworkClient();
+  // Death may already be queued: its session check still rejects a later owner.
+  mClient->unlinkToDeath(mDeath);
+  mClient.clear(); mDeath.clear(); mSession=0;
+  return status(result);
+}
+void NetpolicyService::clientDied(int64_t session) {
+  std::lock_guard lock(mMutex);
+  if (validateSession(session)) return; // Stale death cannot close a newer owner.
+  mFrame.clear();
+  mOwner.suspendFrameworkClient(); // Failure closes the real lease and holds too.
+  mClient.clear(); mDeath.clear(); mSession=0;
+}
+namespace {
+// AIDL long transports the actual unsigned counter bits, including bit63.
+int64_t statsWord(uint64_t value) {
+  int64_t output;
+  static_assert(sizeof(output) == sizeof(value));
+  memcpy(&output, &value, sizeof(output));
+  return output;
+}
+void counters(std::vector<int64_t>& words, uint64_t rxPackets, uint64_t rxBytes,
+              uint64_t txPackets, uint64_t txBytes) {
+  words.insert(words.end(), {statsWord(rxPackets), statsWord(rxBytes),
+                            statsWord(txPackets), statsWord(txBytes)});
+}
+}
+Status NetpolicyService::readStats(int64_t session, int32_t kind, int32_t bank,
+    int64_t epoch, std::vector<int64_t>* output) {
+  if (!authorized()) return denied();
+  if (!output || kind < 0 || kind > 5 || bank < 0 || bank > 1 ||
+      (kind == 1 ? epoch == 0 : (bank != 0 || epoch != 0))) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result = validateSession(session);
+  if (result) return status(result);
+  std::vector<int64_t> next{1, kind};
+  if (kind == 5) {
+    NetpolicyLease::UidCleanupReceipt value;
+    result=mOwner.readUidCleanup(&value);
+    if(!result)next.insert(next.end(),{value.phase,value.uid,statsWord(value.nonce),
+                                      statsWord(value.generation),statsWord(value.activeEpoch)});
+  } else if (kind == 0) {
+    NetpolicyLease::PacketState value;
+    result = mOwner.readPacketState(&value);
+    if (!result) next.insert(next.end(), {
+        value.activeBank, statsWord(value.activeEpoch), value.pendingMask,
+        value.bankCount[0], value.bankCount[1],
+        statsWord(value.bankEpoch[0]), statsWord(value.bankEpoch[1]),
+        statsWord(value.bankLost[0]), statsWord(value.bankLost[1]),
+        value.appCount, value.countersetCount, statsWord(value.appLost),
+        statsWord(value.totalStatsLost)});
+  } else if (kind == 1) {
+    NetpolicyLease::PacketSnapshot value;
+    result = mOwner.readFrozenPacketStats(bank, static_cast<uint64_t>(epoch), &value);
+    if (!result && value.entries.size() > 5000) result = -EOVERFLOW;
+    if (!result) {
+      next.insert(next.end(), {bank, statsWord(value.epoch), statsWord(value.sequence),
+                               statsWord(value.lostUpdates),
+                               static_cast<int64_t>(value.entries.size())});
+      for (const auto& row : value.entries) {
+        next.insert(next.end(), {row.uid, row.tag, row.counterset, row.ifindex});
+        counters(next, row.rxPackets, row.rxBytes, row.txPackets, row.txBytes);
+      }
+    }
+  } else if (kind == 2) {
+    NetpolicyLease::AppSnapshot value;
+    result = mOwner.readAppStats(&value);
+    if (!result && value.entries.size() > 10000) result = -EOVERFLOW;
+    if (!result) {
+      next.insert(next.end(), {statsWord(value.sequence), statsWord(value.lostUpdates),
+                               static_cast<int64_t>(value.entries.size())});
+      for (const auto& row : value.entries) {
+        next.push_back(row.uid);
+        counters(next, row.rxPackets, row.rxBytes, row.txPackets, row.txBytes);
+      }
+    }
+  } else if (kind == 3) {
+    NetpolicyLease::IfaceSnapshot value;
+    result = mOwner.readIfaceStats(&value);
+    if (!result && value.entries.size() > 1000) result = -EOVERFLOW;
+    if (!result) {
+      next.insert(next.end(), {statsWord(value.updateSequence), statsWord(value.lostUpdates),
+                               static_cast<int64_t>(value.entries.size())});
+      for (const auto& row : value.entries) {
+        next.push_back(row.ifindex);
+        counters(next, row.rxPackets, row.rxBytes, row.txPackets, row.txBytes);
+      }
+    }
+  }
+  if (!result && kind == 4) {
+    NetpolicyLease::IfaceNamesSnapshot value;
+    result = mOwner.readIfaceNames(&value);
+    if (!result && value.entries.size() > 1000) result = -EOVERFLOW;
+    if (!result) {
+      next.insert(next.end(), {statsWord(value.sequence), statsWord(value.lostUpdates),
+                               static_cast<int64_t>(value.entries.size())});
+      for (const auto& row : value.entries) {
+        next.push_back(row.ifindex);
+        for (unsigned group=0;group<4;++group) {
+          uint32_t word=0;
+          for (unsigned byte=0;byte<4;++byte)
+            word=(word<<8)|static_cast<unsigned char>(row.name[group*4+byte]);
+          next.push_back(word);
+        }
+      }
+    }
+  }
+  if (result) return status(result);
+  // At most400040 payload bytes, below Binder's transaction buffer. Reads are
+  // non-consuming; a failed Binder delivery never causes ACK or loss of rows.
+  if (next.size() > 50005) return status(-EOVERFLOW);
+  *output = std::move(next);
+  return Status::ok();
+}
+Status NetpolicyService::swapStats(int64_t session, int32_t bank, int64_t epoch,
+    std::vector<int64_t>* output) {
+  if (!authorized()) return denied();
+  if (!output || bank < 0 || bank > 1 || !epoch) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result = validateSession(session);
+  if (result) return status(result);
+  NetpolicyLease::BankTransition value;
+  result = mOwner.swapPacketStats(bank, static_cast<uint64_t>(epoch), &value);
+  if (result) return status(result);
+  *output = {value.activeBank, statsWord(value.activeEpoch),
+             value.inactiveBank, statsWord(value.inactiveEpoch)};
+  return Status::ok();
+}
+Status NetpolicyService::acknowledgeStats(int64_t session, int32_t bank, int64_t epoch) {
+  if (!authorized()) return denied();
+  if (bank < 0 || bank > 1 || !epoch) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result = validateSession(session);
+  if (result) return status(result);
+  return status(mOwner.acknowledgePacketStats(bank, static_cast<uint64_t>(epoch)));
+}
+Status NetpolicyService::setStatsCounterset(int64_t session, int32_t uid, int32_t counterset) {
+  if (!authorized()) return denied();
+  if (uid < 0 || counterset < 0 || counterset > 1) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result = validateSession(session);
+  if (result) return status(result);
+  return status(mOwner.setPacketCounterset(uid, counterset));
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+Status NetpolicyService::removeUidAccounting(int64_t session, int32_t uid,
+        int64_t expectedGeneration, int64_t expectedActiveEpoch) {
+  if (!authorized()) return denied();
+  if (uid < 0 || expectedGeneration < 0 || !expectedActiveEpoch) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result = validateSession(session);
+  if (result) return status(result);
+  return status(removeUidAccountingFromProvider(mOwner, uid,
+      static_cast<uint64_t>(expectedGeneration), static_cast<uint64_t>(expectedActiveEpoch)));
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+Status NetpolicyService::removeUidAccountingOnce(int64_t session,int32_t uid,
+        int64_t generation,int64_t epoch,int64_t nonce) {
+  if(!authorized())return denied();
+  if(uid<0||generation<0||!epoch||!nonce)return status(-EINVAL);
+  std::lock_guard lock(mMutex);int result=validateSession(session);if(result)return status(result);
+  return status(removeUidAccountingOnceFromProvider(mOwner,uid,
+      static_cast<uint64_t>(generation),static_cast<uint64_t>(epoch),static_cast<uint64_t>(nonce)));
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+Status NetpolicyService::abortSession(int64_t session,const sp<IBinder>& client) {
+  if(!authorized())return denied();
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);if(result)return status(result);
+  if(!client||client!=mClient)return status(-ESTALE);
+  return status(mOwner.abortFrameworkClient());
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+Status NetpolicyService::pollLoopbackEvents(int64_t session,std::vector<int64_t>* output) {
+  if(!authorized())return denied();
+  if(!output)return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);if(result)return status(result);
+  // Reserve the maximum reply BEFORE the destructive kernel read. An uncertain
+  // Binder delivery is not retried; the framework aborts its exact owner.
+  std::vector<int64_t> next;next.reserve(4+512*6);
+  NetpolicyLease::LoopbackBatch batch;
+  result=mOwner.readLoopbackEvents(&batch);if(result)return status(result);
+  next.insert(next.end(),{1,6,statsWord(batch.lostEvents),static_cast<int64_t>(batch.events.size())});
+  for(const auto& e:batch.events)next.insert(next.end(),{e.senderUid,e.receiverUid,e.result,
+      statsWord(e.boottimeNs),statsWord(e.sequence),statsWord(e.lostEvents)});
+  *output=std::move(next);return Status::ok();
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+Status NetpolicyService::tagClatSocket(int64_t session,const ::android::os::ParcelFileDescriptor& socket) {
+  if(!authorized())return denied();
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);if(result)return status(result);
+  if(socket.get()<0)return status(-EINVAL);
+  return status(tagClatSocketFromProvider(mOwner,socket.get()));
+}
+}  // namespace android::net::gta3xlwifi
