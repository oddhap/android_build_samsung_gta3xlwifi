+  return r ? quarantine(r) : 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::packetAccountingAvailableLocked() const {
+  if (!mStarted || !mCommit) return -EAGAIN;
+  return mAccountingEnabled ? 0 : -EOPNOTSUPP;
+}
+int SocketPolicyProjection::readPacketState(NetpolicyLease::PacketState* output) {
+  if (!output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readPacketState(output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::readFrozenPacketStats(
+    uint32_t bank, uint64_t epoch, NetpolicyLease::PacketSnapshot* output) {
+  if (!output || bank > 1 || !epoch) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readFrozenPacketStats(bank, epoch, output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::readAppStats(NetpolicyLease::AppSnapshot* output) {
+  if (!output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readAppStats(output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::swapPacketStats(
+    uint32_t bank, uint64_t epoch, NetpolicyLease::BankTransition* output) {
+  if (!output || bank > 1 || !epoch || epoch == UINT64_MAX) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.swapPacketStats(bank, epoch, output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::acknowledgePacketStats(uint32_t bank, uint64_t epoch) {
+  if (bank > 1 || !epoch) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.acknowledgePacketStats(bank, epoch);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::setPacketCounterset(int32_t uid, uint32_t counterset) {
+  if (uid < 0 || counterset > 1) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  // Counterset metadata may be set after real producers were verified while
+  // HOLD still blocks traffic. It neither publishes policy nor releases HOLD.
+  if (!mStarted) return -EAGAIN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  int result = mLease.setPacketCounterset(static_cast<uint32_t>(uid), counterset);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::removeUidAccounting(int32_t uid, uint64_t expectedGeneration,
+        uint64_t expectedActiveEpoch, UidTagDeleter deleteTags) {
+  if (uid < 0 || !expectedActiveEpoch || !deleteTags) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -EAGAIN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  if ((mCommit ? mCommit->generation : 0) != expectedGeneration) return -ESTALE;
+  if (!mCommit) {
+    bool held = false;
+    int result = mLease.isHeld(&held);
+    if (result) return quarantine(result);
+    if (!held) return quarantine(-EUCLEAN);
+  }
+  NetpolicyLease::PacketState state;
+  int result = mLease.readPacketState(&state);
+  if (result) return quarantine(result);
+  if (state.activeEpoch != expectedActiveEpoch) return -ESTALE;
+  if (state.pendingMask) return -EBUSY;
+  result = deleteTags(static_cast<uint32_t>(uid));
+  if (result) return quarantine(result < 0 ? result : -EPROTO);
+  result = mLease.deleteUidPacketStats(static_cast<uint32_t>(uid));
+  return result ? quarantine(result) : 0;
+}
+
+int SocketPolicyProjection::deleteUidPacketStats(int32_t uid) {
+  if (uid < 0) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.deleteUidPacketStats(static_cast<uint32_t>(uid));
+  return result ? quarantine(result) : 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::publishInitialPermissions(
+    const State& policy, const PermissionBootstrap::Snapshot& permissions) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -ENOTCONN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  if (mCommit) return -EALREADY;
+  std::vector<UidPermissionState::Entry> existing;
+  int result = policy.permissions.snapshot(&existing);
+  if (result) return result;
+  if (!existing.empty()) return -EINVAL;
+  State next = policy;
+  result = PermissionBootstrap::compile(permissions, &next.permissions);
+  if (result) return result;
+  return applyLocked(std::move(next));
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::setRuntimePolicy(
+    uint32_t flags, const std::vector<uint32_t>& blockedUids) {
+  if ((flags & ~7U) || blockedUids.size() > 1000) return -EINVAL;
+  for (size_t i=0;i<blockedUids.size();++i)
+    if (blockedUids[i]>INT32_MAX || (i&&blockedUids[i-1]>=blockedUids[i])) return -EINVAL;
+  return update([&](State& s) { s.runtime={true,flags,blockedUids};return 0; });
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::readTaggingBudget(int32_t uid, TaggingBudget* output) {
+  if (uid < 0 || !output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  return readTaggingBudgetLocked(uid, output);
+}
+int SocketPolicyProjection::readTaggingBudgetLocked(int32_t uid, TaggingBudget* output) {
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  NetpolicyLease::PacketState state;
+  result = mLease.readPacketState(&state);
+  if (result) return quarantine(result);
+  NetpolicyLease::PacketSnapshot snapshot;
+  result = mLease.readActivePacketStats(state.activeEpoch, &snapshot);
+  if (result) return quarantine(result);
+  TaggingBudget next;
+  next.totalEntries = snapshot.entries.size();
+  next.epoch = snapshot.epoch;
+  next.sequence = snapshot.sequence;
+  next.lostUpdates = snapshot.lostUpdates;
+  for (const auto& row : snapshot.entries)
+    if (row.uid == static_cast<uint32_t>(uid)) ++next.uidEntries;
+  *output = next;
+  return 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::tagSocket(SocketTagger& transport, int fd, uint32_t tag,
+                                     int32_t chargeUid, int32_t realUid) {
+  if (fd < 0 || chargeUid < 0 || realUid < 0) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  uint32_t permissions = 0;
+  result = mCommit->value.permissions.get(realUid, &permissions);
+  if (result) return result;
+  const int32_t appId = realUid % 100000;
+  const bool canChargeOther = (permissions & UidPermissionState::UpdateDeviceStats) ||
+                             appId == 0 || appId == 1000 || appId == 1051;
+  if ((chargeUid != realUid && !canChargeOther) || chargeUid == 1029) return -EPERM;
+  if (!transport.connected()) return quarantine(-ENOTCONN);
+  TaggingBudget budget;
+  result = readTaggingBudgetLocked(chargeUid, &budget);
+  if (result) return result;
+  // Exact pinned A17 BpfHandler limits/strict greater-than predicate. A later
+  // packet may add a row, as in the original active-map iteration contract.
+  if (budget.totalEntries > 4500 || budget.uidEntries > 500) return -EMFILE;
+  result = transport.tagSocket(fd, tag, static_cast<uid_t>(chargeUid));
+  if (!transport.connected()) return quarantine(result < 0 ? result : -EPROTO);
+  return result > 0 ? quarantine(-EPROTO) : result;
+}
+int SocketPolicyProjection::untagSocket(SocketTagger& transport, int fd) {
+  if (fd < 0) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  if (!transport.connected()) return quarantine(-ENOTCONN);
+  result = transport.untagSocket(fd);
+  if (!transport.connected()) return quarantine(result < 0 ? result : -EPROTO);
+  return result > 0 ? quarantine(-EPROTO) : result;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::verifyHeldProviderStartup() {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -ENOTCONN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  if (mCommit) return -EALREADY;
+  bool held = false;
+  int result = mLease.isHeld(&held);
+  if (!result && !held) result = -EBUSY;
+  if (!result) result = mLease.requirePolicyPrimitives();
+  if (!result) result = mLease.requireRuntimePolicy();
+  if (!result) result = mLease.requireIfaceAccountingPrimitives();
+  if (!result) result = mLease.requirePacketAccountingPrimitives();
+  if (!result) result = verifyHooks();
+  if (!result) result = mAccounting.verifyProducers();
+  if (!result) result = mSocket.verifyPrepared();
+  if (!result) result = mMeter.verifyPrepared();
+  NetpolicyLease::PacketState state;
+  NetpolicyLease::PacketSnapshot counters;
+  if (!result) result = mLease.readPacketState(&state);
+  if (!result) result = mLease.readActivePacketStats(state.activeEpoch, &counters);
+  return result ? quarantine(result) : 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::readIfaceNames(NetpolicyLease::IfaceNamesSnapshot* output) {
+  if(!output)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if(!mCommit)return -EAGAIN;
+  int result=mLease.readIfaceNames(output);
+  return result?quarantine(result):0;
+}
+}
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::readUidCleanup(NetpolicyLease::UidCleanupReceipt* output) {
+  if(!output)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if(!mStarted)return -EAGAIN;
+  if(!mAccountingEnabled)return -EOPNOTSUPP;
+  if(!mCommit){bool held=false;int r=mLease.isHeld(&held);if(r)return quarantine(r);
+              if(!held)return quarantine(-EUCLEAN);}
+  int result=mLease.readUidCleanup(output);return result?quarantine(result):0;
+}
+int SocketPolicyProjection::removeUidAccountingOnce(int32_t uid,uint64_t generation,
+        uint64_t epoch,uint64_t nonce,UidTagDeleter deleteTags) {
+  if(uid<0||!epoch||!nonce||!deleteTags)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if(!mStarted)return -EAGAIN;
+  if(!mAccountingEnabled)return -EOPNOTSUPP;
+  if(!mCommit){bool held=false;int r=mLease.isHeld(&held);if(r)return quarantine(r);
+              if(!held)return quarantine(-EUCLEAN);}
+  NetpolicyLease::UidCleanupReceipt receipt;
+  int result=mLease.readUidCleanup(&receipt);if(result)return quarantine(result);
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_COMPLETE&&receipt.nonce==nonce){
+    return receipt.uid==static_cast<uint32_t>(uid)&&receipt.generation==generation&&
+           receipt.activeEpoch==epoch?0:-ESTALE;
+  }
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_PREPARED)return quarantine(-EINPROGRESS);
+  if(receipt.nonce>=nonce||(mCommit?mCommit->generation:0)!=generation)return -ESTALE;
+  NetpolicyLease::PacketState state;
+  result=mLease.readPacketState(&state);if(result)return quarantine(result);
+  if(state.activeEpoch!=epoch)return -ESTALE;
+  if(state.pendingMask)return -EBUSY;
+  result=mLease.beginUidCleanup(uid,generation,epoch,nonce,&receipt);
+  if(result)return quarantine(result);
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_COMPLETE)return 0;
+  if(receipt.phase!=GTA3XLWIFI_UID_CLEANUP_PREPARED)return quarantine(-EPROTO);
+  result=deleteTags(uid);if(result)return quarantine(result<0?result:-EPROTO);
+  result=mLease.commitUidCleanup(uid,generation,epoch,nonce,&receipt);
+  return result?quarantine(result):0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::abortFrameworkClient() {
+  std::lock_guard<std::mutex> lock(mMutex);
+  // quarantine withdraws publication and closes the real held lease before the
+  // production Controllers handler terminates this daemon via _exit(1).
+  return quarantine(-ECONNABORTED);
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::tagClatSocket(SocketTagger& transport,int fd) {
+  if(fd<0)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result=packetAccountingAvailableLocked();if(result)return result;
+  if(!transport.connected())return quarantine(-ENOTCONN);
+  // CLAT rows are deliberately excluded by the real CLAT accounting path.
+  // Ordinary tagSocket still denies1029 and retains its exact normal budgets.
+  result=transport.tagClatSocket(fd);
+  if(!transport.connected())return quarantine(result<0?result:-EPROTO);
+  return result>0?quarantine(-EPROTO):result;
+}
+}  // namespace android::net::gta3xlwifi
