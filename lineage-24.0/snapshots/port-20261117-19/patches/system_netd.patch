+int NetpolicyLease::uidCleanupLocked(uint32_t operation,uint32_t uid,uint64_t generation,
+        uint64_t epoch,uint64_t nonce,UidCleanupReceipt* output) {
+    if(!output||operation>GTA3XLWIFI_UID_CLEANUP_COMMIT)return -EINVAL;
+    if(operation==GTA3XLWIFI_UID_CLEANUP_READ){
+        if(uid||generation||epoch||nonce)return -EINVAL;
+    }else if(uid>INT32_MAX||generation>INT64_MAX||!epoch||!nonce)return -EINVAL;
+    if(mFd<0)return -ENOTCONN;
+    int features;
+    do{features=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(features<0&&errno==EINTR);
+    if(features<0)return imageErrorLocked(errno?-errno:-EIO);
+    constexpr int required=GTA3XLWIFI_UID_CAP_PACKET_STATS_STORE|GTA3XLWIFI_UID_CAP_UID_CLEANUP_RECEIPT;
+    if((features&required)!=required)return imageErrorLocked(-EOPNOTSUPP);
+    gta3xlwifi_uid_cleanup value{};
+    auto input=[&]{value={};value.version=1;value.operation=operation;value.uid=uid;
+                   value.nonce=nonce;value.generation=generation;value.active_epoch=epoch;};
+    int result;
+    do{input();result=ioctl(mFd,GTA3XLWIFI_UID_CLEANUP,reinterpret_cast<unsigned long>(&value));}
+    while(operation==GTA3XLWIFI_UID_CLEANUP_READ&&result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(value.version!=1||value.operation!=operation||value.phase>GTA3XLWIFI_UID_CLEANUP_COMPLETE||
+       value.uid>INT32_MAX||value.generation>INT64_MAX)return imageErrorLocked(-EPROTO);
+    for(auto reserved:value.reserved)if(reserved)return imageErrorLocked(-EPROTO);
+    if(value.phase==GTA3XLWIFI_UID_CLEANUP_NONE){
+        if(value.uid||value.nonce||value.generation||value.active_epoch||operation!=GTA3XLWIFI_UID_CLEANUP_READ)
+            return imageErrorLocked(-EPROTO);
+    }else if(!value.nonce||!value.active_epoch)return imageErrorLocked(-EPROTO);
+    if(operation!=GTA3XLWIFI_UID_CLEANUP_READ&&
+       (value.uid!=uid||value.nonce!=nonce||value.generation!=generation||value.active_epoch!=epoch))
+        return imageErrorLocked(-EPROTO);
+    if(operation==GTA3XLWIFI_UID_CLEANUP_COMMIT&&value.phase!=GTA3XLWIFI_UID_CLEANUP_COMPLETE)
+        return imageErrorLocked(-EPROTO);
+    *output={value.phase,value.uid,value.nonce,value.generation,value.active_epoch};return 0;
+}
+int NetpolicyLease::readUidCleanup(UidCleanupReceipt* output){
+    std::lock_guard<std::mutex> lock(mMutex);return uidCleanupLocked(GTA3XLWIFI_UID_CLEANUP_READ,0,0,0,0,output);
+}
+int NetpolicyLease::beginUidCleanup(uint32_t uid,uint64_t generation,uint64_t epoch,uint64_t nonce,
+        UidCleanupReceipt* output){
+    std::lock_guard<std::mutex> lock(mMutex);return uidCleanupLocked(GTA3XLWIFI_UID_CLEANUP_BEGIN,uid,generation,epoch,nonce,output);
+}
+int NetpolicyLease::commitUidCleanup(uint32_t uid,uint64_t generation,uint64_t epoch,uint64_t nonce,
+        UidCleanupReceipt* output){
+    std::lock_guard<std::mutex> lock(mMutex);return uidCleanupLocked(GTA3XLWIFI_UID_CLEANUP_COMMIT,uid,generation,epoch,nonce,output);
+}
