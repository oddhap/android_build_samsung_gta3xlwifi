diff --git a/server/Gta3xlwifiPolicyFrame.cpp b/server/Gta3xlwifiPolicyFrame.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6e757555d73ce960760a9d48a8677a5d9b1f02e2
--- /dev/null
+++ b/server/Gta3xlwifiPolicyFrame.cpp
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiPolicyFrame.h"
+#include <cerrno>
+#include <set>
+namespace android::net::gta3xlwifi {
+namespace {
+constexpr std::array<uint32_t, PolicyFrame::SectionCount> Width{1,1,2,2,2,4,6,8,8,1};
+constexpr std::array<uint32_t, PolicyFrame::SectionCount> Limit{
+    65536,65536,131072,24,480000,80000,600,8000,8000,1000};
+bool boolean(int32_t value) { return value == 0 || value == 1; }
+void addressWord(uint32_t word, uint8_t* out) {
+  // Explicit network byte order, independent of host/Parcel CPU byte order.
+  for (unsigned n=0;n<4;++n) out[n] = word >> (24-8*n);
+}
+}
+void PolicyFrame::clear() {
+  mBegun = false;
+  mCounts.fill(0);
+  for (auto& section : mWords) std::vector<int32_t>().swap(section);
+}
+int PolicyFrame::begin(const std::vector<int32_t>& counts, uint32_t flags,
+                       bool loopback, bool migration, bool dataSaver) {
+  if (mBegun) return -EBUSY;
+  if (!migration) return -EOPNOTSUPP; // Actual A17 canonical full-UID mode required.
+  if (counts.size()!=SectionCount || (flags & ~7u)) return -EINVAL;
+  uint32_t total = 0;
+  for (size_t i=0;i<SectionCount;++i) {
+    if (counts[i]<0 || static_cast<uint32_t>(counts[i])>Limit[i] ||
+        counts[i]%Width[i]) return -EINVAL;
+    total += counts[i];
+  }
+  if (total>MaxWords) return -E2BIG;
+  // Every actual chain, including disabled chains, must be supplied explicitly.
+  if (counts[ChainConfiguration]!=24) return -EPROTO;
+  for (size_t i=0;i<SectionCount;++i) mCounts[i]=counts[i];
+  mFlags=flags; mLoopback=loopback; mDataSaver=dataSaver; mBegun=true;
+  return 0;
+}
+int PolicyFrame::append(uint32_t section, uint32_t offset,
+                        const std::vector<int32_t>& words) {
+  if (!mBegun) return -ENOTCONN;
+  if (section>=SectionCount || words.empty() || words.size()>ChunkWords) return -EINVAL;
+  auto& destination=mWords[section];
+  if (offset!=destination.size()) return -ESTALE;
+  if (words.size()>mCounts[section]-destination.size()) return -E2BIG;
+  destination.insert(destination.end(),words.begin(),words.end());
+  return 0;
+}
+int PolicyFrame::compile(SocketPolicyProjection::State* output) const {
+  if (!output) return -EINVAL;
+  if (!mBegun) return -ENOTCONN;
+  for (size_t i=0;i<SectionCount;++i) if (mWords[i].size()!=mCounts[i]) return -EAGAIN;
+  SocketPolicyProjection::State next;
+  PermissionBootstrap::Snapshot permissions;
+  permissions.users=mWords[Users]; permissions.knownUids=mWords[KnownUids];
+  permissions.loopbackPermissionEnabled=mLoopback;
+  const auto& raw=mWords[RawPermissions];
+  for (size_t i=0;i<raw.size();i+=2) permissions.observed.push_back({raw[i],static_cast<uint32_t>(raw[i+1])});
+  int result=PermissionBootstrap::compile(permissions,&next.permissions);
+  if (result) return result;
+  std::set<int32_t> chains;
+  const auto& config=mWords[ChainConfiguration];
+  for (size_t i=0;i<config.size();i+=2) {
+    if (!boolean(config[i+1]) || !chains.insert(config[i]).second) return -EINVAL;
+    if ((result=next.policy.setChainEnabled(config[i],config[i+1]))) return result;
+  }
+  for (const auto& chain:UidPolicy::chains()) if (!chains.count(chain.id)) return -EPROTO;
+  std::set<std::pair<int32_t,int32_t>> memberships;
+  const auto& members=mWords[ChainMembership];
+  for (size_t i=0;i<members.size();i+=2) {
+    if (!memberships.emplace(members[i],members[i+1]).second) return -EINVAL;
+  }
+  for (const auto& chain:UidPolicy::chains()) {
+    std::vector<int32_t> uids;
+    for (const auto& member:memberships) if (member.first==chain.id) uids.push_back(member.second);
+    if ((result=next.policy.replaceUidChain(chain.id,uids))) return result;
+  }
+  for (const auto& member:memberships) if (!chains.count(member.first)) return -EINVAL;
+  next.policy.setDataSaver(mDataSaver);
+  std::set<int32_t> owners;
+  const auto& ingress=mWords[IngressOwners];
+  for (size_t i=0;i<ingress.size();i+=4) {
+    if (!boolean(ingress[i+1]) || !boolean(ingress[i+3]) ||
+        (!ingress[i+1] && ingress[i+2]) || !owners.insert(ingress[i]).second) return -EINVAL;
+    if (ingress[i+1] && (result=next.ingress.setIif(ingress[i],static_cast<uint32_t>(ingress[i+2])))) return result;
+    if ((result=next.ingress.setLockdown(ingress[i],ingress[i+3]))) return result;
+  }
+  std::set<IngressPolicy::Address> discards;
+  const auto& discard=mWords[DiscardAddresses];
+  for (size_t i=0;i<discard.size();i+=6) {
+    IngressPolicy::Address address{};
+    for (unsigned n=0;n<4;++n) addressWord(discard[i+n],address.data()+4*n);
+    if (!discards.insert(address).second) return -EINVAL;
+    if ((result=next.ingress.setDiscard(address,static_cast<uint32_t>(discard[i+4]),static_cast<uint32_t>(discard[i+5])))) return result;
+  }
+  for (auto section:{LocalNetworks,LocalHosts}) {
+    std::vector<LocalNetworkState::Entry> entries;
+    const auto& words=mWords[section];
+    for (size_t i=0;i<words.size();i+=8) {
+      if (words[i]<0 || !boolean(words[i+7])) return -EINVAL;
+      LocalNetworkState::Entry entry{static_cast<uint32_t>(words[i]),{},words[i+7]!=0};
+      for (unsigned n=0;n<6;++n) addressWord(words[i+1+n],entry.key.data()+4*n);
+      entries.push_back(entry);
+    }
+    // replace validates duplicate canonical prefixes rather than overwriting.
+    std::vector<LocalNetworkState::Entry> network,host;
+    if ((result=next.local.snapshot(&network,&host))) return result;
+    if (section==LocalNetworks) network=std::move(entries); else host=std::move(entries);
+    if ((result=next.local.replace(network,host))) return result;
+  }
+  next.runtime.supplied=true; next.runtime.flags=mFlags;
+  for (int32_t uid:mWords[LegacyBlockedUids]) {
+    if (uid<0 || (!next.runtime.legacyBlockedUids.empty() &&
+        next.runtime.legacyBlockedUids.back()>=static_cast<uint32_t>(uid))) return -EINVAL;
+    next.runtime.legacyBlockedUids.push_back(uid);
+  }
+  *output=std::move(next);
+  return 0;
+}
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiPolicyFrame.h b/server/Gta3xlwifiPolicyFrame.h
new file mode 100644
index 0000000000000000000000000000000000000000..47e065eb0b53d8021ae57ab6ae0a3e4a0e43f98a
--- /dev/null
+++ b/server/Gta3xlwifiPolicyFrame.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <array>
+#include "Gta3xlwifiSocketPolicyProjection.h"
+namespace android::net::gta3xlwifi {
+// Bounded ordered IPC staging. All sections are explicitly declared, including
+// empty ones. Nothing changes the owner/kernel until a complete frame compiles.
+class PolicyFrame final {
+ public:
+  enum Section : uint32_t {
+    Users, KnownUids, RawPermissions, ChainConfiguration, ChainMembership,
+    IngressOwners, DiscardAddresses, LocalNetworks, LocalHosts, LegacyBlockedUids,
+    SectionCount
+  };
+  static constexpr uint32_t ChunkWords = 4096;
+  static constexpr uint32_t MaxWords = 1000000;
+  int begin(const std::vector<int32_t>& wordCounts, uint32_t runtimeFlags,
+            bool loopbackPermission, bool uidMigration, bool dataSaver);
+  int append(uint32_t section, uint32_t offset, const std::vector<int32_t>& words);
+  int compile(SocketPolicyProjection::State* output) const;
+  void clear();
+ private:
+  bool mBegun = false, mLoopback = false, mDataSaver = false;
+  uint32_t mFlags = 0;
+  std::array<size_t, SectionCount> mCounts{};
+  std::array<std::vector<int32_t>, SectionCount> mWords;
+};
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiQtaguidProtocol.h b/server/Gta3xlwifiQtaguidProtocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..f4177d4204542ed2f3a70fb0ba9b11439bdb455a
--- /dev/null
+++ b/server/Gta3xlwifiQtaguidProtocol.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_XT_QTAGUID_SOCK_H
+#define _UAPI_XT_QTAGUID_SOCK_H
+
+#include <linux/ioctl.h>
+
+/* Private, opt-in gta3xlwifi ABI. No argument, same command on 32/64 bit.
+ * Requires initial-namespace root plus CAP_NET_ADMIN and an empty own session.
+ * New/retagged sockets then own their tags until explicit untag, UID deletion
+ * or inet_release, not until the tagging daemon's process/session exits.
+ * This does not authorize a caller or implement accounting budgets/readiness.
+ */
+#define QTAGUID_SOCKET_OWNED_SESSION _IO('q', 0x51)
+
+#endif
diff --git a/server/Gta3xlwifiQtaguidTransport.cpp b/server/Gta3xlwifiQtaguidTransport.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fdb70e786f519533b85c6a5258ca854fab56a615
--- /dev/null
+++ b/server/Gta3xlwifiQtaguidTransport.cpp
@@ -0,0 +1,264 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "Gta3xlwifiQtaguidTransport.h"
+#include "Gta3xlwifiQtaguidProtocol.h"
+
+#include <cerrno>
+#include <cinttypes>
+#include <climits>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <initializer_list>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+namespace android::net::gta3xlwifi {
+namespace {
+constexpr uint64_t kProcMagic = 0x9fa0;
+constexpr uint64_t kSysfsMagic = 0x62656572;
+constexpr char kDevice[] = "/dev/xt_qtaguid";
+constexpr char kControl[] = "/proc/net/xt_qtaguid/ctrl";
+constexpr char kDeviceId[] = "/sys/class/misc/xt_qtaguid/dev";
+constexpr char kPassive[] = "/sys/module/xt_qtaguid/parameters/passive";
+constexpr char kTrackingPassive[] = "/sys/module/xt_qtaguid/parameters/tag_tracking_passive";
+
+class Fd {
+  public:
+    explicit Fd(int fd) : mFd(fd) {}
+    ~Fd() {
+        const int saved = errno;
+        if (mFd >= 0) close(mFd);  // Linux closes the descriptor even on EINTR.
+        errno = saved;
+    }
+    int get() const { return mFd; }
+    int release() { const int fd = mFd; mFd = -1; return fd; }
+  private:
+    int mFd;
+};
+
+int openFile(const char* path, int flags) {
+    int fd;
+    do { fd = open(path, flags | O_CLOEXEC | O_NOFOLLOW); } while (fd < 0 && errno == EINTR);
+    return fd;
+}
+
+int checkFile(int fd, uint64_t magic) {
+    struct stat st {};
+    if (fstat(fd, &st)) return -errno;
+    if (!S_ISREG(st.st_mode)) return -ENODEV;
+    struct statfs fs {};
+    if (fstatfs(fd, &fs)) return -errno;
+    return static_cast<uint64_t>(fs.f_type) == magic ? 0 : -ENODEV;
+}
+
+// Exact bounded sysfs text, not a generic file/property fallback. Inaccessible,
+// wrong filesystem, truncated, embedded-NUL or malformed input is an error.
+int readSysfs(const char* path, char* buffer, size_t capacity) {
+    Fd fd(openFile(path, O_RDONLY));
+    if (fd.get() < 0) return -errno;
+    int result = checkFile(fd.get(), kSysfsMagic);
+    if (result) return result;
+    size_t used = 0;
+    while (used < capacity) {
+        ssize_t count;
+        do { count = read(fd.get(), buffer + used, capacity - used); }
+        while (count < 0 && errno == EINTR);
+        if (count < 0) return -errno;
+        if (count == 0) {
+            if (used == 0 || memchr(buffer, '\0', used)) return -EPROTO;
+            buffer[used] = '\0';
+            return static_cast<int>(used);
+        }
+        used += static_cast<size_t>(count);
+    }
+    return -EOVERFLOW;
+}
+
+int checkActive() {
+    for (const char* path : {kPassive, kTrackingPassive}) {
+        char value[9];
+        const int size = readSysfs(path, value, sizeof(value) - 1);
+        if (size < 0) return size;
+        // param_get_bool in this kernel emits exactly Y\n or N\n. In passive
+        // mode ctrl writes silently succeed, so accepting it would be fake I/O.
+        if (size != 2 || value[1] != '\n') return -EPROTO;
+        if (value[0] == 'Y') return -EOPNOTSUPP;
+        if (value[0] != 'N') return -EPROTO;
+    }
+    return 0;
+}
+
+int deviceIdentity(dev_t* identity) {
+    char value[33];
+    const int size = readSysfs(kDeviceId, value, sizeof(value) - 1);
+    if (size < 0) return size;
+    unsigned int numbers[2] = {};
+    unsigned int part = 0;
+    bool digit = false;
+    for (int i = 0; i < size; ++i) {
+        const char c = value[i];
+        if (c >= '0' && c <= '9') {
+            if (numbers[part] > (UINT_MAX - static_cast<unsigned int>(c - '0')) / 10)
+                return -EPROTO;
+            numbers[part] = numbers[part] * 10 + static_cast<unsigned int>(c - '0');
+            digit = true;
+        } else if (c == ':' && part == 0 && digit) {
+            part = 1;
+            digit = false;
+        } else if (c == '\n' && i == size - 1 && part == 1 && digit) {
+            const dev_t dev = makedev(numbers[0], numbers[1]);
+            // Misc devices have major 10; also reject dev_t truncation.
+            if (numbers[0] != 10 || major(dev) != numbers[0] || minor(dev) != numbers[1])
+                return -ENODEV;
+            *identity = dev;
+            return 0;
+        } else {
+            return -EPROTO;
+        }
+    }
+    return -EPROTO;
+}
+
+int duplicateInetSocket(int fd, bool clat) {
+    int copy;
+    do { copy = fcntl(fd, F_DUPFD_CLOEXEC, 3); } while (copy < 0 && errno == EINTR);
+    if (copy < 0) return -errno;
+    Fd stable(copy);
+    int value = 0;
+    socklen_t length = sizeof(value);
+    if (getsockopt(copy, SOL_SOCKET, SO_DOMAIN, &value, &length)) return -errno;
+    if (length != sizeof(value)) return -EPROTO;
+    if (clat ? value != AF_INET6 : (value != AF_INET && value != AF_INET6))
+        return -EAFNOSUPPORT;
+    length = sizeof(value);
+    if (getsockopt(copy, SOL_SOCKET, SO_PROTOCOL, &value, &length)) return -errno;
+    if (length != sizeof(value)) return -EPROTO;
+    if (clat ? value != IPPROTO_RAW : (value != IPPROTO_TCP && value != IPPROTO_UDP))
+        return -EPROTONOSUPPORT;
+    if (clat) {
+        length = sizeof(value);
+        if (getsockopt(copy, SOL_SOCKET, SO_TYPE, &value, &length)) return -errno;
+        if (length != sizeof(value)) return -EPROTO;
+        if (value != SOCK_RAW) return -EPROTOTYPE;
+    }
+    return stable.release();
+}
+}  // namespace
+
+QtaguidTransport::~QtaguidTransport() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    closeLocked();
+}
+
+void QtaguidTransport::closeLocked() {
+    if (mControl >= 0) { close(mControl); mControl = -1; }
+    if (mDevice >= 0) { close(mDevice); mDevice = -1; }
+}
+
+int QtaguidTransport::start() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mDevice >= 0 || mControl >= 0) return -EALREADY;
+    int result = checkActive();
+    if (result) return result;
+    dev_t identity {};
+    result = deviceIdentity(&identity);
+    if (result) return result;
+    Fd device(openFile(kDevice, O_RDONLY));
+    if (device.get() < 0) return -errno;
+    struct stat st {};
+    if (fstat(device.get(), &st)) return -errno;
+    if (!S_ISCHR(st.st_mode) || st.st_rdev != identity) return -ENODEV;
+    // Mandatory private kernel ABI. Old kernels return ENOTTY, never presumed
+    // compatible: process-owned tags would disappear on a Netd restart.
+    int ack;
+    do { ack = ioctl(device.get(), QTAGUID_SOCKET_OWNED_SESSION, 0UL); }
+    while (ack < 0 && errno == EINTR);
+    if (ack < 0) return -errno;
+    if (ack != 0) return -EPROTO;
+    Fd control(openFile(kControl, O_WRONLY));
+    if (control.get() < 0) return -errno;
+    result = checkFile(control.get(), kProcMagic);
+    if (result) return result;
+    mDevice = device.release();
+    mControl = control.release();
+    return 0;  // I/O session opened, NOT complete backend readiness.
+}
+
+int QtaguidTransport::tagSocket(int fd, uint32_t tag, uid_t uid) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (uid > static_cast<uid_t>(INT_MAX)) return -EINVAL;
+    return commandLocked(fd, tag, uid, false);
+}
+
+int QtaguidTransport::untagSocket(int fd) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return commandLocked(fd, 0, 0, true);
+}
+
+int QtaguidTransport::deleteUidTags(uint32_t uid) {
+    if (uid > static_cast<uint32_t>(INT_MAX)) return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mDevice < 0 || mControl < 0) return -ENOTCONN;
+    int result = checkActive();
+    if (result) { closeLocked(); return result; }
+    char command[48];
+    const int length = snprintf(command, sizeof(command), "d 0 %" PRIu32, uid);
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    ssize_t count;
+    do { count = write(mControl, command, static_cast<size_t>(length)); }
+    while (count < 0 && errno == EINTR);
+    if (count < 0) { result = errno ? -errno : -EIO; closeLocked(); return result; }
+    if (count != length) { closeLocked(); return -EIO; }
+    return 0;
+}
+
+int QtaguidTransport::commandLocked(int fd, uint32_t tag, uid_t uid, bool untag, bool clat) {
+    if (clat && (untag || tag || uid != 1029)) return -EINVAL;
+    if (mDevice < 0 || mControl < 0) return -ENOTCONN;
+    const int result = checkActive();
+    if (result) { closeLocked(); return result; }
+    const int copy = duplicateInetSocket(fd, clat);
+    if (copy < 0) return copy;
+    Fd stable(copy);  // Pin the file through write; never act on a reused fd.
+    char command[96];
+    const int length = untag
+            ? snprintf(command, sizeof(command), "u %d", copy)
+            : snprintf(command, sizeof(command), "t %d %" PRIu64 " %" PRIu32,
+                       copy, static_cast<uint64_t>(tag) << 32, static_cast<uint32_t>(uid));
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    ssize_t count;
+    do { count = write(mControl, command, static_cast<size_t>(length)); }
+    while (count < 0 && errno == EINTR);
+    if (count < 0) return -errno;
+    if (count != length) {
+        // A proc command must be one complete write. Never send a suffix as a
+        // second command or acknowledge uncertain state. Drop our session.
+        closeLocked();
+        return -EIO;
+    }
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+void QtaguidTransport::stop() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    closeLocked();
+}
+bool QtaguidTransport::connected() const {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return mDevice >= 0 && mControl >= 0;
+}
+}  // namespace android::net::gta3xlwifi
+
+namespace android::net::gta3xlwifi {
+int QtaguidTransport::tagClatSocket(int fd) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return commandLocked(fd,0,1029,false,true);
+}
+}  // namespace android::net::gta3xlwifi
