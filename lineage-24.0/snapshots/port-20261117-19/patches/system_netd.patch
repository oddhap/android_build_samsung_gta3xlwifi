+// Called only by Controllers after acquiring the private held owner lease.
+// Preserve old per-interface user chains as the stock flush command does; none
+// is replayed or reattached. AccountingRoots validates all owned parents in both
+// families before installing source-bound producers and metered bridges.
+int BandwidthController::prepareGta3xlwifiBandwidthControl() {
+    const int result = iptablesRestoreFunction(V4V6, Join(IPT_FLUSH_COMMANDS, '\n'), nullptr);
+    if (result) return result;
+    mSharedQuotaIfaces.clear();
+    mQuotaIfaces.clear();
+    mGlobalAlertBytes = 0;
+    mSharedQuotaBytes = 0;
+    return 0;
+}
