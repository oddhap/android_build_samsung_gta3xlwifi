+// Private real-kernel lease transport, not a networking backend or readiness API.
+// The sole backend owner must hold its transaction lock and verify guard/DROP
+// attachments in both families before calling release(). No FD is exposed.
+class NetpolicyLease final {
+public:
+    NetpolicyLease() = default;
+    ~NetpolicyLease();
+    NetpolicyLease(const NetpolicyLease&) = delete;
+    NetpolicyLease& operator=(const NetpolicyLease&) = delete;
+    struct PermissionEntry {
+        int32_t uid;
+        uint32_t permissions;
+        bool operator==(const PermissionEntry& b) const {
+            return uid == b.uid && permissions == b.permissions;
+        }
+    };
+    struct PermissionImage {
+        uint64_t revision = 0;  // Zero means real store is not initialized.
+        std::vector<PermissionEntry> entries;
+    };
+    // Primitive I/O only. Does not release the gate or publish callback state.
+    // A sole backend transaction owner must serialize these with rule changes.
+    int readUidPermissions(PermissionImage* output);
+    int replaceUidPermissions(uint64_t expectedRevision,
+                              const std::vector<PermissionEntry>& entries,
+                              uint64_t* newRevision);
+    struct LocalNetworkEntry {
+        uint32_t prefixBits;
+        std::array<uint8_t, 24> key;
+        bool allowed;
+        bool operator==(const LocalNetworkEntry& b) const {
+            return prefixBits == b.prefixBits && key == b.key && allowed == b.allowed;
+        }
+    };
+    struct LocalNetworkImage {
+        uint64_t revision = 0;
+        std::vector<LocalNetworkEntry> network, host;
+    };
+    // Canonical sorted full images only; state-level callers canonicalize BPF
+    // key suffixes before this transport. Primitive methods never release/publish.
+    int readLocalNetwork(LocalNetworkImage* output);
+    int replaceLocalNetwork(uint64_t expectedRevision,
+                            const std::vector<LocalNetworkEntry>& network,
+                            const std::vector<LocalNetworkEntry>& host,
+                            uint64_t* newRevision);
+    struct LoopbackEvent {
+        uint32_t senderUid, receiverUid, result;
+        uint64_t boottimeNs, sequence, lostEvents;
+    };
+    struct LoopbackBatch {
+        std::vector<LoopbackEvent> events;
+        uint64_t lostEvents = 0;
+    };
+    // Real destructive event read, sole owner only. Allocate before consumption;
+    // validate all frames before exposing any. Never retries an uncertain consume.
+    // Caller must serialize this with its complete backend transaction owner.
+    int readLoopbackEvents(LoopbackBatch* output);
+    // Registered dual-stack private tables with exact-skb UID snapshot.
+    // This primitive capability does not release the gate or publish readiness.
+    int requireSocketTables();
+    int requireIngressMatches();
+    int requirePolicyPrimitives();
+    // Requires BOTH actual interface producer registration and compiled dual-stack
+    // DROP correction. Does not install rules, release, or advertise Ready.
+    int requireIfaceAccountingPrimitives();
+    struct IfaceCounter {
+        uint32_t ifindex;
+        uint64_t rxPackets,rxBytes,txPackets,txBytes;
+    };
+    struct IfaceSnapshot {
+        std::vector<IfaceCounter> entries;
+        uint64_t lostUpdates=0, updateSequence=0;
+    };
+    // One non-consuming actual snapshot, no metadata/data race or fake totals.
+    // Loss is returned explicitly. Caller must not describe lossy data as complete.
+    int readIfaceStats(IfaceSnapshot* output);
+    struct IfaceName { uint32_t ifindex; std::array<char,16> name; };
+    struct IfaceNamesSnapshot {
+        std::vector<IfaceName> entries;
+        uint64_t lostUpdates=0,sequence=0;
+    };
+    int readIfaceNames(IfaceNamesSnapshot* output);
+
+    // Requires actual storage AND compiled dual-stack UID/app producers.
+    // No rule installation, gate release or global readiness is implied.
+    int requirePacketAccountingPrimitives();
+    struct PacketState {
+        uint32_t activeBank=0, pendingMask=0;
+        uint64_t activeEpoch=0;
+        std::array<uint32_t,2> bankCount{};
+        std::array<uint64_t,2> bankEpoch{},bankLost{};
+        uint32_t appCount=0,countersetCount=0;
+        uint64_t appLost=0,totalStatsLost=0;
+    };
+    struct PacketCounter {
+        uint32_t uid,tag,counterset,ifindex;
+        uint64_t rxPackets,rxBytes,txPackets,txBytes;
+    };
+    struct PacketSnapshot {
+        std::vector<PacketCounter> entries;
+        uint64_t epoch=0,lostUpdates=0,sequence=0;
+    };
+    struct AppCounter {
+        uint32_t uid;
+        uint64_t rxPackets,rxBytes,txPackets,txBytes;
+    };
+    struct AppSnapshot {
+        std::vector<AppCounter> entries;
+        uint64_t lostUpdates=0,sequence=0;
+    };
+    struct BankTransition {
+        uint32_t activeBank=0,inactiveBank=0;
+        uint64_t activeEpoch=0,inactiveEpoch=0;
+    };
+    // Storage only: no installed packet-hook or statistics-readiness claim.
+    // The complete backend owner must serialize these with its poll/lifecycle.
+    // SWAP/EDIT are never blindly retried. Uncertain results close the lease;
+    // after explicit owner recovery, STATE exposes a possibly committed swap.
+    // READ does not consume. ACK is explicit/idempotent; persist data first.
+    int readPacketState(PacketState* output);
+    // Non-consuming genuine active-bank snapshot, exact nonzero epoch.
+    int readActivePacketStats(uint64_t epoch, PacketSnapshot* output);
+    int readFrozenPacketStats(uint32_t bank,uint64_t epoch,PacketSnapshot* output);
+    int readAppStats(AppSnapshot* output);
+    int swapPacketStats(uint32_t expectedBank,uint64_t expectedEpoch,BankTransition* output);
+    int acknowledgePacketStats(uint32_t bank,uint64_t epoch);
+    int setPacketCounterset(uint32_t uid,uint32_t counterset);
+    // Statistics/counterset only. Caller must separately remove socket tags and
+    // perform the final poll/ACK first; pending banks intentionally reject this.
+    int deleteUidPacketStats(uint32_t uid);
+    struct UidCleanupReceipt {
+        uint32_t phase=0,uid=0;
+        uint64_t nonce=0,generation=0,activeEpoch=0;
+    };
+    int readUidCleanup(UidCleanupReceipt* output);
+    int beginUidCleanup(uint32_t uid,uint64_t generation,uint64_t epoch,uint64_t nonce,
+                        UidCleanupReceipt* output);
+    int commitUidCleanup(uint32_t uid,uint64_t generation,uint64_t epoch,uint64_t nonce,
+                         UidCleanupReceipt* output);
+    struct RuntimeImage {
+        uint64_t revision=0;
+        uint32_t flags=0;
+        bool confirmedForLease=false;
+        std::vector<uint32_t> legacyBlockedUids;
+    };
+    // Real runtime mode image, not global readiness. Same owner descriptor and
+    // mutex; mutable writes require HOLD and exact readback before success.
+    int requireRuntimePolicy();
+    int readRuntimePolicy(RuntimeImage* output);
+    int replaceRuntimePolicy(uint64_t expectedRevision,uint32_t flags,
+                             const std::vector<uint32_t>& blockedUids,
+                             uint64_t* newRevision);
+    int start();
+    int hold();
+    int release();
+    int isHeld(bool* output);
+    void stop();
+private:
+    int runtimeFeaturesLocked();
+    int runtimeReadLocked(RuntimeImage* output);
+    int packetStorageLocked();
+    int uidCleanupLocked(uint32_t operation,uint32_t uid,uint64_t generation,
+                         uint64_t epoch,uint64_t nonce,UidCleanupReceipt* output);
+    int packetCommandLocked(unsigned long request,void* argument,bool retry);
+    int loopbackFeaturesLocked();
+    int eventCommandLocked(void* argument);
+    uint64_t mLastEventSequence = 0, mLastEventLoss = 0, mLastEventLossTotal = 0;
+    int localNetworkFeaturesLocked();
+    int localNetworkMetadataLocked(struct gta3xlwifi_lna_transfer* metadata);
+    int localNetworkDataLocked(struct gta3xlwifi_lna_transfer* metadata,
+                               struct gta3xlwifi_lna_entry* network,
+                               struct gta3xlwifi_lna_entry* host);
+    int imageCommandLocked(unsigned long request, void* argument);
+    int imageFeaturesLocked();
+    int imageMetadataLocked(struct gta3xlwifi_uid_permission_transfer* metadata);
+    int imageDataLocked(struct gta3xlwifi_uid_permission_transfer* metadata,
+                        struct gta3xlwifi_uid_permission_entry* buffer);
+    int imageErrorLocked(int error);
+    int commandLocked(unsigned long request, int expected);
+    int stateLocked(bool* output);
+    int changeLocked(unsigned long request, bool held);
+    void closeLocked();
+    std::mutex mMutex;
+    int mFd = -1;
+};
