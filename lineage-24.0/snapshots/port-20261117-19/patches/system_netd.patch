index 0000000000000000000000000000000000000000..1ebee1fde47e56aa5f2857b10bbd4a4e7558958f
--- /dev/null
+++ b/server/Gta3xlwifiUidPermissionState.cpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiUidPermissionState.h"
+#include <cerrno>
+#include <set>
+#include <utility>
+namespace android::net::gta3xlwifi {
+uint32_t UidPermissionState::permissions(uint32_t uid) const {
+    const auto entry = mPermissions.find(uid);
+    return entry == mPermissions.end() ? 0 : entry->second;
+}
+int UidPermissionState::set(int32_t uid, uint32_t mask) {
+    if (uid < 0 || (mask & ~KnownMask)) return -EINVAL;
+    if (mask) mPermissions[static_cast<uint32_t>(uid)] = mask;
+    else mPermissions.erase(static_cast<uint32_t>(uid));
+    return 0;
+}
+int UidPermissionState::get(int32_t uid, uint32_t* output) const {
+    if (uid < 0 || !output) return -EINVAL;
+    *output = permissions(static_cast<uint32_t>(uid));
+    return 0;
+}
+int UidPermissionState::remove(int32_t uid) { return set(uid, 0); }
+int UidPermissionState::replace(const std::vector<Entry>& entries) {
+    std::map<uint32_t, uint32_t> next;
+    std::set<int32_t> seen;
+    for (const auto& entry : entries) {
+        if (entry.uid < 0 || (entry.permissions & ~KnownMask) ||
+            !seen.insert(entry.uid).second) return -EINVAL;
+        if (entry.permissions) next[static_cast<uint32_t>(entry.uid)] = entry.permissions;
+    }
+    mPermissions = std::move(next);
+    return 0;
+}
+int UidPermissionState::snapshot(std::vector<Entry>* output) const {
+    if (!output) return -EINVAL;
+    std::vector<Entry> next;
+    next.reserve(mPermissions.size());
+    for (const auto& entry : mPermissions)
+        next.push_back({static_cast<int32_t>(entry.first), entry.second});
+    *output = std::move(next);
+    return 0;
+}
+int UidPermissionState::matchingUids(uint32_t required, std::vector<int32_t>* output) const {
+    if (!output || !required || (required & ~KnownMask)) return -EINVAL;
+    std::vector<int32_t> next;
+    for (const auto& entry : mPermissions)
+        if ((entry.second & required) == required) next.push_back(static_cast<int32_t>(entry.first));
+    *output = std::move(next);
+    return 0;
+}
+int UidPermissionState::loopbackAllowed(uint32_t sender, uint32_t receiver, bool* output) const {
+    if (!output) return -EINVAL;
+    bool allowed = sender % 100000 < 10000 || receiver % 100000 < 10000 ||
+                   sender / 100000 == receiver / 100000;
+    if (!allowed) {
+        const auto senderMask = permissions(sender);
+        const auto receiverMask = permissions(receiver);
+        allowed = (senderMask & InteractAcrossUsersFull) ||
+                  ((receiverMask & (ForceUseLoopbackInterface | InteractAcrossUsersFull)) ==
+                   (ForceUseLoopbackInterface | InteractAcrossUsersFull)) ||
+                  (sender % 100000 == receiver % 100000 &&
+                   (senderMask & InteractAcrossUsersOrProfiles));
+    }
+    *output = allowed;
+    return 0;
+}
+int UidPermissionState::noInternetDenied(int32_t uid, bool* output) const {
+    if (uid < 0 || !output) return -EINVAL;
+    *output = (permissions(static_cast<uint32_t>(uid)) & NoInternet) != 0;
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiUidPermissionState.h b/server/Gta3xlwifiUidPermissionState.h
new file mode 100644
index 0000000000000000000000000000000000000000..048a0f25b2b074caa375f05bfb317a9cdb4a2baa
--- /dev/null
+++ b/server/Gta3xlwifiUidPermissionState.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <map>
+#include <vector>
+namespace android::net::gta3xlwifi {
+// Candidate A17 UidPermissionChunk VALUES, not kernel enforcement or readiness.
+// In particular NoInternet is a negative bit; absent entries have mask0. A sole
+// future owner must commit real kernel state before publishing this value.
+class UidPermissionState {
+public:
+    enum Permission : uint32_t {
+        AccessLocalNetwork = 1u << 0,
+        UpdateDeviceStats = 1u << 1,
+        NoInternet = 1u << 2,
+        UseLoopbackInterface = 1u << 3,
+        ForceUseLoopbackInterface = 1u << 4,
+        InteractAcrossUsersFull = 1u << 5,
+        InteractAcrossUsersOrProfiles = 1u << 6,
+        KnownMask = (1u << 7) - 1,
+    };
+    struct Entry {
+        int32_t uid;
+        uint32_t permissions;
+        bool operator==(const Entry& b) const { return uid == b.uid && permissions == b.permissions; }
+    };
+    int set(int32_t uid, uint32_t permissions);
+    int get(int32_t uid, uint32_t* permissions) const;
+    int remove(int32_t uid);
+    // Validate all input before replacement. Duplicate UIDs are ambiguous and
+    // rejected. Zero-valued entries are omitted from the canonical snapshot.
+    int replace(const std::vector<Entry>& entries);
+    int snapshot(std::vector<Entry>* output) const;
+    int matchingUids(uint32_t required, std::vector<int32_t>* output) const;
+    // EXACT value-level A17 uids_have_loopback_permissions contract. Packet
+    // callers first normalize sender raw65534 as bpf_traffic_account does;
+    // receiver creator65534 stays literal. This method does no lookup/eligibility
+    // test and is NOT itself a packet policy or a publishable callback.
+    int loopbackAllowed(uint32_t sender, uint32_t receiver, bool* output) const;
+    int noInternetDenied(int32_t uid, bool* output) const;
+private:
+    uint32_t permissions(uint32_t uid) const;
+    std::map<uint32_t, uint32_t> mPermissions;
+};
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiUidPolicy.cpp b/server/Gta3xlwifiUidPolicy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ed74157cbf5fa97de8b29c5ed5ddc640c8b0fdca
--- /dev/null
+++ b/server/Gta3xlwifiUidPolicy.cpp
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiUidPolicy.h"
+
+#include <cerrno>
+#include <utility>
+
+namespace android::net::gta3xlwifi {
+
+const std::array<UidPolicy::Chain, 12>& UidPolicy::chains() {
+    // IDs: ConnectivityManager; matches: BpfNetMapsConstants/netd.h;
+    // blocked reasons: ConnectivityManager/BpfNetMapsUtils. Host validation
+    // binds these to the actual pinned Android17 source constants.
+    static constexpr std::array<Chain, 12> table = {{
+        {1, 1u << 2, 1u << 1, true, false},   // dozable
+        {2, 1u << 3, 1u << 2, false, false},  // standby
+        {3, 1u << 4, 1u << 0, true, false},   // powersave
+        {4, 1u << 5, 1u << 3, true, false},   // restricted
+        {5, 1u << 6, 1u << 5, true, false},   // low power standby
+        {6, 1u << 12, 1u << 6, true, false},  // background
+        {7, 1u << 9, 1u << 7, false, false},  // OEM deny 1
+        {8, 1u << 10, 1u << 7, false, false}, // OEM deny 2
+        {9, 1u << 11, 1u << 7, false, false}, // OEM deny 3
+        {10, 1u << 0, DataSaverReason, true, true},
+        {11, 1u << 1, 1u << 17, false, true}, // metered deny user
+        {12, 1u << 13, 1u << 18, false, true}, // metered deny admin
+    }};
+    return table;
+}
+
+const UidPolicy::Chain* UidPolicy::findChain(int32_t id) {
+    for (const auto& chain : chains()) {
+        if (chain.id == id) return &chain;
+    }
+    return nullptr;
+}
+
+int UidPolicy::setChainEnabled(int32_t id, bool enabled) {
+    const Chain* chain = findChain(id);
+    if (!chain) return -EINVAL;
+    if (enabled) mEnabled |= chain->match;
+    else mEnabled &= ~chain->match;
+    return 0;
+}
+
+int UidPolicy::getChainEnabled(int32_t id, bool* enabled) const {
+    const Chain* chain = findChain(id);
+    if (!chain || !enabled) return -EINVAL;
+    *enabled = (mEnabled & chain->match) != 0;
+    return 0;
+}
+
+uint32_t UidPolicy::uidMatches(int32_t uid) const {
+    auto it = mUidMatches.find(uid);
+    return it == mUidMatches.end() ? 0 : it->second;
+}
+
+void UidPolicy::setMatch(int32_t uid, uint32_t match, bool present) {
+    const uint32_t previous = uidMatches(uid);
+    const uint32_t next = present ? (previous | match) : (previous & ~match);
+    if (next) mUidMatches[uid] = next;
+    else mUidMatches.erase(uid);
+}
+
+int UidPolicy::setUidRule(int32_t id, int32_t uid, int32_t rule) {
+    const Chain* chain = findChain(id);
+    if (!chain || uid < 0 || (rule != Default && rule != Allow && rule != Deny)) return -EINVAL;
+    const bool match = (rule == Allow && chain->allowlist) || (rule == Deny && !chain->allowlist);
+    setMatch(uid, chain->match, match);
+    return 0;
+}
+
+int UidPolicy::getUidRule(int32_t id, int32_t uid, int32_t* rule) const {
+    const Chain* chain = findChain(id);
+    if (!chain || uid < 0 || !rule) return -EINVAL;
+    const bool match = (uidMatches(uid) & chain->match) != 0;
+    *rule = match == chain->allowlist ? Allow : Deny;
+    return 0;
+}
+
+int UidPolicy::replaceUidChain(int32_t id, const std::vector<int32_t>& uids) {
+    const Chain* chain = findChain(id);
+    if (!chain) return -EINVAL;
+    for (int32_t uid : uids) {
+        if (uid < 0) return -EINVAL;
+    }
+    // Work on a candidate so validation/cross-chain preservation is explicit.
+    auto next = mUidMatches;
+    for (auto it = next.begin(); it != next.end();) {
+        it->second &= ~chain->match;
+        if (!it->second) it = next.erase(it);
+        else ++it;
+    }
+    for (int32_t uid : uids) next[uid] |= chain->match;
+    mUidMatches = std::move(next);
+    return 0;
+}
+
+int UidPolicy::removeUid(int32_t uid) {
+    if (uid < 0) return -EINVAL;
+    mUidMatches.erase(uid);
+    return 0;
+}
+
+int UidPolicy::blockedReasons(int32_t uid, uint32_t* reasons) const {
+    if (uid < 0 || !reasons) return -EINVAL;
+    uint32_t blocked = 0;
+    // Per-user appId, NOT uid < 10000: secondary-user core UIDs are exempt too.
+    if (uid % 100000 >= 10000) {
+        const uint32_t matches = uidMatches(uid);
+        for (const auto& chain : chains()) {
+            const bool matched = (matches & chain.match) != 0;
+            if (chain.metered) {
+                // These three chains currently ignore configuration-map enable
+                // bits. HAPPY_BOX removes only Data Saver, never user/admin deny.
+                if (chain.allowlist ? (mDataSaver && !matched) : matched) {
+                    blocked |= chain.blockedReason;
+                }
+            } else if ((mEnabled & chain.match) && matched != chain.allowlist) {
+                blocked |= chain.blockedReason;
+            }
+        }
+    }
+    *reasons = blocked;
+    return 0;
+}
+
+int UidPolicy::isNetworkingBlocked(int32_t uid, bool metered) const {
+    uint32_t reasons;
+    const int status = blockedReasons(uid, &reasons);
+    if (status) return status;
+    return (reasons & (metered ? UINT32_MAX : ~MeteredReasonMask)) != 0 ? 1 : 0;
+}
+
+int UidPolicy::matchingUids(int32_t id, std::vector<int32_t>* output) const {
+    const auto* chain = findChain(id);
+    if (!chain || !output) return -EINVAL;
+    std::vector<int32_t> next;
+    for (const auto& entry : mUidMatches) {
+        if (entry.second & chain->match) next.push_back(entry.first);
+    }
+    *output = std::move(next);
+    return 0;
+}
+
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiUidPolicy.h b/server/Gta3xlwifiUidPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..31c950b6e956cc923e08bb3c28178dbac4862568
--- /dev/null
+++ b/server/Gta3xlwifiUidPolicy.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <vector>
+
+namespace android::net::gta3xlwifi {
+
+// Candidate UID-policy value, NOT a kernel backend or a readiness indicator.
+// Mutators change this value only. A future netd owner must apply the complete
+// kernel transaction before publishing it to DNS/Java readers. In particular,
+// do not register a DNS callback or skip NetBpfLoad merely because this exists.
+// Mirrors pinned Android17 BpfNetMapsUtils firewall queries, not INTERNET permission, VPN,
+// interface, local-network packet policy, quotas, or socket-tag permissions.
+class UidPolicy {
+public:
+    enum Rule : int32_t { Default = 0, Allow = 1, Deny = 2 };
+    struct Chain {
+        int32_t id;
+        uint32_t match;
+        uint32_t blockedReason;
+        bool allowlist;
+        bool metered;
+    };
+    static const std::array<Chain, 12>& chains();
+    static constexpr uint32_t MeteredReasonMask = 0xffff0000u;
+    static constexpr uint32_t DataSaverReason = 1u << 16;
+
+    int setChainEnabled(int32_t chain, bool enabled);
+    int getChainEnabled(int32_t chain, bool* enabled) const;
+    int setUidRule(int32_t chain, int32_t uid, int32_t rule);
+    int getUidRule(int32_t chain, int32_t uid, int32_t* rule) const;
+    // This list contains matching UIDs, not ALLOW rules for every chain. Thus
+    // for a denylist it specifies denied UIDs, exactly as replaceUidChain().
+    // Validates the entire input before changing state; duplicates are harmless.
+    int replaceUidChain(int32_t chain, const std::vector<int32_t>& uids);
+    int removeUid(int32_t uid);
+    // Read-only sorted membership snapshot. Output is preserved on invalid input.
+    int matchingUids(int32_t chain, std::vector<int32_t>* output) const;
+    void setDataSaver(bool enabled) { mDataSaver = enabled; }
+    bool dataSaver() const { return mDataSaver; }
+    int blockedReasons(int32_t uid, uint32_t* reasons) const;
+    // Same private V2 result convention: 0 allow, 1 block, negative errno.
+    // This is evaluation of a value, NOT a publishable callback owner.
+    int isNetworkingBlocked(int32_t uid, bool metered) const;
+
+private:
+    static const Chain* findChain(int32_t id);
+    void setMatch(int32_t uid, uint32_t match, bool present);
+    uint32_t uidMatches(int32_t uid) const;
+    uint32_t mEnabled = 0;
+    std::map<int32_t, uint32_t> mUidMatches;
+    bool mDataSaver = false;
+};
+
+}  // namespace android::net::gta3xlwifi
