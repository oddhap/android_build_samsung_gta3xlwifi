diff --git a/server/binder/com/android/internal/net/IGta3xlwifiNetpolicy.aidl b/server/binder/com/android/internal/net/IGta3xlwifiNetpolicy.aidl
new file mode 100644
index 0000000000000000000000000000000000000000..b51971a71c2da43d08cfe2d05ac1107c2960a043
--- /dev/null
+++ b/server/binder/com/android/internal/net/IGta3xlwifiNetpolicy.aidl
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.net;
+import android.os.ParcelFileDescriptor;
+/**
+ * Private gta3xlwifi complete policy transport, separate from frozen INetd.
+ * Protocol 1. Every call requires the system UID, including transferred handles.
+ * A session or completed transport is not a networking readiness signal.
+ * Sections/word encoding are defined by Gta3xlwifiPolicyFrame.h/.cpp.
+ * Chunks have at most 4096 ints; the complete image is bounded independently.
+ * @hide
+ */
+interface IGta3xlwifiNetpolicy {
+    long openSession(IBinder client, int protocolVersion);
+    void beginFrame(long session, long expectedGeneration, in int[] wordCounts,
+            int runtimeFlags, boolean loopbackPermissionEnabled,
+            boolean uidMigrationEnabled, boolean dataSaverEnabled);
+    void appendFrame(long session, int section, int offset, in int[] words);
+    long commitFrame(long session);
+    void abandonFrame(long session);
+    /** Committed generation or zero for verified held/unpublished state. */
+    long readGeneration(long session);
+    /** Explicit retirement, including an interrupted open with unknown session. */
+    void closeSession(IBinder client);
+    /**
+     * Genuine bounded stats. Kind0=state,1=frozen-bank,2=cumulative-app,
+     * 3=cumulative-interface,4=kernel interface-name history,5=UID cleanup receipt metadata. Schema/layout is documented with the service.
+     * Unsigned64 counters retain their exact bits in long. No read consumes.
+     * Caller must inspect actual loss, persist/deduplicate before ACK and never
+     * automatically retry an uncertain SWAP. Connection is not stats readiness.
+     */
+    long[] readStats(long session, int kind, int bank, long epoch);
+    /** Four words: active bank/epoch, frozen bank/epoch. */
+    long[] swapStats(long session, int expectedActiveBank, long expectedActiveEpoch);
+    /** Explicit receipt AFTER accepted/persisted data; native ACK is idempotent. */
+    void acknowledgeStats(long session, int bank, long epoch);
+    void setStatsCounterset(long session, int uid, int counterset);
+    /** Explicit UID/socket removal with exact owner generation/active stats epoch.
+     * No pending bank may exist. Not automatically retried after an uncertain reply.
+     */
+    void removeUidAccounting(long session, int uid, long expectedGeneration,
+            long expectedActiveEpoch);
+    /** Durable caller nonce; completed duplicate returns cached result, never new deletion. */
+    void removeUidAccountingOnce(long session,int uid,long expectedGeneration,
+            long expectedActiveEpoch,long nonce);
+    /** Terminal current-client failure only; exact session AND token, never normal close. */
+    void abortSession(long session,IBinder client);
+    /** Consuming real packet events, maximum512. Never retry an uncertain call.
+     * Schema: [1,6,totalLost,count], then senderUid,receiverUid,result,
+     * boottimeNs,sequence,eventLost for each record. Unsigned64 bits retained.
+     */
+    long[] pollLoopbackEvents(long session);
+    /** Privileged exact AF_INET6/SOCK_RAW/IPPROTO_RAW CLAT FD, tag0/UID1029 only.
+     * Tags are socket-owned; final real FD close retires them. No cookie emulation.
+     */
+    void tagClatSocket(long session,in ParcelFileDescriptor socket);
+}
