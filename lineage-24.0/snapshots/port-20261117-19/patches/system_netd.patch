index 0000000000000000000000000000000000000000..23f01302943bcd5acbb9f6205dad72cb2319221c
--- /dev/null
+++ b/server/Gta3xlwifiSocketPolicyProjection.h
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <functional>
+#include <memory>
+
+#include "Gta3xlwifiIngressPolicy.h"
+#include "Gta3xlwifiSocketTagger.h"
+#include "Gta3xlwifiPermissionBootstrap.h"
+#include "Gta3xlwifiAccountingRoots.h"
+#include "Gta3xlwifiLocalNetworkState.h"
+#include "Gta3xlwifiMeteredRoots.h"
+#include "Gta3xlwifiSocketRoots.h"
+#include "Gta3xlwifiUidPermissionState.h"
+#include "Gta3xlwifiUidPolicy.h"
+namespace android::net::gta3xlwifi {
+// Five-state policy owner with private producer startup/statistics primitives.
+// Not Binder routing, poll persistence or global networking readiness.
+// Sole owner of ONE real lease and one mutex. All rules/parents/guards in both
+// families finish before LNA SET, then UID SET LAST. Error withdraws every
+// value and closes/holds the gate; no post-SET firewall I/O or automatic policy
+// repair.
+class SocketPolicyProjection final {
+ public:
+  struct RuntimePolicy {
+    bool supplied = false;  // Caller must explicitly supply actual Android modes.
+    uint32_t flags = 0;
+    std::vector<uint32_t> legacyBlockedUids;
+  };
+  struct State {
+    UidPolicy policy;
+    IngressPolicy ingress;
+    UidPermissionState permissions;
+    LocalNetworkState local;
+    RuntimePolicy runtime;
+  };
+  enum class HookMode { VerifyOnly, InstallMissing };
+  explicit SocketPolicyProjection(IptablesRestoreInterface& kernel)
+      : mKernel(kernel),
+        mSocket(kernel, mLease),
+        mMeter(kernel, mLease),
+        mAccounting(kernel, mLease),
+        mSocketWriter(kernel, CheckedUidChains::Table::Socket),
+        mFilterWriter(kernel) {}
+  ~SocketPolicyProjection() { stop(); }
+  // Acquire and verify the accounting lease BEFORE Controllers rebuild roots.
+  // No firewall operation or publication; startWithAccounting finishes later.
+  int prepareForControllerStartup();
+  // Real held/unpublished accounting/guards/counter protocol verification.
+  // Called by explicit private provider initialization, never global Ready.
+  int verifyHeldProviderStartup();
+  int start(HookMode mode = HookMode::VerifyOnly);
+  // Explicit source-factory startup after the last generic bandwidth reset.
+  // Requires real iface producers/DROP correction and UID/app packet primitives,
+  // verifies both families while held,
+  // and leaves all policy unpublished until replace(). No global Ready claim.
+  int startWithAccounting(const AccountingRoots::Program& program,
+                          HookMode mode = HookMode::VerifyOnly);
+  // Explicit first publication only. Caller supplies a complete immutable
+  // permission frame plus all other policy state; this does not collect it.
+  // policyWithoutPermissions must have no nonzero permission entries. Invalid
+  // or incomplete frames leave the held gate and unpublished state intact.
+  int publishInitialPermissions(const State& policyWithoutPermissions,
+                                const PermissionBootstrap::Snapshot& permissions);
+  void stop();
+  // expectedGeneration=0 is explicit first commit after start. Stale updates
+  // fail before kernel I/O. Readers see one complete committed state or EAGAIN.
+  int replace(const State& state, uint64_t expectedGeneration);
+  // Same commit mutex returns the exact committed generation for Binder CAS.
+  int replaceWithGeneration(const State& state, uint64_t expectedGeneration,
+                            uint64_t* committedGeneration);
+  // Client death withdraws publication while retaining the verified producer
+  // lease for a complete explicit framework resnapshot. Uncertain HOLD closes it.
+  int suspendFrameworkClient();
+  int abortFrameworkClient();
+  int frameworkGeneration(uint64_t* generation);
+  int isNetworkingBlocked(int32_t uid, bool metered);
+  int snapshot(State* output, uint64_t* generation);
+  int removeUid(int32_t uid);
+  int setUidRule(int32_t chain, int32_t uid, int32_t rule);
+  int setChainEnabled(int32_t chain, bool enabled);
+  int setDataSaver(bool enabled);
+  int setUidPermission(int32_t uid, uint32_t permissions);
+  int setIif(int32_t uid, uint32_t ifindex);
+  int clearIif(int32_t uid);
+  int setLockdown(int32_t uid, bool enabled);
+  int setDiscard(const IngressPolicy::Address& address, uint32_t first,
+                 uint32_t second);
+  int clearDiscard(const IngressPolicy::Address& address);
+  int setLocalEntry(LocalNetworkState::Table table,
+                    LocalNetworkState::Entry entry);
+  int clearLocalEntry(LocalNetworkState::Table table,
+                      LocalNetworkState::Entry entry);
+  // Primitive statistics controls share this owner's transaction mutex/lease.
+  // Available only after startWithAccounting plus complete policy publication.
+  // Non-consuming reads expose real loss; caller must not report lossy data as
+  // complete. SWAP/ACK are explicit; no poll persistence or RPC lifecycle here.
+  // Kernel/protocol failure quarantines the complete four-state publication.
+  int setRuntimePolicy(uint32_t flags, const std::vector<uint32_t>& blockedUids);
+  struct TaggingBudget {
+    uint32_t totalEntries = 0, uidEntries = 0;
+    uint64_t epoch = 0, sequence = 0, lostUpdates = 0;
+  };
+  // Exact active stats row counts, not number of tags or socket descriptors.
+  // Does not authorize tagging or consume/persist any statistics.
+  int readTaggingBudget(int32_t chargeUid, TaggingBudget* output);
+  // Canonical full-UID permission mode. The framework bridge must require its
+  // actual UID-migration flag. Permissions, active budgets and I/O share mMutex.
+  int tagSocket(SocketTagger& transport, int fd, uint32_t tag,
+                int32_t chargeUid, int32_t realUid);
+  int untagSocket(SocketTagger& transport, int fd);
+  // Trusted provider only; Binder enforces fullUID1000/current session.
+  int tagClatSocket(SocketTagger& transport,int fd);
+  int readPacketState(NetpolicyLease::PacketState* output);
+  int readFrozenPacketStats(uint32_t bank, uint64_t epoch,
+                            NetpolicyLease::PacketSnapshot* output);
+  int readAppStats(NetpolicyLease::AppSnapshot* output);
+  int swapPacketStats(uint32_t expectedBank, uint64_t expectedEpoch,
+                      NetpolicyLease::BankTransition* output);
+  int acknowledgePacketStats(uint32_t bank, uint64_t epoch);
+  int setPacketCounterset(int32_t uid, uint32_t counterset);
+  // Final poll/ACK and separate socket-tag cleanup remain caller obligations.
+  int deleteUidPacketStats(int32_t uid);
+  // Native-only trusted transport dependency; never accepted from Binder input.
+  using UidTagDeleter = int (*)(uint32_t uid);
+  // Exact policy/active-epoch fence, no pending bank, socket tags before counters.
+  // Startup generation0 requires genuine HOLD; this does not release it.
+  int readUidCleanup(NetpolicyLease::UidCleanupReceipt* output);
+  int removeUidAccountingOnce(int32_t uid,uint64_t expectedGeneration,
+      uint64_t expectedActiveEpoch,uint64_t nonce,UidTagDeleter deleteTags);
+  int removeUidAccounting(int32_t uid, uint64_t expectedGeneration,
+                          uint64_t expectedActiveEpoch, UidTagDeleter deleteTags);
+  int readIfaceStats(NetpolicyLease::IfaceSnapshot* output);
+  int readIfaceNames(NetpolicyLease::IfaceNamesSnapshot* output);
+  int readLoopbackEvents(NetpolicyLease::LoopbackBatch* output);
+
+ private:
+  using Image = std::vector<CheckedUidChains::Chain>;
+  struct Commit {
+    State value;
+    Image ordinary, metered;
+    NetpolicyLease::PermissionImage uid;
+    NetpolicyLease::LocalNetworkImage local;
+    NetpolicyLease::RuntimeImage runtime;
+    uint64_t generation = 0;
+  };
+  int acquireAccountingLeaseLocked();
+  int packetAccountingAvailableLocked() const;
+  int readTaggingBudgetLocked(int32_t chargeUid, TaggingBudget* output);
+  int applyLocked(State value);
+  int update(const std::function<int(State&)>& mutation);
+  int prepareHooks(HookMode mode);
+  int verifyHooks();
+  int quarantine(int error);
+  IptablesRestoreInterface& mKernel;
+  NetpolicyLease mLease;
+  SocketRoots mSocket;
+  MeteredRoots mMeter;
+  AccountingRoots mAccounting;
+  CheckedUidChains mSocketWriter, mFilterWriter;
+  std::mutex mMutex;
+  bool mControllerLeasePrepared = false;
+  bool mStarted = false;
+  bool mAccountingEnabled = false;
+  uint64_t mGeneration = 0;
+  std::unique_ptr<Commit> mCommit;
+};
+}  // namespace android::net::gta3xlwifi
