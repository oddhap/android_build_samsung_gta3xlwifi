@@ -573,6 +574,10 @@ endif;
 
 def GenerateNonAbOtaPackage(target_file, output_file, source_file=None):
   """Generates a non-A/B OTA package."""
+  if (OPTIONS.info_dict.get("gta3xlwifi_preserve_recovery") == "true" and
+      OPTIONS.two_step):
+    raise common.ExternalError("Two-step OTA would replace preserved recovery")
+
   # Check the loaded info dicts first.
   if OPTIONS.info_dict.get("no_recovery") == "true":
     raise common.ExternalError(
@@ -707,6 +712,27 @@ def _WriteRecoveryImageToBoot(script, output_zip):
     script.WriteRawImage("/boot", "recovery.img")
 
 
+def ValidateRecoveryResources(target_files_zip, info_dict, device,
+                              two_step=False, wipe_user_data=False):
+  """Require recovery replacement normally; forbid it for preserved SM-T510 TWRP."""
+  if info_dict.get("gta3xlwifi_preserve_recovery") != "true":
+    assert HasRecoveryPatch(target_files_zip, info_dict=info_dict)
+    return
+
+  if (device != "gta3xlwifi" or info_dict.get("allow_non_ab") != "true" or
+      info_dict.get("ab_update") == "true" or
+      info_dict.get("multistage_support") or two_step or wipe_user_data):
+    raise common.ExternalError("Invalid preserved SM-T510 recovery contract")
+
+  for name in target_files_zip.namelist():
+    if name.endswith(("/install-recovery.sh", "/recovery-from-boot.p",
+                      "/recovery-resource.dat", "/vendor_flash_recovery.rc",
+                      "/etc/recovery.img")):
+      raise common.ExternalError("Unexpected recovery replacement resource: " + name)
+  # IMAGES/recovery.img is a diagnostic build output, never installed here.
+  # Existing read-only device hooks still enforce recognized recovery/OS/SPL.
+
+
 def HasRecoveryPatch(target_files_zip, info_dict):
   board_uses_vendorimage = info_dict.get("board_uses_vendorimage") == "true"
 
