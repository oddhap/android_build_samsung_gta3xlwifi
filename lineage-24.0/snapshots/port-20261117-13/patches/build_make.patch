diff --git a/core/Makefile b/core/Makefile
index 65c45cb835d01281314fd418cc4f52947e337d92..516876e2f8df0d3f08598f57a792c5a6a63e76e5 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -6166,7 +6166,12 @@ endif
 	$(hide) echo 'recovery_mkbootimg_args=$(BOARD_RECOVERY_MKBOOTIMG_ARGS)' >> $@
 	$(hide) echo 'mkbootimg_version_args=$(INTERNAL_MKBOOTIMG_VERSION_ARGS)' >> $@
 	$(hide) echo 'mkbootimg_init_args=$(BOARD_MKBOOTIMG_INIT_ARGS)' >> $@
+# Preserve the installed SM-T510 TWRP; no automatic replacement or two-step OTA.
+ifeq ($(TARGET_DEVICE),gta3xlwifi)
+	$(hide) echo "gta3xlwifi_preserve_recovery=true" >> $@
+else
 	$(hide) echo "multistage_support=1" >> $@
+endif
 	$(hide) echo "blockimgdiff_versions=3,4" >> $@
 ifeq ($(PRODUCT_BUILD_GENERIC_OTA_PACKAGE),true)
 	$(hide) echo "build_generic_ota_package=true" >> $@
