+#if defined(__BIONIC__)
+static void TestSpawnCloexecDefault(short extra_flags) {
+  android::base::unique_fd source(open("/proc/version", O_RDONLY));
+  ASSERT_NE(-1, source.get());
+  // Use high descriptors so the shell cannot accidentally reuse the leaked-fd
+  // probe while executing the test command.
+  android::base::unique_fd unwanted(fcntl(source.get(), F_DUPFD, 128));
+  android::base::unique_fd kept(fcntl(source.get(), F_DUPFD, 129));
+  ASSERT_NE(-1, unwanted.get());
+  ASSERT_NE(-1, kept.get());
+  int raw_pipe[2];
+  ASSERT_EQ(0, pipe(raw_pipe));
+  android::base::unique_fd read_end(raw_pipe[0]), write_end(raw_pipe[1]);
+  posix_spawnattr_t attr;
+  ASSERT_EQ(0, posix_spawnattr_init(&attr));
+  ASSERT_EQ(0, posix_spawnattr_setflags(&attr, POSIX_SPAWN_CLOEXEC_DEFAULT | extra_flags));
+  posix_spawn_file_actions_t actions;
+  ASSERT_EQ(0, posix_spawn_file_actions_init(&actions));
+  ASSERT_EQ(0, posix_spawn_file_actions_adddup2(&actions, write_end.get(), STDOUT_FILENO));
+  ASSERT_EQ(0, posix_spawn_file_actions_adddup2(&actions, kept.get(), kept.get()));
+  std::string command = android::base::StringPrintf(
+      "[ ! -e /proc/self/fd/%d ] && cat /proc/self/fd/%d", unwanted.get(), kept.get());
+  ExecTestHelper eth;
+  eth.SetArgs({BIN_DIR "sh", "-c", command.c_str(), nullptr});
+  pid_t pid;
+  ASSERT_EQ(0, posix_spawn(&pid, eth.GetArg0(), &actions, &attr, eth.GetArgs(), eth.GetEnv()));
+  ASSERT_EQ(0, posix_spawn_file_actions_destroy(&actions));
+  ASSERT_EQ(0, posix_spawnattr_destroy(&attr));
+  write_end.reset();
+  std::string content, expected;
+  ASSERT_TRUE(android::base::ReadFdToString(read_end.get(), &content));
+  ASSERT_TRUE(android::base::ReadFileToString("/proc/version", &expected));
+  EXPECT_EQ(expected, content);
+  AssertChildExited(pid, 0);
+  // fork and vfork must both leave the parent's flags alone.
+  EXPECT_EQ(0, fcntl(unwanted.get(), F_GETFD));
+  EXPECT_EQ(0, fcntl(kept.get(), F_GETFD));
+}
+
+TEST(spawn, posix_spawn_CLOEXEC_DEFAULT) {
+  TestSpawnCloexecDefault(0);
+}
+
+TEST(spawn, posix_spawn_CLOEXEC_DEFAULT_USEVFORK) {
+  TestSpawnCloexecDefault(POSIX_SPAWN_USEVFORK);
+}
+#endif
