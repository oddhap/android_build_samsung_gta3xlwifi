+
+static int CloseOnExecScanError(int fd) {
+  int saved_errno = errno;
+  close(fd);
+  errno = saved_errno;
+  return -1;
+}
+
+static int SetCloseOnExecFromProc() {
+  // This runs after fork/vfork: opendir/readdir allocate and are not safe here.
+  // Scan the actual fd table rather than RLIMIT_NOFILE: existing descriptors can
+  // be above a subsequently lowered limit. The child's table is not shared
+  // with the parent's other threads, and no user signal handlers can run here.
+  int dir_fd = TEMP_FAILURE_RETRY(open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+  if (dir_fd == -1) return -1;
+  // A chroot may contain an ordinary /proc/self/fd directory. Treating that
+  // as an empty fd table would silently defeat CLOEXEC_DEFAULT.
+  struct statfs fs;
+  if (fstatfs(dir_fd, &fs) == -1) return CloseOnExecScanError(dir_fd);
+  if (fs.f_type != PROC_SUPER_MAGIC) {
+    errno = ENOTSUP;
+    return CloseOnExecScanError(dir_fd);
+  }
+  bool saw_dir_fd = false;
+  // Keep the post-vfork stack small (libc enforces a 2 KiB frame limit).
+  alignas(dirent) char buffer[1024];
+  constexpr size_t name_offset = offsetof(dirent, d_name);
+  while (true) {
+    int rc = TEMP_FAILURE_RETRY(__getdents64(dir_fd, reinterpret_cast<dirent*>(buffer), sizeof(buffer)));
+    if (rc == -1) return CloseOnExecScanError(dir_fd);
+    if (rc == 0) break;
+    size_t size = static_cast<size_t>(rc);
+    if (size > sizeof(buffer)) {
+      errno = EIO;
+      return CloseOnExecScanError(dir_fd);
+    }
+    for (size_t offset = 0; offset < size;) {
+      if (offset % alignof(dirent) != 0 || size - offset <= name_offset) {
+        errno = EIO;
+        return CloseOnExecScanError(dir_fd);
+      }
+      const auto* entry = reinterpret_cast<const dirent*>(buffer + offset);
+      if (entry->d_reclen <= name_offset || entry->d_reclen > size - offset) {
+        errno = EIO;
+        return CloseOnExecScanError(dir_fd);
+      }
+      const char* name = entry->d_name;
+      const char* end = static_cast<const char*>(memchr(name, '\0', entry->d_reclen - name_offset));
+      if (end == nullptr || end == name) {
+        errno = EIO;
+        return CloseOnExecScanError(dir_fd);
+      }
+      offset += entry->d_reclen;
+      if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) continue;
+      int fd = 0;
+      for (const char* p = name; p != end; ++p) {
+        if (*p < '0' || *p > '9' || fd > (INT_MAX - (*p - '0')) / 10) {
+          errno = EIO;
+          return CloseOnExecScanError(dir_fd);
+        }
+        fd = fd * 10 + (*p - '0');
+      }
+      if (fd == dir_fd) {
+        saw_dir_fd = true;
+        continue;
+      }
+      if (fd < 3) continue;
+      int flags = fcntl(fd, F_GETFD, 0);
+      if (flags == -1 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) == -1) {
+        if (errno == EBADF) continue;  // A closed descriptor cannot leak across exec.
+        return CloseOnExecScanError(dir_fd);
+      }
+    }
+  }
+  if (!saw_dir_fd) {
+    errno = EIO;
+    return CloseOnExecScanError(dir_fd);
+  }
+  return close(dir_fd);
+}
+
+static int SetAllFdsCloseOnExec() {
+  if (close_range(3, ~0U, CLOSE_RANGE_CLOEXEC) == 0) return 0;
+  // Linux < 5.9 has no close_range; 5.9/5.10 lack CLOSE_RANGE_CLOEXEC.
+  // Other errors (including permission failures) must not be hidden.
+  if (errno != ENOSYS && errno != EINVAL) return -1;
+  return SetCloseOnExecFromProc();
+}
+
