+// cgroup v1 has real cgroup.procs membership and EBUSY removal semantics, but
+// no cgroup.events, cgroup.kill or system/app v2 sub-hierarchies. Keep bounded
+// signaling/cleanup and propagate errors; never claim that a live group is gone.
+static int KillLegacyProcessGroup(uid_t uid, pid_t pid, int signal, bool once,
+                                  std::chrono::steady_clock::time_point until) {
+    std::string root;
+    if (!GetProcessGroupHierarchyPath(&root)) return -ENODEV;
+    int ret;
+    do {
+        if (!sendSignalToProcessGroup(uid, pid, signal) && errno != ENOENT) return -1;
+        ret = RemoveCgroup(root.c_str(), uid, pid, false);
+        if (ret && errno != EBUSY) return ret;
+        const int group_errno = errno;
+        if (isMemoryCgroupSupported() && UsePerAppMemcg()) {
+            std::string memory;
+            if (CgroupGetMemcgAppsPath(&memory) && memory != root) {
+                const int memory_ret = RemoveCgroup(memory.c_str(), uid, pid, false);
+                if (memory_ret && errno != EBUSY) return memory_ret;
+                if (memory_ret) ret = memory_ret;
+                else if (ret) errno = group_errno;
+            }
+        }
+        if (!ret || once) break;
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= until) break;
+        std::this_thread::sleep_for(std::min(5ms, toMillisec(until - now)));
+    } while (true);
+    return ret;
+}
