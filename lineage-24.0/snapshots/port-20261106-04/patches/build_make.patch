index fef646f3aec7e8fc2b75a8a8341a3762d6b94668..5fd30c236946c34f1ba28e19b134206aeea2ed97 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -3858,6 +3858,16 @@ def MakeRecoveryPatch(input_dir, output_sink, recovery_img, boot_img,
   if info_dict is None:
     info_dict = OPTIONS.info_dict
 
+  # This hybrid product keeps the original vendor image and installed TWRP.
+  # Do not generate recovery replacement resources, including during repacking.
+  if info_dict.get("gta3xlwifi_preserve_recovery") == "true":
+    if (info_dict.get("ab_update") == "true" or
+        info_dict.get("allow_non_ab") != "true" or
+        info_dict.get("multistage_support")):
+      raise ExternalError("Invalid SM-T510 recovery-preservation metadata")
+    logger.info("Preserving installed SM-T510 recovery; no replacement resources")
+    return
+
   full_recovery_image = info_dict.get("full_recovery_image") == "true"
   board_uses_vendorimage = info_dict.get("board_uses_vendorimage") == "true"
 
