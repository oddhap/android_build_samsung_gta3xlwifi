+# Samsung Mali HIDL2 clients on the retained Linux4.4 ION allocator.
+# Restore the legacy read interface only for the actual graphics clients.
+# Keep current Android17 and Samsung assertions and enforcement intact.
+allow { hal_graphics_allocator_server hal_graphics_composer_server surfaceflinger bootanim } ion_device:chr_file r_file_perms;
