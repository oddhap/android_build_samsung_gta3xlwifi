+on post-fs
+    mkdir /cache/gta3xlwifi_metadata 0755 root root
+    restorecon_recursive /cache/gta3xlwifi_metadata
+    mount none /cache/gta3xlwifi_metadata /metadata bind
+    restorecon_recursive /metadata
