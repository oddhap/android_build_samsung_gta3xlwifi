+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server;
+
+import static android.net.ConnectivityManager.*;
+import static android.system.OsConstants.*;
+
+import android.net.BpfNetMapsUtils;
+import android.net.INetd;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import android.util.IndentingPrintWriter;
+
+import com.android.net.module.util.Struct;
+import com.android.net.module.util.bpf.IngressDiscardKey;
+import com.android.server.permission.PermissionBpfMap;
+
+import java.net.InetAddress;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.*;
+import java.util.function.Consumer;
+
+/** Complete policy owner client; successful policy publication is not global networking Ready. */
+public final class Gta3xlwifiNetpolicyBackend {
+    public interface Transport {
+        long publish(Gta3xlwifiNetpolicyClient.Frame frame) throws RemoteException;
+
+        long generation() throws RemoteException;
+
+        void close() throws RemoteException;
+        default boolean requiresStatsAdmission() { return false; }
+        default void abort() throws RemoteException { close(); }
+
+        default Gta3xlwifiStatsAccess statsAccess() {
+            throw new UnsupportedOperationException("No real private stats transport");
+        }
+    }
+
+    public static Gta3xlwifiNetpolicyBackend connect(
+            INetd netd,
+            boolean migration,
+            boolean loopbackChecks,
+            boolean loopbackMetrics,
+            boolean permissionPropagation,
+            boolean betaMetrics,
+            boolean l4sLoaded)
+            throws RemoteException {
+        if (!migration || !permissionPropagation || betaMetrics || l4sLoaded) {
+            throw error(EOPNOTSUPP, "Unsupported actual private backend mode");
+        }
+        final Gta3xlwifiNetpolicyClient client = Gta3xlwifiNetpolicyClient.lookup(netd);
+        try {
+            client.start();
+            return new Gta3xlwifiNetpolicyBackend(
+                    new Transport() {
+                        public long publish(Gta3xlwifiNetpolicyClient.Frame frame)
+                                throws RemoteException {
+                            return client.publishCompleteSnapshot(frame);
+                        }
+
+                        public long generation() throws RemoteException {
+                            return client.generation();
+                        }
+
+                        public boolean requiresStatsAdmission() { return true; }
+                        public Gta3xlwifiStatsAccess statsAccess() {
+                            return client.statsAccess();
+                        }
+
+                        public void abort() throws RemoteException {
+                            client.abortCurrentSession();
+                        }
+                        public void close() throws RemoteException {
+                            client.close();
+                        }
+                    },
+                    loopbackChecks,
+                    loopbackMetrics,
+                    permissionPropagation);
+        } catch (RemoteException | RuntimeException failure) {
+            try {
+                client.close();
+            } catch (RemoteException | RuntimeException cleanup) {
+                if (cleanup != failure) failure.addSuppressed(cleanup);
+            }
+            throw failure;
+        }
+    }
+
+    private final Object mLock = new Object();
+    private boolean mStatsAdmitted;
+    private final Transport mTransport;
+    public final boolean loopbackChecks, loopbackMetrics, permissionPropagation;
+    private final Gta3xlwifiPermissionCollector mCollector;
+    private Gta3xlwifiPermissionCollector.Snapshot mPermissions;
+    private State mState = new State();
+    private long mGeneration;
+    private boolean mInvalid;
+
+    private static final class Owner {
+        boolean hasIif, lockdown;
+        int iif;
+
+        Owner() {}
+
+        Owner(Owner source) {
+            hasIif = source.hasIif;
+            lockdown = source.lockdown;
+            iif = source.iif;
+        }
+    }
+
+    private static final class Prefix implements Comparable<Prefix> {
+        final int bits;
+        final byte[] bytes;
+
+        Prefix(Struct key) {
+            byte[] wire = key.writeToBytes();
+            if (wire.length != 28) throw error(EINVAL, "Invalid LNA key size");
+            bits = ByteBuffer.wrap(wire).order(ByteOrder.nativeOrder()).getInt();
+            if (bits < 0 || bits > 192) throw error(EINVAL, "Invalid LNA prefix");
+            bytes = Arrays.copyOfRange(wire, 4, 28);
+            for (int bit = bits; bit < 192; bit++) bytes[bit / 8] &= ~(1 << (7 - bit % 8));
+        }
+
+        public int compareTo(Prefix other) {
+            int comparison = Integer.compare(bits, other.bits);
+            return comparison != 0 ? comparison : Arrays.compareUnsigned(bytes, other.bytes);
+        }
+
+        boolean matches(Prefix query) {
+            if (bits > query.bits) return false;
+            for (int bit = 0; bit < bits; bit++)
+                if (((bytes[bit / 8] ^ query.bytes[bit / 8]) & (1 << (7 - bit % 8))) != 0)
+                    return false;
+            return true;
+        }
+
+        int ifindex() {
+            return ByteBuffer.wrap(bytes).order(ByteOrder.nativeOrder()).getInt(4);
+        }
+    }
+
+    private static final class State {
+        final boolean[] enabled = new boolean[13];
+        final TreeMap<Integer, TreeSet<Integer>> members = new TreeMap<>();
+        final TreeMap<Integer, Owner> ingress = new TreeMap<>();
+        final TreeMap<String, int[]> discard = new TreeMap<>();
+        final TreeMap<Prefix, Boolean> network = new TreeMap<>(), host = new TreeMap<>();
+        final TreeSet<Integer> blocked = new TreeSet<>();
+        boolean dataSaver;
+
+        State() {
+            for (int chain = 1; chain <= 12; chain++) members.put(chain, new TreeSet<>());
+        }
+
+        State(State old) {
+            System.arraycopy(old.enabled, 0, enabled, 0, enabled.length);
+            for (var e : old.members.entrySet())
+                members.put(e.getKey(), new TreeSet<>(e.getValue()));
+            for (var e : old.ingress.entrySet()) ingress.put(e.getKey(), new Owner(e.getValue()));
+            for (var e : old.discard.entrySet()) discard.put(e.getKey(), e.getValue().clone());
+            network.putAll(old.network);
+            host.putAll(old.host);
+            blocked.addAll(old.blocked);
+            dataSaver = old.dataSaver;
+        }
+    }
+
+    public Gta3xlwifiNetpolicyBackend(
+            Transport transport, boolean checks, boolean metrics, boolean propagation) {
+        mTransport = Objects.requireNonNull(transport);
+        if (!propagation) throw error(EOPNOTSUPP, "Complete permission propagation required");
+        loopbackChecks = checks;
+        loopbackMetrics = metrics;
+        permissionPropagation = propagation;
+        mCollector =
+                new Gta3xlwifiPermissionCollector(
+                        mLock,
+                        new Gta3xlwifiPermissionCollector.Sink() {
+                            public void accept(Gta3xlwifiPermissionCollector.Snapshot input) {
+                                requireLive();
+                                publish(mState, input);
+                                mPermissions = input;
+                            }
+
+                            public void invalidate(Throwable failure) {
+                                Gta3xlwifiNetpolicyBackend.this.invalidate(failure);
+                            }
+                        });
+    }
+
+    private static ServiceSpecificException error(int code, String message) {
+        return new ServiceSpecificException(code, message);
+    }
+
+    private static void uid(int value) {
+        if (value < 0) throw error(EINVAL, "Invalid UID");
+    }
+
+    private static void chain(int value) {
+        BpfNetMapsUtils.getMatchByFirewallChain(value);
+    }
+
+    /** Capture BEFORE acquiring the factory data lock; early HOLD is allowed. */
+    public Gta3xlwifiStatsAccess statsAccess() {
+        synchronized (mLock) {
+            requireLive();
+            return mTransport.statsAccess();
+        }
+    }
+
+    /** Caller has durably initialized/recovered its factory, outside its data lock. */
+    public void completeStatsAdmission() {
+        synchronized(mLock) {
+            requireLive();if(!mTransport.requiresStatsAdmission()||mStatsAdmitted)return;
+            try {
+                if(mTransport.statsAccess().readUidCleanup().phase==1)
+                    throw new java.io.IOException("Kernel UID removal is unresolved");
+                mStatsAdmitted=true;
+                if(mPermissions!=null)publish(mState,mPermissions);
+            }catch(java.io.IOException failure){invalidate(failure);
+                throw error(ENOTCONN,"Statistics admission failed");}
+        }
+    }
+
+    private void requireLive() {
+        if (mInvalid) throw error(ENOTCONN, "Private policy requires complete recovery");
+    }
+
+    private void invalidate(Throwable failure) {
+        mInvalid = true;
+        mGeneration = 0;
+        mPermissions = null;
+        try {
+            mTransport.abort();
+        } catch (RemoteException | RuntimeException cleanup) {
+            if (cleanup != failure) failure.addSuppressed(cleanup);
+        }
+    }
+
+    private void published() {
+        requireLive();
+        if (mGeneration == 0) throw error(EAGAIN, "Complete initial permissions not committed");
+        try {
+            if (mTransport.generation() != mGeneration) {
+                var failure = error(ESTALE, "Native publication changed");
+                invalidate(failure);
+                throw failure;
+            }
+        } catch (RemoteException failure) {
+            invalidate(failure);
+            throw error(ENOTCONN, "Native generation unavailable");
+        } catch (RuntimeException failure) {
+            if (!mInvalid) invalidate(failure);
+            throw failure;
+        }
+    }
+
+    public PermissionBpfMap permissionReceiver(boolean actualLoopbackPermission) {
+        synchronized (mLock) {
+            requireLive();
+            if (actualLoopbackPermission != loopbackChecks)
+                throw error(EOPNOTSUPP, "Framework loopback modes disagree");
+            return mCollector;
+        }
+    }
+
+    private static int[] words(Collection<Integer> values) {
+        return values.stream().mapToInt(Integer::intValue).toArray();
+    }
+
+    private static void append(List<Integer> words, int... fields) {
+        for (int field : fields) words.add(field);
+    }
+
+    private static int[] prefixWords(TreeMap<Prefix, Boolean> entries) {
+        List<Integer> words = new ArrayList<>();
+        for (var e : entries.entrySet()) {
+            append(words, e.getKey().bits);
+            ByteBuffer bytes = ByteBuffer.wrap(e.getKey().bytes).order(ByteOrder.BIG_ENDIAN);
+            for (int i = 0; i < 6; i++) append(words, bytes.getInt());
+            append(words, e.getValue() ? 1 : 0);
+        }
+        return words(words);
+    }
+
+    private Gta3xlwifiNetpolicyClient.Frame frame(
+            State state, Gta3xlwifiPermissionCollector.Snapshot permissions) {
+        TreeSet<Integer> owners = new TreeSet<>(state.ingress.keySet());
+        List<Integer> configuration = new ArrayList<>(),
+                members = new ArrayList<>(),
+                ingress = new ArrayList<>(),
+                discard = new ArrayList<>();
+        for (int c = 1; c <= 12; c++) {
+            append(configuration, c, state.enabled[c] ? 1 : 0);
+            for (int u : state.members.get(c)) {
+                owners.add(u);
+                append(members, c, u);
+            }
+        }
+        if (owners.size() > 20000
+                || state.discard.size() > 100
+                || state.network.size() > 1000
+                || state.host.size() > 1000
+                || state.blocked.size() > 1000)
+            throw error(ENOSPC, "Native policy capacity exceeded");
+        for (var e : state.ingress.entrySet())
+            append(
+                    ingress,
+                    e.getKey(),
+                    e.getValue().hasIif ? 1 : 0,
+                    e.getValue().iif,
+                    e.getValue().lockdown ? 1 : 0);
+        for (int[] entry : state.discard.values()) append(discard, entry);
+        int flags =
+                (loopbackChecks ? 1 : 0)
+                        | (loopbackMetrics ? 2 : 0)
+                        | (permissionPropagation ? 4 : 0);
+        return new Gta3xlwifiNetpolicyClient.Frame(
+                new int[][] {
+                    permissions.users(),
+                    permissions.knownUids(),
+                    permissions.rawPermissionWords(),
+                    words(configuration),
+                    words(members),
+                    words(ingress),
+                    words(discard),
+                    prefixWords(state.network),
+                    prefixWords(state.host),
+                    words(state.blocked)
+                },
+                flags,
+                loopbackChecks,
+                true,
+                state.dataSaver);
+    }
+
+    private void publish(State state, Gta3xlwifiPermissionCollector.Snapshot permissions) {
+        if(mTransport.requiresStatsAdmission()&&!mStatsAdmitted)return;
+        var candidate = frame(state, permissions);
+        try {
+            long generation = mTransport.publish(candidate);
+            if (generation <= 0 || generation <= mGeneration)
+                throw error(EPROTO, "Invalid native policy generation");
+            mGeneration = generation;
+        } catch (RemoteException | RuntimeException failure) {
+            invalidate(failure);
+            if (failure instanceof RuntimeException) throw (RuntimeException) failure;
+            throw error(ENOTCONN, "Policy commit failed");
+        }
+    }
+
+    private static void capacity(State state) {
+        TreeSet<Integer> owners = new TreeSet<>(state.ingress.keySet());
+        for (var members : state.members.values()) owners.addAll(members);
+        if (owners.size() > 20000
+                || state.discard.size() > 100
+                || state.network.size() > 1000
+                || state.host.size() > 1000
+                || state.blocked.size() > 1000) {
+            throw error(ENOSPC, "Native policy capacity exceeded");
+        }
+    }
+
+    private void update(Consumer<State> action) {
+        synchronized (mLock) {
+            requireLive();
+            State next = new State(mState);
+            action.accept(next);
+            capacity(next);
+            if (mPermissions != null) publish(next, mPermissions);
+            mState = next;
+        }
+    }
+
+    public void setChain(int c, boolean enabled) {
+        chain(c);
+        update(s -> s.enabled[c] = enabled);
+    }
+
+    public boolean chainEnabled(int c) {
+        chain(c);
+        synchronized (mLock) {
+            published();
+            return mState.enabled[c];
+        }
+    }
+
+    public void replaceChain(int c, int[] uids) {
+        chain(c);
+        TreeSet<Integer> next = new TreeSet<>();
+        for (int u : uids) {
+            uid(u);
+            next.add(u);
+        }
+        update(s -> s.members.put(c, next));
+    }
+
+    public void setRule(int c, int u, int rule) {
+        chain(c);
+        uid(u);
+        if (rule < 0 || rule > 2) throw error(EINVAL, "Invalid UID rule");
+        boolean add =
+                (rule == FIREWALL_RULE_ALLOW && BpfNetMapsUtils.isFirewallAllowList(c))
+                        || (rule == FIREWALL_RULE_DENY && !BpfNetMapsUtils.isFirewallAllowList(c));
+        update(
+                s -> {
+                    if (add) s.members.get(c).add(u);
+                    else s.members.get(c).remove(u);
+                });
+    }
+
+    public int rule(int c, int u) {
+        chain(c);
+        uid(u);
+        synchronized (mLock) {
+            published();
+            return mState.members.get(c).contains(u) == BpfNetMapsUtils.isFirewallAllowList(c)
+                    ? FIREWALL_RULE_ALLOW
+                    : FIREWALL_RULE_DENY;
+        }
+    }
+
+    public Set<Integer> matching(int c) {
+        chain(c);
+        synchronized (mLock) {
+            published();
+            return new TreeSet<>(mState.members.get(c));
+        }
+    }
+
+    public void dataSaver(boolean enabled) {
+        update(s -> s.dataSaver = enabled);
+    }
+
+    private static void prune(State state, int uid, Owner owner) {
+        if (!owner.hasIif && !owner.lockdown) state.ingress.remove(uid);
+        else state.ingress.put(uid, owner);
+    }
+
+    public void setIif(int[] uids, int index, boolean add) {
+        if (index < 0) throw error(EINVAL, "Invalid interface");
+        for (int u : uids) uid(u);
+        update(
+                s -> {
+                    for (int u : uids) {
+                        Owner owner = s.ingress.computeIfAbsent(u, k -> new Owner());
+                        owner.hasIif = add;
+                        owner.iif = add ? index : 0;
+                        prune(s, u, owner);
+                    }
+                });
+    }
+
+    public void lockdown(int u, boolean enabled) {
+        uid(u);
+        update(
+                s -> {
+                    Owner owner = s.ingress.computeIfAbsent(u, k -> new Owner());
+                    owner.lockdown = enabled;
+                    prune(s, u, owner);
+                });
+    }
+
+    private static int[] discard(InetAddress address, int first, int second) {
+        byte[] bytes = new IngressDiscardKey(address).writeToBytes();
+        if (bytes.length != 16 || first < 0 || second < 0)
+            throw error(EINVAL, "Invalid discard key");
+        ByteBuffer buffer = ByteBuffer.wrap(bytes).order(ByteOrder.BIG_ENDIAN);
+        int a = buffer.getInt(0), b = buffer.getInt(4), c = buffer.getInt(8), d = buffer.getInt(12);
+        if (a == 0 && b == 0 && d == 0 && (c == 0 || c == 65535)) {
+            throw error(EINVAL, "Unassigned discard address");
+        }
+        return new int[] {
+            buffer.getInt(), buffer.getInt(), buffer.getInt(), buffer.getInt(), first, second
+        };
+    }
+
+    private static String addressKey(InetAddress address) {
+        return Arrays.toString(Arrays.copyOf(discard(address, 0, 0), 4));
+    }
+
+    public void setDiscard(InetAddress address, int index) {
+        if (index <= 0) throw error(EINVAL, "Invalid discard interface");
+        int[] value = discard(address, index, index);
+        update(s -> s.discard.put(addressKey(address), value));
+    }
+
+    public void removeDiscard(InetAddress address) {
+        String key = addressKey(address);
+        update(s -> s.discard.remove(key));
+    }
+
+    public void local(Struct key, boolean host, Boolean allowed) {
+        Prefix prefix = new Prefix(key);
+        update(
+                s -> {
+                    var table = host ? s.host : s.network;
+                    if (allowed == null) table.remove(prefix);
+                    else table.put(prefix, allowed);
+                });
+    }
+
+    public boolean localAllowed(Struct key) {
+        Prefix query = new Prefix(key);
+        synchronized (mLock) {
+            published();
+            boolean allowed = true;
+            for (var e : mState.network.entrySet())
+                if (e.getKey().matches(query)) allowed = e.getValue();
+            return allowed;
+        }
+    }
+
+    public void removeHostInterface(int index) {
+        update(s -> s.host.keySet().removeIf(k -> k.ifindex() == index));
+    }
+
+    public void blockLocalUid(int u, boolean blocked) {
+        uid(u);
+        update(
+                s -> {
+                    if (blocked) s.blocked.add(u);
+                    else s.blocked.remove(u);
+                });
+    }
+
+    public boolean localUidBlocked(int u) {
+        uid(u);
+        synchronized (mLock) {
+            published();
+            return mState.blocked.contains(u);
+        }
+    }
+
+    public int permissions(int u) {
+        uid(u);
+        synchronized (mLock) {
+            published();
+            int[] raw = mPermissions.rawPermissionWords();
+            for (int i = 0; i < raw.length; i += 2) if (raw[i] == u) return convert(raw[i + 1]);
+            for (int known : mPermissions.knownUids()) if (known == u) return 4;
+            return 0;
+        }
+    }
+
+    private int convert(int raw) {
+        int mask = 0;
+        if ((raw & ((1 << 0) | (1 << 8))) != 0) mask |= 1;
+        if ((raw & (1 << 1)) != 0) mask |= 2;
+        if ((raw & (1 << 2)) == 0) mask |= 4;
+        if (loopbackChecks) {
+            if ((raw & (1 << 3)) != 0) mask |= 8;
+            if ((raw & (1 << 4)) != 0) mask |= 16;
+            if ((raw & (1 << 5)) != 0) mask |= 32;
+            if ((raw & ((1 << 6) | (1 << 7))) != 0) mask |= 64;
+        }
+        return mask;
+    }
+
+    public int blockedReasons(int u) {
+        uid(u);
+        synchronized (mLock) {
+            published();
+            if (u % 100000 < 10000) return BLOCKED_REASON_NONE;
+            int result = 0;
+            int[] reasons = {
+                0,
+                BLOCKED_REASON_DOZE,
+                BLOCKED_REASON_APP_STANDBY,
+                BLOCKED_REASON_BATTERY_SAVER,
+                BLOCKED_REASON_RESTRICTED_MODE,
+                BLOCKED_REASON_LOW_POWER_STANDBY,
+                BLOCKED_REASON_APP_BACKGROUND,
+                BLOCKED_REASON_OEM_DENY,
+                BLOCKED_REASON_OEM_DENY,
+                BLOCKED_REASON_OEM_DENY
+            };
+            for (int c = 1; c <= 9; c++)
+                if (mState.enabled[c]
+                        && mState.members.get(c).contains(u)
+                                != BpfNetMapsUtils.isFirewallAllowList(c)) result |= reasons[c];
+            if (mState.dataSaver && !mState.members.get(10).contains(u))
+                result |= BLOCKED_METERED_REASON_DATA_SAVER;
+            if (mState.members.get(11).contains(u))
+                result |= BLOCKED_METERED_REASON_USER_RESTRICTED;
+            if (mState.members.get(12).contains(u)) result |= BLOCKED_METERED_REASON_ADMIN_DISABLED;
+            return result;
+        }
+    }
+
+    public void unsupported(String operation) {
+        throw error(EOPNOTSUPP, "Private backend requires explicit implementation: " + operation);
+    }
+
+    public void dump(IndentingPrintWriter writer) {
+        synchronized (mLock) {
+            writer.println(
+                    "Private gta3xlwifi policy: generation="
+                            + mGeneration
+                            + " invalid="
+                            + mInvalid
+                            + " permissions="
+                            + (mPermissions != null));
+            writer.println(
+                    "Kernel packet statistics/event delivery is separate from policy publication.");
+        }
+    }
+}
diff --git a/service/src/com/android/server/Gta3xlwifiNetpolicyClient.java b/service/src/com/android/server/Gta3xlwifiNetpolicyClient.java
new file mode 100644
index 0000000000000000000000000000000000000000..ff243d1260127c506cee0c451c39ba205f66561e
--- /dev/null
+++ b/service/src/com/android/server/Gta3xlwifiNetpolicyClient.java
@@ -0,0 +1,240 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server;
+
+import android.net.INetd;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import static android.system.OsConstants.ESTALE;
+import com.android.internal.net.IGta3xlwifiNetpolicy;
+import com.android.internal.net.IOemNetd;
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Private complete-policy transport. The caller must collect every section from
+ * current framework state, including raw permissions and actual runtime flags.
+ * A connected client is not networking Ready. No BPF map or readiness is faked.
+ * @hide
+ */
+public final class Gta3xlwifiNetpolicyClient implements AutoCloseable {
+    private static final int CHUNK_WORDS = 4096;
+    private final Object mLock = new Object();
+    private final IGta3xlwifiNetpolicy mRemote;
+    private final IBinder mToken = new Binder();
+    private final IBinder.DeathRecipient mDeath = this::binderDied;
+    private boolean mLinked;
+    private boolean mDead;
+    private boolean mClosed;
+    private boolean mUncertain = true;
+    private long mSession;
+    private final AtomicBoolean mStatsInvalidated = new AtomicBoolean();
+
+    /** Ten explicit immutable sections; empty sections still have declared zero counts. */
+    public static final class Frame {
+        private static final int[] WIDTH = {1, 1, 2, 2, 2, 4, 6, 8, 8, 1};
+        private static final int[] LIMIT = {
+            65536, 65536, 131072, 24, 480000, 80000, 600, 8000, 8000, 1000
+        };
+        private final int[][] mWords;
+        private final int[] mCounts;
+        private final int mRuntimeFlags;
+        private final boolean mLoopbackPermission;
+        private final boolean mUidMigration;
+        private final boolean mDataSaver;
+
+        public Frame(int[][] sections, int runtimeFlags, boolean loopbackPermission,
+                boolean uidMigration, boolean dataSaver) {
+            Objects.requireNonNull(sections);
+            if (sections.length != 10 || (runtimeFlags & ~7) != 0 || !uidMigration) {
+                throw new IllegalArgumentException("Unsupported complete policy schema or mode");
+            }
+            mWords = new int[10][];
+            mCounts = new int[10];
+            long total = 0;
+            for (int i = 0; i < 10; ++i) {
+                int[] words = Objects.requireNonNull(sections[i]);
+                if (words.length > LIMIT[i] || words.length % WIDTH[i] != 0) {
+                    throw new IllegalArgumentException("Invalid section length: " + i);
+                }
+                mWords[i] = words.clone();
+                mCounts[i] = words.length;
+                total += words.length;
+            }
+            if (total > 1000000 || mCounts[3] != 24) {
+                throw new IllegalArgumentException("Incomplete chain image or oversized frame");
+            }
+            mRuntimeFlags = runtimeFlags;
+            mLoopbackPermission = loopbackPermission;
+            mUidMigration = uidMigration;
+            mDataSaver = dataSaver;
+        }
+    }
+
+    /** Lookup only. Call start separately while retaining this client for recovery/close. */
+    public static Gta3xlwifiNetpolicyClient lookup(INetd netd) throws RemoteException {
+        IOemNetd oem = IOemNetd.Stub.asInterface(Objects.requireNonNull(netd).getOemNetd());
+        if (oem == null) throw new IllegalStateException("Missing OEM netd transport");
+        return new Gta3xlwifiNetpolicyClient(
+                Objects.requireNonNull(oem.getGta3xlwifiNetpolicy()));
+    }
+
+    public Gta3xlwifiNetpolicyClient(IGta3xlwifiNetpolicy remote) {
+        mRemote = Objects.requireNonNull(remote);
+    }
+
+    /** Idempotent token handshake only; a lost open reply can retry the same token. */
+    public void start() throws RemoteException {
+        synchronized (mLock) {
+            requireLive();
+            if (mSession != 0) return;
+            if (!mLinked) {
+                mRemote.asBinder().linkToDeath(mDeath, 0);
+                mLinked = true;
+            }
+            long session = mRemote.openSession(mToken, 1);
+            if (session <= 0) throw new IllegalStateException("Invalid policy session");
+            mSession = session;
+        }
+    }
+
+    /** Capture before taking the NetworkStatsFactory persistent-data lock. */
+    public Gta3xlwifiStatsAccess statsAccess() {
+        synchronized (mLock) {
+            requireLive();
+            if (mSession == 0) throw new IllegalStateException("Policy session not started");
+            return new Gta3xlwifiStatsAccess(mRemote, mSession, mToken, mStatsInvalidated);
+        }
+    }
+
+    /**
+     * Explicit complete, freshly collected state. No operation is automatically
+     * retried after an exception, including commit. The next call must supply a
+     * fresh complete snapshot; never infer a successful commit from connection.
+     */
+    public long publishCompleteSnapshot(Frame frame) throws RemoteException {
+        Objects.requireNonNull(frame);
+        synchronized (mLock) {
+            requireLive();
+            if (mSession == 0) throw new IllegalStateException("Policy session not started");
+            try {
+                long previous = mRemote.readGeneration(mSession);
+                if (previous < 0) throw new IllegalStateException("Invalid policy generation");
+                // Explicitly discard any partial prior transfer before starting a NEW
+                // full image. This is not retrying an uncertain kernel transaction.
+                mRemote.abandonFrame(mSession);
+                mRemote.beginFrame(mSession, previous, frame.mCounts.clone(),
+                        frame.mRuntimeFlags, frame.mLoopbackPermission,
+                        frame.mUidMigration, frame.mDataSaver);
+                for (int section = 0; section < frame.mWords.length; ++section) {
+                    int[] words = frame.mWords[section];
+                    for (int offset = 0; offset < words.length; offset += CHUNK_WORDS) {
+                        mRemote.appendFrame(mSession, section, offset,
+                                Arrays.copyOfRange(words, offset,
+                                        Math.min(offset + CHUNK_WORDS, words.length)));
+                    }
+                }
+                long generation = mRemote.commitFrame(mSession);
+                if (generation <= previous) {
+                    throw new IllegalStateException("Non-advancing policy generation");
+                }
+                mUncertain = false;
+                return generation;
+            } catch (RemoteException | RuntimeException failure) {
+                mUncertain = true;
+                // A failed revocation must not intentionally leave an older grant
+                // published. Retire the token through real native HOLD. If Binder
+                // is unavailable, retain the token/link for explicit cleanup retry;
+                // daemon death also closes its lease. Never retry the commit here.
+                try {
+                    abortCurrentSession();
+                } catch (RemoteException | RuntimeException retirementFailure) {
+                    failure.addSuppressed(retirementFailure);
+                }
+                throw failure;
+            }
+        }
+    }
+
+    /** Actual current owner generation for committed-state queries. */
+    public long generation() throws RemoteException {
+        synchronized (mLock) {
+            requireLive();
+            if (mSession == 0) throw new IllegalStateException("Policy session not started");
+            return mRemote.readGeneration(mSession);
+        }
+    }
+
+    public boolean needsCompleteResnapshot() {
+        synchronized (mLock) { return mUncertain || mDead || mSession == 0 || mStatsInvalidated.get(); }
+    }
+
+    private void requireLive() {
+        if (mDead || mClosed || mStatsInvalidated.get()) throw new IllegalStateException("Policy transport is closed");
+    }
+
+    private void binderDied() {
+        synchronized (mLock) {
+            mDead = true;
+            mUncertain = true;
+            mSession = 0;
+        }
+    }
+
+    /** Terminal uncertainty only; ordinary AutoCloseable.close remains nonfatal. */
+    public void abortCurrentSession() throws RemoteException {
+        synchronized(mLock) {
+            mStatsInvalidated.set(true);
+            Exception failure=null;
+            boolean mayClose=true;
+            if(!mDead&&mLinked&&mSession>0) {
+                try { mRemote.abortSession(mSession,mToken); }
+                catch(ServiceSpecificException stale) {
+                    if(stale.errorCode==ESTALE)mayClose=false;
+                    failure=stale;
+                }
+                catch(RemoteException|RuntimeException error) { failure=error; }
+            }
+            try {
+                if(mayClose)close();
+                else {
+                    // An exact stale-session rejection must not fall through to
+                    // token-only close and withdraw a newer reused-token owner.
+                    mClosed=true;mUncertain=true;mSession=0;
+                    if(mLinked)mRemote.asBinder().unlinkToDeath(mDeath,0);
+                    mLinked=false;
+                }
+            }
+            catch(RemoteException|RuntimeException error) {
+                if(failure==null)failure=error;else failure.addSuppressed(error);
+            }
+            if(failure instanceof RemoteException)throw (RemoteException)failure;
+            if(failure instanceof RuntimeException)throw (RuntimeException)failure;
+        }
+    }
+
+    /** Explicit token retirement also works if the initial open reply was lost. */
+    @Override
+    public void close() throws RemoteException {
+        synchronized (mLock) {
+            if (mClosed && !mLinked) return;
+            mClosed = true;
+            mStatsInvalidated.set(true);
+            mSession = 0;
+            mUncertain = true;
+            try {
+                if (!mDead && mLinked) mRemote.closeSession(mToken);
+            } catch (ServiceSpecificException failure) {
+                // An interrupted successful close is safe to retire explicitly.
+                // A different/new token can never be closed by this request.
+                if (failure.errorCode != ESTALE) throw failure;
+            }
+            // On any other failure, retain the token/death link for an explicit
+            // close retry. Publication stays forbidden once closing has begun.
+            if (mLinked) mRemote.asBinder().unlinkToDeath(mDeath, 0);
+            mLinked = false;
+        }
+    }
+}
diff --git a/service/src/com/android/server/Gta3xlwifiPermissionCollector.java b/service/src/com/android/server/Gta3xlwifiPermissionCollector.java
new file mode 100644
index 0000000000000000000000000000000000000000..8f4e2d45100ac291a70efd66361077a969512625
--- /dev/null
+++ b/service/src/com/android/server/Gta3xlwifiPermissionCollector.java
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server;
+
+import android.os.Process;
+import android.util.SparseIntArray;
+import com.android.modules.utils.build.SdkLevel;
+import com.android.server.permission.PermissionBpfMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.TreeMap;
+import java.util.TreeSet;
+
+/**
+ * Ordered raw permission consumer, not a networking readiness indicator. The
+ * caller supplies its sole policy-cache lock and an actual owner publication/
+ * invalidation sink. No PackageManager/UserManager call is made under this lock.
+ * @hide
+ */
+public final class Gta3xlwifiPermissionCollector implements PermissionBpfMap {
+    private static final int USER_RANGE = 100000;
+    private static final int RAW_MASK = 1023;
+    private static final int MAX_ENTRIES = 65536;
+    private final Object mLock;
+    private final Sink mSink;
+    private Data mData;
+    private Snapshot mSnapshot;
+
+    /** Backend must use the SAME lock for all other policy state and publication. */
+    public interface Sink {
+        void accept(Snapshot completePermissions);
+        /** Withdraw actual owner publication/HOLD; must not register observers here. */
+        void invalidate(Throwable cause);
+    }
+
+    /** Immutable raw input; INTERNET-only remains an observed raw4, not absence. */
+    public static final class Snapshot {
+        private final int[] mUsers;
+        private final int[] mKnown;
+        private final int[] mRaw;
+        private Snapshot(Data data) {
+            mUsers = data.users.stream().mapToInt(Integer::intValue).toArray();
+            mKnown = data.known.stream().mapToInt(Integer::intValue).toArray();
+            mRaw = new int[data.raw.size() * 2];
+            int i = 0;
+            for (Map.Entry<Integer, Integer> entry : data.raw.entrySet()) {
+                mRaw[i++] = entry.getKey();
+                mRaw[i++] = entry.getValue();
+            }
+        }
+        public int[] users() { return mUsers.clone(); }
+        public int[] knownUids() { return mKnown.clone(); }
+        public int[] rawPermissionWords() { return mRaw.clone(); }
+    }
+
+    private static final class Data {
+        final TreeSet<Integer> users = new TreeSet<>();
+        final TreeSet<Integer> known = new TreeSet<>();
+        final TreeMap<Integer, Integer> raw = new TreeMap<>();
+        Data() {}
+        Data(Data source) {
+            users.addAll(source.users);
+            known.addAll(source.known);
+            raw.putAll(source.raw);
+        }
+    }
+
+    public Gta3xlwifiPermissionCollector(Object sharedPolicyLock, Sink sink) {
+        mLock = Objects.requireNonNull(sharedPolicyLock);
+        mSink = Objects.requireNonNull(sink);
+    }
+
+    private static boolean hasSdkSandbox(int uid) {
+        return SdkLevel.isAtLeastT() && Process.isApplicationUid(uid);
+    }
+
+    private static void requireUid(Data data, int uid) {
+        if (uid < 0 || !data.users.contains(uid / USER_RANGE)) {
+            throw new IllegalArgumentException("UID outside complete user frame: " + uid);
+        }
+    }
+
+    private static void known(Data data, int uid) {
+        requireUid(data, uid);
+        data.known.add(uid);
+        if (hasSdkSandbox(uid)) data.known.add(Process.toSdkSandboxUid(uid));
+    }
+
+    private static void observed(TreeMap<Integer, Integer> rows, int uid, int raw) {
+        Integer previous = rows.putIfAbsent(uid, raw);
+        if (previous != null && previous != raw) {
+            throw new IllegalArgumentException("Conflicting SDK permission projection: " + uid);
+        }
+    }
+
+    private static void mergeRaw(Data data, SparseIntArray values) {
+        Objects.requireNonNull(values);
+        if (values.size() > MAX_ENTRIES) throw new IllegalArgumentException("Oversized raw frame");
+        // Validate the entire callback projection independently before replacing
+        // any old rows. A live revocation must replace, not conflict with, a grant.
+        TreeMap<Integer, Integer> projected = new TreeMap<>();
+        for (int i = 0; i < values.size(); ++i) {
+            int uid = values.keyAt(i);
+            int raw = values.valueAt(i);
+            requireUid(data, uid);
+            if ((raw & ~RAW_MASK) != 0) {
+                throw new IllegalArgumentException("Unknown raw permission bits");
+            }
+            observed(projected, uid, raw);
+            if (hasSdkSandbox(uid)) observed(projected, Process.toSdkSandboxUid(uid), raw);
+        }
+        data.raw.putAll(projected);
+    }
+
+    private static void validate(Data data) {
+        if (!data.users.contains(0)) throw new IllegalArgumentException("Missing system user");
+        if (data.users.size() > MAX_ENTRIES || data.known.size() > MAX_ENTRIES
+                || data.raw.size() > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Permission frame exceeds native bounds");
+        }
+        for (int user : data.users) {
+            if (user < 0 || user > (Integer.MAX_VALUE - 1000) / USER_RANGE) {
+                throw new IllegalArgumentException("Invalid user");
+            }
+            for (int appId : new int[] {0, 1000}) {
+                Integer raw = data.raw.get(user * USER_RANGE + appId);
+                if (raw == null || raw != RAW_MASK) {
+                    throw new IllegalArgumentException("Missing observed full core permissions");
+                }
+            }
+        }
+    }
+
+    private void accept(Data next) {
+        validate(next);
+        Snapshot snapshot = new Snapshot(next);
+        mSink.accept(snapshot); // May buffer while OTHER policy inputs remain held.
+        mData = next;
+        mSnapshot = snapshot; // Permission input only, never global Ready.
+    }
+
+    private void invalidated(Throwable failure) {
+        mData = null;
+        mSnapshot = null;
+        try {
+            mSink.invalidate(failure);
+        } catch (RuntimeException | Error stopFailure) {
+            if (stopFailure != failure) failure.addSuppressed(stopFailure);
+        }
+    }
+
+    @Override
+    public void setInitialUidPermissions(int[] userIds, int[] knownPackageUids,
+            SparseIntArray rawPermissionBits) {
+        synchronized (mLock) {
+            try {
+                Objects.requireNonNull(userIds);
+                Objects.requireNonNull(knownPackageUids);
+                if (userIds.length > MAX_ENTRIES || knownPackageUids.length > MAX_ENTRIES) {
+                    throw new IllegalArgumentException("Oversized identity frame");
+                }
+                Data next = new Data();
+                for (int user : userIds) {
+                    if (user < 0 || user > (Integer.MAX_VALUE - 1000) / USER_RANGE
+                            || !next.users.add(user)) {
+                        throw new IllegalArgumentException("Invalid or duplicate user");
+                    }
+                }
+                for (int uid : Objects.requireNonNull(knownPackageUids)) known(next, uid);
+                mergeRaw(next, rawPermissionBits);
+                accept(next);
+            } catch (RuntimeException | Error failure) {
+                invalidated(failure);
+                throw failure;
+            }
+        }
+    }
+
+    @Override
+    public void setUidsPermissionBits(SparseIntArray rawPermissionBits) {
+        synchronized (mLock) {
+            try {
+                if (mData == null) throw new IllegalStateException("Complete metadata required");
+                Data next = new Data(mData);
+                mergeRaw(next, rawPermissionBits);
+                accept(next);
+            } catch (RuntimeException | Error failure) {
+                invalidated(failure);
+                throw failure;
+            }
+        }
+    }
+
+    @Override
+    public void removeAppId(int appId) {
+        synchronized (mLock) {
+            try {
+                if (mData == null) throw new IllegalStateException("Complete metadata required");
+                if (appId < 0 || appId >= USER_RANGE) {
+                    throw new IllegalArgumentException("Invalid appId");
+                }
+                Data next = new Data(mData);
+                int sandbox = hasSdkSandbox(appId) ? Process.toSdkSandboxUid(appId) : -1;
+                next.known.removeIf(uid -> uid % USER_RANGE == appId
+                        || uid % USER_RANGE == sandbox);
+                next.raw.keySet().removeIf(uid -> uid % USER_RANGE == appId
+                        || uid % USER_RANGE == sandbox);
+                accept(next);
+            } catch (RuntimeException | Error failure) {
+                invalidated(failure);
+                throw failure;
+            }
+        }
+    }
+
+    @Override
+    public void removeUser(int userId) {
+        synchronized (mLock) {
+            try {
+                if (mData == null) throw new IllegalStateException("Complete metadata required");
+                if (userId < 0) throw new IllegalArgumentException("Invalid user");
+                Data next = new Data(mData);
+                next.users.remove(userId);
+                next.known.removeIf(uid -> uid / USER_RANGE == userId);
+                next.raw.keySet().removeIf(uid -> uid / USER_RANGE == userId);
+                accept(next);
+            } catch (RuntimeException | Error failure) {
+                invalidated(failure);
+                throw failure;
+            }
+        }
+    }
+
+    public Snapshot snapshot() {
+        synchronized (mLock) {
+            if (mSnapshot == null) throw new IllegalStateException("Complete metadata required");
+            return mSnapshot;
+        }
+    }
+}
diff --git a/service/src/com/android/server/Gta3xlwifiStatsAccess.java b/service/src/com/android/server/Gta3xlwifiStatsAccess.java
new file mode 100644
index 0000000000000000000000000000000000000000..bde580e6fd5283c0f816da0832e17debcee58825
--- /dev/null
+++ b/service/src/com/android/server/Gta3xlwifiStatsAccess.java
@@ -0,0 +1,399 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server;
+
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+import static android.system.OsConstants.EAGAIN;
+import static android.system.OsConstants.ESTALE;
+import static android.system.OsConstants.EBUSY;
+import com.android.internal.net.IGta3xlwifiNetpolicy;
+import java.io.IOException;
+import java.util.Arrays;
+import java.nio.charset.StandardCharsets;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Real stats RPCs on an existing policy session. Capture this handle before
+ * NetworkStatsFactory's data lock: calls never acquire the Java policy/client
+ * locks. Native session/owner checks still apply to every operation. No read
+ * consumes data; SWAP is never retried, and ACK requires caller persistence and
+ * boot/epoch deduplication. This is not a complete poll/persistence pipeline.
+ * @hide
+ */
+public final class Gta3xlwifiStatsAccess {
+    private final IGta3xlwifiNetpolicy mRemote;
+    private final long mSession;
+    private final IBinder mToken;
+    private final AtomicBoolean mInvalidated;
+
+    Gta3xlwifiStatsAccess(IGta3xlwifiNetpolicy remote, long session, IBinder token,
+            AtomicBoolean invalidated) {
+        mRemote = Objects.requireNonNull(remote);
+        mToken = Objects.requireNonNull(token);
+        mInvalidated = Objects.requireNonNull(invalidated);
+        if (session <= 0) throw new IllegalArgumentException("Invalid stats session");
+        mSession = session;
+    }
+
+    /** Exact unsigned64 bits are retained. Loss/sequence are not invented. */
+    public static final class Snapshot {
+        public final int kind;
+        public final int bank;
+        public final long epoch;
+        public final long sequence;
+        public final long lostUpdates;
+        public final int count;
+        public final int width;
+        private final long[] mRows;
+
+        private Snapshot(int kind, int bank, long epoch, long sequence, long loss,
+                int count, int width, long[] rows) {
+            this.kind = kind;
+            this.bank = bank;
+            this.epoch = epoch;
+            this.sequence = sequence;
+            lostUpdates = loss;
+            this.count = count;
+            this.width = width;
+            mRows = rows.clone();
+        }
+
+        public long[] row(int index) {
+            if (index < 0 || index >= count) throw new IndexOutOfBoundsException(index);
+            return Arrays.copyOfRange(mRows, index * width, (index + 1) * width);
+        }
+
+        public String interfaceName(int index) {
+            if (kind != 4) throw new IllegalStateException("Not an interface-name table");
+            return decodeName(row(index));
+        }
+
+        /** Consumers must not describe counters with real loss as complete. */
+        public void requireLossless() throws IOException {
