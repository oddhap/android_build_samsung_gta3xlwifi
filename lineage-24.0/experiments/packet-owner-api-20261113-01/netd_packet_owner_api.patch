+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::packetAccountingAvailableLocked() const {
+  if (!mStarted || !mCommit) return -EAGAIN;
+  return mAccountingEnabled ? 0 : -EOPNOTSUPP;
+}
+int SocketPolicyProjection::readPacketState(NetpolicyLease::PacketState* output) {
+  if (!output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readPacketState(output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::readFrozenPacketStats(
+    uint32_t bank, uint64_t epoch, NetpolicyLease::PacketSnapshot* output) {
+  if (!output || bank > 1 || !epoch) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readFrozenPacketStats(bank, epoch, output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::readAppStats(NetpolicyLease::AppSnapshot* output) {
+  if (!output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.readAppStats(output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::swapPacketStats(
+    uint32_t bank, uint64_t epoch, NetpolicyLease::BankTransition* output) {
+  if (!output || bank > 1 || !epoch || epoch == UINT64_MAX) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.swapPacketStats(bank, epoch, output);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::acknowledgePacketStats(uint32_t bank, uint64_t epoch) {
+  if (bank > 1 || !epoch) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.acknowledgePacketStats(bank, epoch);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::setPacketCounterset(int32_t uid, uint32_t counterset) {
+  if (uid < 0 || counterset > 1) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.setPacketCounterset(static_cast<uint32_t>(uid), counterset);
+  return result ? quarantine(result) : 0;
+}
+int SocketPolicyProjection::deleteUidPacketStats(int32_t uid) {
+  if (uid < 0) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  result = mLease.deleteUidPacketStats(static_cast<uint32_t>(uid));
+  return result ? quarantine(result) : 0;
+}
