+#include <vector>
+namespace android::net::gta3xlwifi {
+// Explicit private factory bootstrap, never a live-rule migration/flush. Caller
+// owns the complete transaction mutex and installs global held-gate guards first.
+// Only EMPTY or exact known ordered prefixes are accepted. No FD/Ready/release.
+class AccountingRoots final {
+ public:
+  using Program=std::vector<std::string>;
+  AccountingRoots(IptablesRestoreInterface& kernel,NetpolicyLease& lease)
+      :mKernel(kernel),mLease(lease){}
+  static bool validProgram(const Program& program);
+  int prepare(const Program& program);
+  // After startup, metered bridges/quotas legitimately change filter chains.
+  // Verify only the immutable raw/mangle producers before policy publication.
+  int verifyProducers();
+ private:
+  using Rules=std::map<std::string,std::vector<std::string>>;
+  struct Table {const char* name;Rules source,canonical;};
+  struct Inventory {Rules owned;std::set<std::string> users;std::vector<std::string> foreign;};
+  static const Program& approvedProgram();
+  static std::array<Table,3> tables();
+  int inventory(IptablesTarget family,const Table& table,Inventory* output);
+  int held();
+  int fail(int error);
+  IptablesRestoreInterface& mKernel;
+  NetpolicyLease& mLease;
+  std::mutex mMutex;
+};
+} // namespace android::net::gta3xlwifi
