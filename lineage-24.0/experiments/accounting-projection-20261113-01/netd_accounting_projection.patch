+int SocketPolicyProjection::startWithAccounting(
+    const AccountingRoots::Program& program, HookMode mode) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (mStarted) return -EALREADY;
+  if (!AccountingRoots::validProgram(program)) return -EINVAL;
+  int r = mLease.start();
+  if (r) return r;
+  r = mLease.requirePolicyPrimitives();
+  if (!r) r = mLease.requireIfaceAccountingPrimitives();
+  if (!r) r = prepareHooks(mode);
+  if (!r) r = mAccounting.prepare(program);
+  if (!r) r = mSocket.prepare();
+  if (!r) r = mMeter.prepare();
+  if (!r) r = mAccounting.verifyProducers();
+  if (!r) r = verifyHooks();
+  if (r) return quarantine(r);
+  mAccountingEnabled = true;
+  mStarted = true;
+  return 0;  // Held, actual interface producers verified, no policy/Ready yet.
 }
