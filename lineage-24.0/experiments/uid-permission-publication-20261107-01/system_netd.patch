+int UidPolicyTransaction::setUidPermission(int32_t uid, uint32_t mask) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (!mPolicy || !mPermissions) return -EAGAIN;
+    UidPermissionState permissions = *mPermissions;
+    const int result = permissions.set(uid, mask);
+    return result ? result : applyCombinedLocked(*mPolicy, std::move(permissions));
+}
+int UidPolicyTransaction::getUidPermission(int32_t uid, uint32_t* output) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return mPermissions ? mPermissions->get(uid, output) : -EAGAIN;
+}
