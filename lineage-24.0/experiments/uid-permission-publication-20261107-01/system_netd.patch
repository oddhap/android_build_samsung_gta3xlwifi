+int UidPolicyTransaction::applyCombinedLocked(UidPolicy next, UidPermissionState permissions) {
+    if (!mStarted) return -ENOTCONN;
+    UidChainProgram::Image program;
+    int result = compile(next, &program);
+    std::vector<UidPermissionState::Entry> values;
+    if (!result) result = permissions.snapshot(&values);
+    if (!result && values.size() > 65536) result = -E2BIG;
+    if (result) return result;  // Local invalid inputs do not touch committed state.
+    std::vector<NetpolicyLease::PermissionEntry> wire;
+    wire.reserve(values.size());
+    for (const auto& e : values) wire.push_back({e.uid, e.permissions});
+    result = mBackend.replaceWithPermissions(program, program, wire);
+    if (result) {
+        stopLocked();  // Withdraw BOTH values on any kernel/ack uncertainty.
+        return result;
+    }
+    // Readers and all mutations share this mutex. Neither value is visible
+    // until the complete real kernel transaction and release have succeeded.
+    mPolicy = std::move(next);
+    mPermissions = std::move(permissions);
+    return 0;
