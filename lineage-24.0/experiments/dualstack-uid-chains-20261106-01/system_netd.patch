+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiCheckedUidChains.h"
+#include "Gta3xlwifiNetpolicyLease.h"
+
+namespace android::net::gta3xlwifi {
+// Bounded two-family update of EXISTING owned UID chains. The complete backend
+// must be the sole rule owner and hold its firewall transaction lock. This does
+// not install hooks, implement full Android packet semantics or expose readiness.
+class DualStackUidChains final {
+public:
+    using Image = std::vector<CheckedUidChains::Chain>;
+    explicit DualStackUidChains(IptablesRestoreInterface& kernel)
+        : mKernel(kernel), mChains(kernel) {}
+    int start();  // Acquire a HELD lease; verify first guard/DROP at all six hooks.
+    void stop();
+    // A success permits publication of this UID-chain update only. On error,
+    // publish nothing. EUCLEAN means quarantined: unknown/failed recovery, held
+    // gate and invalid session. A new start never automatically releases it.
+    int replace(const Image& ipv4, const Image& ipv6);
+private:
+    int verifyHooks();
+    int verifyImage(IptablesTarget family, const Image& expected);
+    int quarantine(int error);
+    int restore(const Image& ipv4, const Image& ipv6, int originalError);
+    IptablesRestoreInterface& mKernel;
+    CheckedUidChains mChains;
+    NetpolicyLease mLease;
+    std::mutex mMutex;
+    bool mSession = false;
+    bool mCommitted = false;
+};
+}  // namespace android::net::gta3xlwifi
