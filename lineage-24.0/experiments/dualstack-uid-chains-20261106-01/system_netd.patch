--- /dev/null
+++ b/server/Gta3xlwifiDualStackUidChains.cpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiDualStackUidChains.h"
+#include <cerrno>
+#include <sstream>
+
+namespace android::net::gta3xlwifi {
+namespace {
+std::vector<std::string> names(const DualStackUidChains::Image& image) {
+    std::vector<std::string> result;
+    for (const auto& chain : image) result.push_back(chain.name);
+    return result;
+}
+// -S on one builtin emits its policy then its rules, in actual kernel order.
+// The first rule must unconditionally DROP while our shared match is held.
+bool guarded(const std::string& chain, const std::string& text) {
+    if (text.empty() || text.size() > 1024 * 1024 || text.back() != '\n') return false;
+    for (unsigned char c : text) if ((c < 32 && c != '\n') || c == 127) return false;
+    std::istringstream input(text);
+    std::string line;
+    if (!std::getline(input, line) || (line != "-P " + chain + " ACCEPT" &&
+                                     line != "-P " + chain + " DROP")) return false;
+    if (!std::getline(input, line) ||
+        line != "-A " + chain + " -m gta3xlwifi_guard -j DROP") return false;
+    while (std::getline(input, line)) {
+        if (line.size() > 65536 || line.rfind("-A " + chain + " ", 0) != 0) return false;
+    }
+    return true;
+}
+}  // namespace
+int DualStackUidChains::verifyHooks() {
+    for (const auto family : {V4, V6}) {
+        for (const auto chain : {"INPUT", "FORWARD", "OUTPUT"}) {
+            std::string output;
+            if (mKernel.execute(family, "*filter\n-S " + std::string(chain) + "\nCOMMIT\n",
+                                &output)) return -EREMOTEIO;
+            if (!guarded(chain, output)) return -EPROTO;
+        }
+    }
+    return 0;
+}
+int DualStackUidChains::quarantine(int error) {
+    mLease.stop();  // The real driver rearms and drains on owner close.
+    mSession = mCommitted = false;
+    return error;
+}
+int DualStackUidChains::start() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mSession) return -EALREADY;
+    int result = mLease.start();
+    if (result) return result;
+    result = verifyHooks();
+    if (result) return quarantine(result);
+    mSession = true;
+    mCommitted = false;
+    return 0;  // Still held. This is not backend/network readiness.
+}
+void DualStackUidChains::stop() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    quarantine(0);
+}
+int DualStackUidChains::verifyImage(IptablesTarget family, const Image& expected) {
+    Image actual;
+    int result = mChains.read(family, names(expected), &actual);
+    return result ? result : actual == expected ? 0 : -EREMOTEIO;
+}
+int DualStackUidChains::restore(const Image& ipv4, const Image& ipv6, int originalError) {
+    // Try BOTH families even if the first restoration fails. A failed ack can
+    // follow a committed operation; only final actual readbacks establish it.
+    const int r4 = mChains.replace(V4, ipv4);
+    const int r6 = mChains.replace(V6, ipv6);
+    const int v4 = verifyImage(V4, ipv4);
+    const int v6 = verifyImage(V6, ipv6);
+    const int hooks = verifyHooks();
+    if (r4 || r6 || v4 || v6 || hooks) return quarantine(-EUCLEAN);
+    // Before the first complete commit there is no previously published update
+    // to resume. Keep the lease held rather than opening arbitrary old rules.
+    if (mCommitted && mLease.release()) return quarantine(-EUCLEAN);
+    return originalError;
+}
+int DualStackUidChains::replace(const Image& ipv4, const Image& ipv6) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (!mSession) return -ENOTCONN;
+    int result = mLease.hold();
+    if (result) return quarantine(result);
+    result = verifyHooks();
+    if (result) return quarantine(result);
+    Image before4, before6;
+    result = mChains.read(V4, names(ipv4), &before4);
+    if (!result) result = mChains.read(V6, names(ipv6), &before6);
+    if (result) return quarantine(result);  // No writes without both before-images.
+    result = mChains.replace(V4, ipv4);
+    if (!result) result = mChains.replace(V6, ipv6);
+    if (!result) result = verifyImage(V4, ipv4);
+    if (!result) result = verifyImage(V6, ipv6);
+    if (!result) result = verifyHooks();
+    if (result) return restore(before4, before6, result);
+    if (mLease.release()) return quarantine(-EUCLEAN);
+    mCommitted = true;
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
