+++ b/server/Gta3xlwifiNetpolicyLease.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <mutex>
+
+namespace android::net::gta3xlwifi {
+// Private real-kernel lease transport, not a networking backend or readiness API.
+// The sole backend owner must hold its transaction lock and verify guard/DROP
+// attachments in both families before calling release(). No FD is exposed.
+class NetpolicyLease final {
+public:
+    NetpolicyLease() = default;
+    ~NetpolicyLease();
+    NetpolicyLease(const NetpolicyLease&) = delete;
+    NetpolicyLease& operator=(const NetpolicyLease&) = delete;
+    int start();
+    int hold();
+    int release();
+    int isHeld(bool* output);
+    void stop();
+private:
+    int commandLocked(unsigned long request, int expected);
+    int stateLocked(bool* output);
+    int changeLocked(unsigned long request, bool held);
+    void closeLocked();
+    std::mutex mMutex;
+    int mFd = -1;
+};
+}  // namespace android::net::gta3xlwifi
diff --git a/server/linux/netfilter/gta3xlwifi_netpolicy.h b/server/linux/netfilter/gta3xlwifi_netpolicy.h
new file mode 100644
--- /dev/null
+++ b/server/linux/netfilter/gta3xlwifi_netpolicy.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_GTA3XLWIFI_NETPOLICY_H
+#define _UAPI_GTA3XLWIFI_NETPOLICY_H
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define GTA3XLWIFI_NETPOLICY_VERSION 1
+#define GTA3XLWIFI_NETPOLICY_ABI     _IO('g', 0x50)
+#define GTA3XLWIFI_NETPOLICY_HOLD    _IO('g', 0x51)
+#define GTA3XLWIFI_NETPOLICY_RELEASE _IO('g', 0x52)
+#define GTA3XLWIFI_NETPOLICY_STATE   _IO('g', 0x53)
+#define GTA3XLWIFI_NETPOLICY_MATCH "gta3xlwifi_guard"
+
+/* No pointers or arguments: identical ioctl numbers on ARM32 and ARM64.
+ * ABI returns VERSION; STATE returns 1 when held, 0 when released.
+ * All other successful commands return 0. Every argument must be zero.
+ * Opening exclusively acquires a closed lease. Owner close/exit closes the
+ * barrier even if forked children still hold the file. This neither installs
+ * rules nor proves complete networking readiness.
+ */
+struct gta3xlwifi_netpolicy_match {
+	__u8 reserved[4];
+};
+#endif
