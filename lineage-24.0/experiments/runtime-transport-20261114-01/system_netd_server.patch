+int NetpolicyLease::runtimeFeaturesLocked() {
+    if(mFd<0)return -ENOTCONN;
+    int result;
+    do{result=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(result<0&&errno==EINTR);
+    if(result<0)return imageErrorLocked(errno?-errno:-EIO);
+    return (result&GTA3XLWIFI_UID_CAP_RUNTIME_POLICY)?0:imageErrorLocked(-EOPNOTSUPP);
+}
+int NetpolicyLease::requireRuntimePolicy() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return runtimeFeaturesLocked();
+}
+int NetpolicyLease::runtimeReadLocked(RuntimeImage* output) {
+    int error=runtimeFeaturesLocked();if(error)return error;
+    gta3xlwifi_runtime_transfer metadata{};int result;
+    do{metadata={};metadata.version=1;result=ioctl(mFd,GTA3XLWIFI_RUNTIME_GET,reinterpret_cast<unsigned long>(&metadata));}
+    while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(metadata.version!=1||metadata.entries||metadata.count>GTA3XLWIFI_RUNTIME_MAX_BLOCKED_UIDS||
+       (metadata.flags&~GTA3XLWIFI_RUNTIME_FLAG_MASK)||(metadata.status&~GTA3XLWIFI_RUNTIME_CONFIGURED)||
+       (!metadata.revision&&(metadata.count||metadata.flags||metadata.status)))return imageErrorLocked(-EPROTO);
+    RuntimeImage next;next.revision=metadata.revision;next.flags=metadata.flags;
+    next.confirmedForLease=metadata.status&GTA3XLWIFI_RUNTIME_CONFIGURED;
+    next.legacyBlockedUids.resize(metadata.count);
+    if(metadata.count){
+        gta3xlwifi_runtime_transfer data{};
+        do{data={};data.version=1;data.count=metadata.count;data.revision=metadata.revision;
+            data.entries=reinterpret_cast<uintptr_t>(next.legacyBlockedUids.data());
+            result=ioctl(mFd,GTA3XLWIFI_RUNTIME_GET,reinterpret_cast<unsigned long>(&data));
+        }while(result<0&&errno==EINTR);
+        if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+        if(data.version!=1||data.count!=metadata.count||data.revision!=metadata.revision||
+           data.flags!=metadata.flags||data.status!=metadata.status||
+           data.entries!=reinterpret_cast<uintptr_t>(next.legacyBlockedUids.data()))return imageErrorLocked(-EPROTO);
+        for(size_t i=0;i<next.legacyBlockedUids.size();++i)
+            if(next.legacyBlockedUids[i]>INT_MAX||(i&&next.legacyBlockedUids[i-1]>=next.legacyBlockedUids[i]))
+                return imageErrorLocked(-EPROTO);
+    }
+    *output=std::move(next);return 0;
+}
+int NetpolicyLease::readRuntimePolicy(RuntimeImage* output) {
+    if(!output)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);
+    return runtimeReadLocked(output);
+}
+int NetpolicyLease::replaceRuntimePolicy(uint64_t expected,uint32_t flags,
+                                         const std::vector<uint32_t>& uids,uint64_t* revision) {
+    if(!revision||(flags&~GTA3XLWIFI_RUNTIME_FLAG_MASK)||uids.size()>GTA3XLWIFI_RUNTIME_MAX_BLOCKED_UIDS)
+        return -EINVAL;
+    for(size_t i=0;i<uids.size();++i)if(uids[i]>INT_MAX||(i&&uids[i-1]>=uids[i]))return -EINVAL;
+    if(expected==UINT64_MAX)return -EOVERFLOW;
+    std::lock_guard<std::mutex> lock(mMutex);
+    int result=runtimeFeaturesLocked();if(result)return result;
+    bool held=false;result=stateLocked(&held);if(result)return result;
+    if(!held)return imageErrorLocked(-EBUSY);
+    gta3xlwifi_runtime_transfer request{};request.version=1;request.flags=flags;
+    request.count=uids.size();request.revision=expected+1;
+    request.entries=uids.empty()?0:reinterpret_cast<uintptr_t>(uids.data());
+    // Exact revision+content SET is idempotently acknowledged by the real
+    // kernel, so EINTR retry differs deliberately from packet-bank SWAP.
+    do{result=ioctl(mFd,GTA3XLWIFI_RUNTIME_SET,reinterpret_cast<unsigned long>(&request));}
+    while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    RuntimeImage after;result=runtimeReadLocked(&after);if(result)return result;
+    if(after.revision!=expected+1||after.flags!=flags||!after.confirmedForLease||after.legacyBlockedUids!=uids)
+        return imageErrorLocked(-EPROTO);
+    *revision=after.revision;return 0;
+}
