+namespace android::net::gta3xlwifi {
+int NetpolicyLease::readIfaceNames(IfaceNamesSnapshot* output) {
+    if(!output)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if(mFd<0)return -ENOTCONN;
+    int features;
+    do{features=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(features<0&&errno==EINTR);
+    if(features<0)return imageErrorLocked(errno?-errno:-EIO);
+    if(!(features&GTA3XLWIFI_UID_CAP_IFACE_NAMES))return imageErrorLocked(-EOPNOTSUPP);
+    std::vector<gta3xlwifi_iface_name_entry> rows(GTA3XLWIFI_IFACE_STATS_MAX);
+    gta3xlwifi_iface_names_transfer value{};
+    int result;
+    do{
+        value={};value.version=GTA3XLWIFI_IFACE_NAMES_VERSION;value.count=rows.size();
+        value.entries=reinterpret_cast<uintptr_t>(rows.data());
+        result=ioctl(mFd,GTA3XLWIFI_IFACE_NAMES_GET,reinterpret_cast<unsigned long>(&value));
+    }while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(value.version!=1||value.count>rows.size()||
+       value.entries!=reinterpret_cast<uintptr_t>(rows.data()))return imageErrorLocked(-EPROTO);
+    IfaceNamesSnapshot next;next.lostUpdates=value.lost_updates;next.sequence=value.update_sequence;
+    for(size_t i=0;i<value.count;++i){
+        const auto&r=rows[i];const size_t length=strnlen(r.name,sizeof(r.name));
+        if(!r.ifindex||r.ifindex>INT_MAX||(i&&rows[i-1].ifindex>=r.ifindex)||
+           !length||length==sizeof(r.name)||(length==1&&r.name[0]=='.')||
+           (length==2&&r.name[0]=='.'&&r.name[1]=='.'))return imageErrorLocked(-EPROTO);
+        for(size_t j=0;j<length;++j){
+            const unsigned char c=r.name[j];
+            // Product interfaces use ASCII. Unsupported bytes fail explicitly,
+            // never become a fabricated replacement-character interface name.
+            if(c<33||c>126||c=='/'||c==':')return imageErrorLocked(-EPROTO);
+        }
+        for(size_t j=length;j<sizeof(r.name);++j)if(r.name[j])return imageErrorLocked(-EPROTO);
+        IfaceName entry{};entry.ifindex=r.ifindex;memcpy(entry.name.data(),r.name,16);
+        next.entries.push_back(entry);
+    }
+    *output=std::move(next);return 0;
+}
+} // namespace android::net::gta3xlwifi
