
; Explicit Android17 owner/scope migration for reviewed vendor context labels.
(typeattribute vendor_samsung_port_restricted_properties)
(typeattributeset vendor_samsung_port_restricted_properties (vendor_bssl_post_prop vendor_camera_prop vendor_config_default_prop vendor_debug_egl_prop vendor_device_prop vendor_display_sf_prop vendor_dolby_prop vendor_dumpstate_config_prop vendor_eden_prop vendor_heimdalld_prop vendor_members_prop vendor_mobicoredaemon_prop vendor_nfc_prop vendor_persist_config_default_prop vendor_persist_sys_default_prop vendor_proxydaemon_prop vendor_radio_prop vendor_rild_prop vendor_ro_config_default_prop vendor_ro_sys_default_prop vendor_sec_camera_prop vendor_sec_cass_prop vendor_sec_vaultkeeper_prop vendor_secureos_prop vendor_sehal_init_prop vendor_sys_default_prop vendor_teegris_prop vendor_tzdaemon_prop vendor_tztsdaemon_prop vendor_wifi_ramdump_prop vendor_wifi_version vendor_wlbtd_prop))
(typeattributeset vendor_property_type (vendor_samsung_port_restricted_properties))
(typeattributeset vendor_restricted_property_type (vendor_samsung_port_restricted_properties))
(typeattribute vendor_samsung_port_noninit_core)
(typeattributeset vendor_samsung_port_noninit_core (and coredomain (not init_30_0)))
(neverallow vendor_samsung_port_noninit_core vendor_samsung_port_restricted_properties (property_service (set)))
