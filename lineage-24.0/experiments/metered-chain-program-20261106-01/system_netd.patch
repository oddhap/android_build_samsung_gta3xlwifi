+++ b/server/Gta3xlwifiMeteredChainProgram.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiUidChainProgram.h"
+namespace android::net::gta3xlwifi {
+// Compile metered deny union, happy/core allow and Data Saver into three owned
+// typed chains. Requires actual raw UID/appId matches, builtin family-default
+// REJECT support and correct parent goto wiring. This is not startup/readiness.
+class MeteredChainProgram {
+public:
+    static int compile(const UidPolicy& policy, UidChainProgram::Image* output);
+};
+}  // namespace android::net::gta3xlwifi
