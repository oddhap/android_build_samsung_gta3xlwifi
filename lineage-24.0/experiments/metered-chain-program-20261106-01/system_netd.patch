diff --git a/server/Gta3xlwifiMeteredChainProgram.cpp b/server/Gta3xlwifiMeteredChainProgram.cpp
new file mode 100644
--- /dev/null
+++ b/server/Gta3xlwifiMeteredChainProgram.cpp
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiMeteredChainProgram.h"
+#include <algorithm>
+#include <cerrno>
+#include <climits>
+#include <iterator>
+#include <utility>
+namespace android::net::gta3xlwifi {
+namespace {
+using C = CheckedUidChains;
+void appendMembers(C::Chain* chain, const std::vector<int32_t>& members, C::Verdict verdict) {
+    for (int32_t member : members) {
+        const auto uid = static_cast<uint32_t>(member);
+        if (!chain->rules.empty() && chain->rules.back().selector == C::Selector::RawUid &&
+            chain->rules.back().uid && chain->rules.back().uid->last < INT_MAX &&
+            chain->rules.back().uid->last + 1 == uid) {
+            chain->rules.back().uid->last = uid;
+        } else chain->rules.push_back({C::UidRange{uid, uid}, verdict, C::Selector::RawUid});
+    }
+}
+}  // namespace
+int MeteredChainProgram::compile(const UidPolicy& policy, UidChainProgram::Image* output) {
+    if (!output) return -EINVAL;
+    std::vector<int32_t> happy, user, admin, denied;
+    int result = policy.matchingUids(10, &happy);
+    if (!result) result = policy.matchingUids(11, &user);
+    if (!result) result = policy.matchingUids(12, &admin);
+    if (result) return result;
+    std::set_union(user.begin(), user.end(), admin.begin(), admin.end(), std::back_inserter(denied));
+    C::Chain deny{"g24_meter_deny", {}};
+    appendMembers(&deny, denied, C::Verdict::Reject);
+    deny.rules.push_back({std::nullopt, C::Verdict::Return});
+    C::Chain allow{"g24_meter_allow", {{C::UidRange{0, 9999}, C::Verdict::Return, C::Selector::RawAppId}}};
+    appendMembers(&allow, happy, C::Verdict::Return);
+    allow.rules.push_back({std::nullopt, C::Verdict::DataSaverGoto});
+    C::Chain saver{"g24_data_saver", {{std::nullopt,
+        policy.dataSaver() ? C::Verdict::Reject : C::Verdict::Return}}};
+    UidChainProgram::Image next{std::move(deny), std::move(allow), std::move(saver)};
+    result = C::validateImage(next);
+    if (result) return result;
+    *output = std::move(next);
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
