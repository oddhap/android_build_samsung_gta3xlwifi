+int NetpolicyLease::packetStorageLocked() {
+    if(mFd<0)return -ENOTCONN;
+    int result;do{result=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(result<0&&errno==EINTR);
+    if(result<0)return imageErrorLocked(errno?-errno:-EIO);
+    return (result&GTA3XLWIFI_UID_CAP_PACKET_STATS_STORE)?0:imageErrorLocked(-EOPNOTSUPP);
+}
+int NetpolicyLease::packetCommandLocked(unsigned long request,void* arg,bool retry) {
+    int result;
+    do{result=ioctl(mFd,request,reinterpret_cast<unsigned long>(arg));}
+    while(retry&&result<0&&errno==EINTR);
+    return result?imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO):0;
+}
+int NetpolicyLease::readPacketState(PacketState* output) {
+    if(!output)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    gta3xlwifi_packet_stats_state value{};
+    int result;
+    do{value={};result=ioctl(mFd,GTA3XLWIFI_STATS_GET_STATE,reinterpret_cast<unsigned long>(&value));}
+    while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(value.version!=1||value.reserved||value.active_bank>1||!value.active_epoch||
+       value.pending_mask>3||(value.pending_mask&(1U<<value.active_bank))||
+       value.bank_epoch[value.active_bank]!=value.active_epoch||
+       value.app_count>GTA3XLWIFI_APP_STATS_MAX||value.counterset_count>GTA3XLWIFI_COUNTERSET_MAX)
+        return imageErrorLocked(-EPROTO);
+    PacketState next;next.activeBank=value.active_bank;next.activeEpoch=value.active_epoch;
+    next.pendingMask=value.pending_mask;next.appCount=value.app_count;next.countersetCount=value.counterset_count;
+    next.appLost=value.app_lost;next.totalStatsLost=value.total_stats_lost;
+    for(unsigned i=0;i<2;++i){
+        if(value.bank_count[i]>GTA3XLWIFI_PACKET_STATS_MAX||value.bank_epoch[i]>value.active_epoch||
+           ((value.pending_mask&(1U<<i))&&!value.bank_epoch[i]))return imageErrorLocked(-EPROTO);
+        next.bankCount[i]=value.bank_count[i];next.bankEpoch[i]=value.bank_epoch[i];next.bankLost[i]=value.bank_lost[i];
+    }
+    *output=next;return 0;
+}
+int NetpolicyLease::readFrozenPacketStats(uint32_t bank,uint64_t epoch,PacketSnapshot* output) {
+    if(!output||bank>1||!epoch)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    std::vector<gta3xlwifi_packet_stats_entry> rows(GTA3XLWIFI_PACKET_STATS_MAX);
+    gta3xlwifi_packet_stats_transfer value{};int result;
+    do{value={};value.version=1;value.kind=bank;value.epoch=epoch;value.count=rows.size();
+        value.entries=reinterpret_cast<uintptr_t>(rows.data());
+        result=ioctl(mFd,GTA3XLWIFI_STATS_READ,reinterpret_cast<unsigned long>(&value));
+    }while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(value.version!=1||value.kind!=bank||value.epoch!=epoch||value.reserved||
+       value.count>rows.size()||value.entries!=reinterpret_cast<uintptr_t>(rows.data()))return imageErrorLocked(-EPROTO);
+    PacketSnapshot next;next.epoch=epoch;next.lostUpdates=value.lost_updates;next.sequence=value.sequence;
+    next.entries.reserve(value.count);
+    for(size_t i=0;i<value.count;++i){const auto&r=rows[i];const auto&k=r.key;
+        auto key=[](const auto&x){return std::tie(x.uid,x.tag,x.counterset,x.ifindex);};
+        if(k.counterset>1||(i&&!(key(rows[i-1].key)<key(k))))return imageErrorLocked(-EPROTO);
+        next.entries.push_back({k.uid,k.tag,k.counterset,k.ifindex,r.rx_packets,r.rx_bytes,r.tx_packets,r.tx_bytes});
+    }
+    *output=std::move(next);return 0;
+}
+int NetpolicyLease::readAppStats(AppSnapshot* output) {
+    if(!output)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    std::vector<gta3xlwifi_app_stats_entry> rows(GTA3XLWIFI_APP_STATS_MAX);
+    gta3xlwifi_packet_stats_transfer value{};int result;
+    do{value={};value.version=1;value.kind=GTA3XLWIFI_STATS_APP_UID;value.count=rows.size();
+        value.entries=reinterpret_cast<uintptr_t>(rows.data());
+        result=ioctl(mFd,GTA3XLWIFI_STATS_READ,reinterpret_cast<unsigned long>(&value));
+    }while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(value.version!=1||value.kind!=GTA3XLWIFI_STATS_APP_UID||value.epoch||value.reserved||
+       value.count>rows.size()||value.entries!=reinterpret_cast<uintptr_t>(rows.data()))return imageErrorLocked(-EPROTO);
+    AppSnapshot next;next.lostUpdates=value.lost_updates;next.sequence=value.sequence;next.entries.reserve(value.count);
+    for(size_t i=0;i<value.count;++i){const auto&r=rows[i];
+        if(r.reserved||(i&&rows[i-1].uid>=r.uid))return imageErrorLocked(-EPROTO);
+        next.entries.push_back({r.uid,r.rx_packets,r.rx_bytes,r.tx_packets,r.tx_bytes});
+    }
+    *output=std::move(next);return 0;
+}
+int NetpolicyLease::swapPacketStats(uint32_t bank,uint64_t epoch,BankTransition* output) {
+    if(!output||bank>1||!epoch||epoch==UINT64_MAX)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    gta3xlwifi_packet_stats_swap value{1,bank,epoch,0,0,0};
+    error=packetCommandLocked(GTA3XLWIFI_STATS_SWAP,&value,false);if(error)return error;
+    if(value.version!=1||value.reserved||value.active_bank!=1U-bank||value.active_epoch!=epoch+1||
+       value.inactive_bank!=bank||value.inactive_epoch!=epoch)return imageErrorLocked(-EPROTO);
+    *output={value.active_bank,value.inactive_bank,value.active_epoch,value.inactive_epoch};return 0;
+}
+int NetpolicyLease::acknowledgePacketStats(uint32_t bank,uint64_t epoch) {
+    if(bank>1||!epoch)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    gta3xlwifi_packet_stats_ack value{1,bank,epoch,0};
+    return packetCommandLocked(GTA3XLWIFI_STATS_ACK,&value,true);
+}
+int NetpolicyLease::setPacketCounterset(uint32_t uid,uint32_t counterset) {
+    if(counterset>1)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    gta3xlwifi_packet_stats_edit value{1,GTA3XLWIFI_STATS_SET_COUNTERSET,uid,0,counterset,0};
+    return packetCommandLocked(GTA3XLWIFI_STATS_EDIT,&value,false);
+}
+int NetpolicyLease::deleteUidPacketStats(uint32_t uid) {
+    std::lock_guard<std::mutex> lock(mMutex);int error=packetStorageLocked();if(error)return error;
+    gta3xlwifi_packet_stats_edit value{1,GTA3XLWIFI_STATS_DELETE_UID,uid,0,0,0};
+    return packetCommandLocked(GTA3XLWIFI_STATS_EDIT,&value,false);
+}
+} // namespace android::net::gta3xlwifi
