+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiUidPolicy.h"
+#include "Gta3xlwifiCheckedUidChains.h"
+namespace android::net::gta3xlwifi {
+// Compile ONLY the nine ordinary enabled/membership chains into typed rules.
+// The real owner must supply the separately verified core-appId/packet/hook
+// dispatcher. This does not implement metered, VPN, LNA, quota or readiness.
+class UidChainProgram {
+public:
+    using Image = std::vector<CheckedUidChains::Chain>;
+    static int ordinary(const UidPolicy& policy, Image* output);
+};
+}  // namespace android::net::gta3xlwifi
