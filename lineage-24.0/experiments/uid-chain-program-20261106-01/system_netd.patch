diff --git a/server/Gta3xlwifiUidChainProgram.cpp b/server/Gta3xlwifiUidChainProgram.cpp
new file mode 100644
--- /dev/null
+++ b/server/Gta3xlwifiUidChainProgram.cpp
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiUidChainProgram.h"
+#include <cerrno>
+#include <climits>
+#include <utility>
+namespace android::net::gta3xlwifi {
+int UidChainProgram::ordinary(const UidPolicy& policy, Image* output) {
+    if (!output) return -EINVAL;
+    using C = CheckedUidChains;
+    Image next;
+    for (const auto& type : UidPolicy::chains()) {
+        if (type.metered) continue;
+        if (type.id < 1 || type.id > 9) return -EOPNOTSUPP;
+        bool enabled;
+        int result = policy.getChainEnabled(type.id, &enabled);
+        if (result) return result;
+        C::Chain chain{"g24_uid_" + std::to_string(type.id), {}};
+        if (enabled) {
+            std::vector<int32_t> members;
+            result = policy.matchingUids(type.id, &members);
+            if (result) return result;
+            const auto verdict = type.allowlist ? C::Verdict::Return : C::Verdict::Drop;
+            for (int32_t member : members) {
+                if (member < 0) return -EINVAL;
+                const auto uid = static_cast<uint32_t>(member);
+                // Merge only contiguous matching UIDs; never bridge a gap or
+                // overflow INT_MAX. This keeps exact membership semantics.
+                if (!chain.rules.empty() && chain.rules.back().uid->last < INT_MAX &&
+                    chain.rules.back().uid->last + 1 == uid) {
+                    chain.rules.back().uid->last = uid;
+                } else {
+                    chain.rules.push_back({C::UidRange{uid, uid}, verdict});
+                }
+            }
+            chain.rules.push_back({std::nullopt,
+                type.allowlist ? C::Verdict::Drop : C::Verdict::Return});
+        } else {
+            chain.rules.push_back({std::nullopt, C::Verdict::Return});
+        }
+        next.push_back(std::move(chain));
+    }
+    if (next.size() != 9) return -EOPNOTSUPP;
+    const int result = C::validateImage(next);
+    if (result) return result;
+    *output = std::move(next);
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
