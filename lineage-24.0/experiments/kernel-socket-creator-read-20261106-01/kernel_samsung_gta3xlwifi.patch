diff --git a/include/net/sock.h b/include/net/sock.h
--- a/include/net/sock.h
+++ b/include/net/sock.h
@@ -1648,6 +1648,8 @@
 /* Initialise core socket variables */
 void sock_init_data(struct socket *sock, struct sock *sk);
 void gta3xlwifi_socket_creator_init(struct sock *sk, bool kernel_socket);
+/* Caller holds a socket reference or its lookup's protected lifetime. */
+bool gta3xlwifi_socket_creator_uid(const struct sock *sk, u32 *uid);
 
 /*
  * Socket reference counting postulates.
diff --git a/net/core/sock.c b/net/core/sock.c
--- a/net/core/sock.c
+++ b/net/core/sock.c
@@ -1453,6 +1453,23 @@
 }
 EXPORT_SYMBOL_GPL(gta3xlwifi_socket_creator_init);
 
+/* Unknown, timewait/request, non-inet or unmarked sockets have NO creator
+ * result. Never substitute zero/root/nobody or current mutable sk_uid.
+ * Metadata is initialized before publication and remains immutable until free.
+ */
+bool gta3xlwifi_socket_creator_uid(const struct sock *sk, u32 *uid)
+{
+	if (!sk || !uid || !sk_fullsock(sk))
+		return false;
+	if ((sk->sk_family != AF_INET && sk->sk_family != AF_INET6) ||
+	    !sk->sk_gta_creator_valid)
+		return false;
+	*uid = sk->sk_gta_creator_uid;
+	return true;
+}
+EXPORT_SYMBOL_GPL(gta3xlwifi_socket_creator_uid);
+
+
 /* A17's sk_storage map has no BPF_F_CLONE. A cloned/accepted socket must not
  * inherit an apparently captured creator from its parent storage.
  */
