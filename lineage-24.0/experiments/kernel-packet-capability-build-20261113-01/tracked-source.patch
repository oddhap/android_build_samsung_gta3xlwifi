diff --git a/include/uapi/linux/netfilter/gta3xlwifi_local_network.h b/include/uapi/linux/netfilter/gta3xlwifi_local_network.h
new file mode 100644
index 00000000..d6d830d2
--- /dev/null
+++ b/include/uapi/linux/netfilter/gta3xlwifi_local_network.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_GTA3XLWIFI_LOCAL_NETWORK_H
+#define _UAPI_GTA3XLWIFI_LOCAL_NETWORK_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+#define GTA3XLWIFI_LNA_VERSION 1U
+#define GTA3XLWIFI_LNA_MAX_ENTRIES 1000U
+#define GTA3XLWIFI_LNA_KEY_BYTES 24U
+#define GTA3XLWIFI_LNA_KEY_BITS 192U
+/* A compiled real store primitive, NEVER complete networking readiness. */
+#define GTA3XLWIFI_UID_CAP_LNA_STORE (1U << 3)
+#define GTA3XLWIFI_UID_CAP_LNA_MATCH (1U << 4)
+/* Socket-aware receive LNA/shared gate only, not complete firewall readiness. */
+#define GTA3XLWIFI_UID_CAP_LNA_RECEIVE (1U << 5)
+#define GTA3XLWIFI_UID_CAP_LNA_EGRESS (1U << 6) /* compiled real output hooks, not whole backend */
+#define GTA3XLWIFI_LNA_MATCH "gta3xlwifi_lna"
+struct gta3xlwifi_lna_match { __u32 reserved; };
+/* Canonical prefix: unused low bits/bytes are zero. Sort by prefix_bits then
+ * memcmp(key); duplicate prefixes are rejected. Native-order UID/ifindex/u16
+ * protocol, network-order address/port bytes match the actual A17 key payload.
+ */
+struct gta3xlwifi_lna_entry {
+    __u32 prefix_bits;
+    __u8 key[GTA3XLWIFI_LNA_KEY_BYTES];
+    __u8 allowed;
+    __u8 reserved[3];
+};
+struct gta3xlwifi_lna_transfer {
+    __u32 version;
+    __u32 network_count;
+    __u32 host_count;
+    __u32 reserved;
+    __aligned_u64 revision;
+    __aligned_u64 network_entries;
+    __aligned_u64 host_entries;
+};
+/* SET: full image, held owner lease only, revision+1 or identical replay.
+ * GET: both count/pointer pairs zero probes metadata; a data read supplies
+ * the exact probed revision and capacity for BOTH actual tables.
+ */
+#define GTA3XLWIFI_LNA_SET_IMAGE _IOW('g', 0x57, struct gta3xlwifi_lna_transfer)
+#define GTA3XLWIFI_LNA_GET_IMAGE _IOWR('g', 0x58, struct gta3xlwifi_lna_transfer)
+#endif
diff --git a/include/uapi/linux/netfilter/gta3xlwifi_loopback.h b/include/uapi/linux/netfilter/gta3xlwifi_loopback.h
new file mode 100644
index 00000000..850d3f38
--- /dev/null
+++ b/include/uapi/linux/netfilter/gta3xlwifi_loopback.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_GTA3XLWIFI_LOOPBACK_H
+#define _UAPI_GTA3XLWIFI_LOOPBACK_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+#define GTA3XLWIFI_LOOPBACK_VERSION 1U
+#define GTA3XLWIFI_LOOPBACK_MAX_EVENTS 512U
+#define GTA3XLWIFI_UID_CAP_LOOPBACK (1U << 7) /* real check/event/read primitive only */
+#define GTA3XLWIFI_LOOPBACK_ALLOWED 0U
+#define GTA3XLWIFI_LOOPBACK_BLOCKED 1U
+/* Genuine packet-derived event. Sequence/boot clock/loss are diagnostic stream
+ * metadata; the src/dst/result payload matches A17 LoopbackAccessEvent values.
+ */
+struct gta3xlwifi_loopback_event {
+    __u32 sender_uid, receiver_uid, result, reserved;
+    __aligned_u64 boottime_ns;
+    __aligned_u64 sequence;
+    __aligned_u64 lost_events;
+};
+/* count0/entries0 probes queue metadata. A consuming data read supplies the
+ * probed first_sequence and capacity1..512. Returns up to capacity records and
+ * actual current loss count. Both user copies must succeed before consumption.
+ * Sole authenticated lease owner only. No enable/disable or injection API.
+ */
+struct gta3xlwifi_loopback_transfer {
+    __u32 version, count;
+    __aligned_u64 entries;
+    __aligned_u64 first_sequence;
+    __aligned_u64 lost_events;
+};
+#define GTA3XLWIFI_LOOPBACK_GET_EVENTS _IOWR('g', 0x59, struct gta3xlwifi_loopback_transfer)
+#endif
diff --git a/include/uapi/linux/netfilter/gta3xlwifi_netpolicy.h b/include/uapi/linux/netfilter/gta3xlwifi_netpolicy.h
new file mode 100644
index 00000000..60013caa
--- /dev/null
+++ b/include/uapi/linux/netfilter/gta3xlwifi_netpolicy.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_GTA3XLWIFI_NETPOLICY_H
+#define _UAPI_GTA3XLWIFI_NETPOLICY_H
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define GTA3XLWIFI_NETPOLICY_VERSION 1
+#define GTA3XLWIFI_NETPOLICY_ABI     _IO('g', 0x50)
+#define GTA3XLWIFI_NETPOLICY_HOLD    _IO('g', 0x51)
+#define GTA3XLWIFI_NETPOLICY_RELEASE _IO('g', 0x52)
+#define GTA3XLWIFI_NETPOLICY_STATE   _IO('g', 0x53)
+#define GTA3XLWIFI_NETPOLICY_MATCH "gta3xlwifi_guard"
+
+/* No pointers or arguments: identical ioctl numbers on ARM32 and ARM64.
+ * ABI returns VERSION; STATE returns 1 when held, 0 when released.
+ * All other successful commands return 0. Every argument must be zero.
+ * Opening exclusively acquires a closed lease. Owner close/exit closes the
+ * barrier even if forked children still hold the file. This neither installs
+ * rules nor proves complete networking readiness.
+ */
+struct gta3xlwifi_netpolicy_match {
+	__u8 reserved[4];
+};
+#endif
