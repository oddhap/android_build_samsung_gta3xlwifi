# SPDX-License-Identifier: Apache-2.0
# Explicit isolated proposal for the exclusively owned packet-barrier lease.
type gta3xlwifi_netpolicy_device, dev_type;
type sysfs_gta3xlwifi_netpolicy, fs_type, sysfs_type;
allow netd gta3xlwifi_netpolicy_device:chr_file { open read getattr ioctl };
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x6750-0x6753 };
allow netd sysfs_gta3xlwifi_netpolicy:file { open read getattr };

# Exact additional UID-image operations; device remains root/read-only.
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x6754 0x6755 0x6756 };

# Exact additional LNA-image operations; device remains root/read-only.
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x6757 0x6758 };

# Exact loopback-event consumer; device remains root/read-only.
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x6759 };

# Exact interface snapshot reader; device remains root/read-only.
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x675a };

# Exact packet-store controls; device remains root/read-only.
allowxperm netd gta3xlwifi_netpolicy_device:chr_file ioctl { 0x675b 0x675c 0x675d 0x675e 0x675f };
