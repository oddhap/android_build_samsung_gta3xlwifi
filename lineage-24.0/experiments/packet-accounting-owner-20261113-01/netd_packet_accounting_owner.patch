+namespace android::net::gta3xlwifi {
+int NetpolicyLease::requirePacketAccountingPrimitives() {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if(mFd<0)return -ENOTCONN;
+    int result;
+    do{result=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(result<0&&errno==EINTR);
+    if(result<0)return imageErrorLocked(errno?-errno:-EIO);
+    constexpr int required=GTA3XLWIFI_UID_CAP_PACKET_STATS_STORE|
+                           GTA3XLWIFI_UID_CAP_PACKET_STATS_HOOKS;
+    return (result&required)==required?0:imageErrorLocked(-EOPNOTSUPP);
+}
+} // namespace android::net::gta3xlwifi
