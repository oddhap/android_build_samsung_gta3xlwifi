diff --git a/net/netfilter/gta3xlwifi_netpolicy.c b/net/netfilter/gta3xlwifi_netpolicy.c
index 3ca858f..9111993 100644
--- a/net/netfilter/gta3xlwifi_netpolicy.c
+++ b/net/netfilter/gta3xlwifi_netpolicy.c
@@ -9,6 +9,7 @@
 #include <linux/fs.h>
 #include <linux/miscdevice.h>
 #include <linux/module.h>
+#include <linux/string.h>
 #include <linux/mutex.h>
 #include <linux/netdevice.h>
 #include <linux/netfilter.h>
@@ -22,6 +23,7 @@
 #include <uapi/linux/netfilter/gta3xlwifi_local_network.h>
 #include <net/gta3xlwifi_local_network.h>
 #include <net/gta3xlwifi_receive.h>
+#include <net/gta3xlwifi_socket_tables.h>
 #include <net/gta3xlwifi_loopback.h>
 #include <uapi/linux/netfilter/gta3xlwifi_loopback.h>
 
@@ -43,6 +45,31 @@ static bool netpolicy_privileged(void)
 		ns_capable(&init_user_ns, CAP_NET_ADMIN);
 }
 
+/* Ordinary helper children perform iptables syscalls; the root/init capability
+ * check and exclusive held lease serialize private table commits. No private
+ * FD is exposed and no foreign table is affected by these helpers.
+ */
+int gta3xlwifi_socket_update_begin(const char *name)
+{
+    if (strcmp(name, GTA3XLWIFI_SOCKET_TABLE))
+        return 0;
+    if (!netpolicy_privileged())
+        return -EPERM;
+    mutex_lock(&netpolicy_lock);
+    if (!netpolicy_owner_file || !READ_ONCE(netpolicy_held)) {
+        mutex_unlock(&netpolicy_lock);
+        return -EBUSY;
+    }
+    return 1;
+}
+EXPORT_SYMBOL_GPL(gta3xlwifi_socket_update_begin);
+void gta3xlwifi_socket_update_end(int held)
+{
+    if (held == 1)
+        mutex_unlock(&netpolicy_lock);
+}
+EXPORT_SYMBOL_GPL(gta3xlwifi_socket_update_end);
