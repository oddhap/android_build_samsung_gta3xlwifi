set_metadata("/tmp/gta3xlwifi_recovery_header_sync", "uid", 0, "gid", 0, "mode", 0755);
assert(run_program("/tmp/gta3xlwifi_recovery_header_sync", "--preflight", "0x220001aa") == "0" || abort("Recovery identity or OS/SPL preflight failed. Installation stopped before image writes."));
