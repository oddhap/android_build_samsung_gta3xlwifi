assert(getprop("ro.product.device") == "gta3xlwifi" || getprop("ro.build.product") == "gta3xlwifi" || abort("E3004: This package is for device: gta3xlwifi; this device is " + getprop("ro.product.device") + "."););
ui_print("Target: samsung/lineage_gta3xlwifi/gta3xlwifi:17/CP2A.260605.016/eng.builde:userdebug/test-keys");
