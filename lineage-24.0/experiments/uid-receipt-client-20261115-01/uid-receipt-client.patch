+int SocketPolicyProjection::readUidCleanup(NetpolicyLease::UidCleanupReceipt* output) {
+  if(!output)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if(!mStarted)return -EAGAIN;
+  if(!mAccountingEnabled)return -EOPNOTSUPP;
+  if(!mCommit){bool held=false;int r=mLease.isHeld(&held);if(r)return quarantine(r);
+              if(!held)return quarantine(-EUCLEAN);}
+  int result=mLease.readUidCleanup(output);return result?quarantine(result):0;
+}
+int SocketPolicyProjection::removeUidAccountingOnce(int32_t uid,uint64_t generation,
+        uint64_t epoch,uint64_t nonce,UidTagDeleter deleteTags) {
+  if(uid<0||!epoch||!nonce||!deleteTags)return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if(!mStarted)return -EAGAIN;
+  if(!mAccountingEnabled)return -EOPNOTSUPP;
+  if(!mCommit){bool held=false;int r=mLease.isHeld(&held);if(r)return quarantine(r);
+              if(!held)return quarantine(-EUCLEAN);}
+  NetpolicyLease::UidCleanupReceipt receipt;
+  int result=mLease.readUidCleanup(&receipt);if(result)return quarantine(result);
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_COMPLETE&&receipt.nonce==nonce){
+    return receipt.uid==static_cast<uint32_t>(uid)&&receipt.generation==generation&&
+           receipt.activeEpoch==epoch?0:-ESTALE;
+  }
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_PREPARED)return quarantine(-EINPROGRESS);
+  if(receipt.nonce>=nonce||(mCommit?mCommit->generation:0)!=generation)return -ESTALE;
+  NetpolicyLease::PacketState state;
+  result=mLease.readPacketState(&state);if(result)return quarantine(result);
+  if(state.activeEpoch!=epoch)return -ESTALE;
+  if(state.pendingMask)return -EBUSY;
+  result=mLease.beginUidCleanup(uid,generation,epoch,nonce,&receipt);
+  if(result)return quarantine(result);
+  if(receipt.phase==GTA3XLWIFI_UID_CLEANUP_COMPLETE)return 0;
+  if(receipt.phase!=GTA3XLWIFI_UID_CLEANUP_PREPARED)return quarantine(-EPROTO);
+  result=deleteTags(uid);if(result)return quarantine(result<0?result:-EPROTO);
+  result=mLease.commitUidCleanup(uid,generation,epoch,nonce,&receipt);
+  return result?quarantine(result):0;
+}
