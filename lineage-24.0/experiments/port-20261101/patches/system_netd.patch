index 0000000..92687aa
--- /dev/null
+++ b/server/Gta3xlwifiUidPolicy.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <vector>
+
+namespace android::net::gta3xlwifi {
+
+// Candidate UID-policy value, NOT a kernel backend or a readiness indicator.
+// Mutators change this value only. A future netd owner must apply the complete
+// kernel transaction before publishing it to DNS/Java readers. In particular,
+// do not register a DNS callback or skip NetBpfLoad merely because this exists.
+// Mirrors A16 BpfNetMapsUtils firewall queries, not INTERNET permission, VPN,
+// interface, local-network packet policy, quotas, or socket-tag permissions.
+class UidPolicy {
+public:
+    enum Rule : int32_t { Default = 0, Allow = 1, Deny = 2 };
+    struct Chain {
+        int32_t id;
+        uint32_t match;
+        uint32_t blockedReason;
+        bool allowlist;
+        bool metered;
+    };
+    static const std::array<Chain, 12>& chains();
+    static constexpr uint32_t MeteredReasonMask = 0xffff0000u;
+    static constexpr uint32_t DataSaverReason = 1u << 16;
+
+    int setChainEnabled(int32_t chain, bool enabled);
+    int getChainEnabled(int32_t chain, bool* enabled) const;
+    int setUidRule(int32_t chain, int32_t uid, int32_t rule);
+    int getUidRule(int32_t chain, int32_t uid, int32_t* rule) const;
+    // This list contains matching UIDs, not ALLOW rules for every chain. Thus
+    // for a denylist it specifies denied UIDs, exactly as replaceUidChain().
+    // Validates the entire input before changing state; duplicates are harmless.
+    int replaceUidChain(int32_t chain, const std::vector<int32_t>& uids);
+    int removeUid(int32_t uid);
+    void setDataSaver(bool enabled) { mDataSaver = enabled; }
+    bool dataSaver() const { return mDataSaver; }
+    int blockedReasons(int32_t uid, uint32_t* reasons) const;
+    // Same private V2 result convention: 0 allow, 1 block, negative errno.
+    // This is evaluation of a value, NOT a publishable callback owner.
+    int isNetworkingBlocked(int32_t uid, bool metered) const;
+
+private:
+    static const Chain* findChain(int32_t id);
+    void setMatch(int32_t uid, uint32_t match, bool present);
+    uint32_t uidMatches(int32_t uid) const;
+    uint32_t mEnabled = 0;
+    std::map<int32_t, uint32_t> mUidMatches;
+    bool mDataSaver = false;
+};
+
+}  // namespace android::net::gta3xlwifi
