--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -43,6 +43,7 @@
 #include <linux/syscalls.h>
 #include <linux/dcache.h>
 #include <linux/file.h>
+#include <linux/fsnotify_backend.h>
 #include <linux/fdtable.h>
 #include <linux/namei.h>
 #include <linux/mount.h>
@@ -3236,6 +3237,23 @@ static int selinux_inode_setattr(struct dentry *dentry, struct iattr *iattr)
 	return dentry_has_perm(cred, dentry, av);
 }
 
+static int selinux_path_notify(const struct path *path, u64 mask,
+			       unsigned int obj_type)
+{
+	u32 perm = FILE__WATCH;
+
+#if defined(CONFIG_FANOTIFY) || defined(CONFIG_FANOTIFY_MODULE)
+#error Fanotify mount/superblock/permission mediation is not backported.
+#endif
+	/* Do not pretend unsupported mark kinds or permission events work. */
+	if (obj_type != FSNOTIFY_OBJ_TYPE_INODE ||
+	    (mask & ALL_FSNOTIFY_PERM_EVENTS))
+		return -EOPNOTSUPP;
+	if (mask & (FS_ACCESS | FS_CLOSE_NOWRITE))
+		perm |= FILE__WATCH_READS;
+	return path_has_perm(current_cred(), path, perm);
+}
+
 static int selinux_inode_getattr(const struct path *path)
 {
 	return path_has_perm(current_cred(), path, FILE__GETATTR);
