+    /** Dedicated consuming API. Serializes stream state, never policy/factory locks. */
+    public LoopbackBatch pollLoopbackEvents() throws IOException {
+        synchronized(mLoopbackLock){
+            requireActiveHandle();final long[] w;
+            try{w=mRemote.pollLoopbackEvents(mSession);}
+            catch(ServiceSpecificException e){
