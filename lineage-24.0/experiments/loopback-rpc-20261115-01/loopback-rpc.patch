+    public static final class LoopbackEvent {
+        public final int senderUid,receiverUid,result;
+        public final long boottimeNs,sequence,lostEvents;
+        private LoopbackEvent(long[] w,int p){senderUid=(int)w[p];receiverUid=(int)w[p+1];
+            result=(int)w[p+2];boottimeNs=w[p+3];sequence=w[p+4];lostEvents=w[p+5];}
+    }
+    public static final class LoopbackBatch {
+        public final long lostEvents;
+        private final LoopbackEvent[] mEvents;
+        private LoopbackBatch(long lost,LoopbackEvent[] events){lostEvents=lost;mEvents=events;}
+        public int size(){return mEvents.length;}
+        public LoopbackEvent event(int i){return mEvents[i];}
+    }
+    private final Object mLoopbackLock=new Object();
