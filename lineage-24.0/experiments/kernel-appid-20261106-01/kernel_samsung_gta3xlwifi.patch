diff --git a/net/netfilter/xt_qtaguid.c b/net/netfilter/xt_qtaguid.c
--- a/net/netfilter/xt_qtaguid.c
+++ b/net/netfilter/xt_qtaguid.c
@@ -22,6 +22,7 @@
 #include <linux/netfilter/x_tables.h>
 #include <linux/netfilter/xt_qtaguid.h>
 #include <uapi/linux/netfilter/xt_qtaguid_sock.h>
+#include <uapi/linux/netfilter/gta3xlwifi_appid.h>
 #include <linux/ratelimit.h>
 #include <linux/seq_file.h>
 #include <linux/skbuff.h>
@@ -3085,3 +3086,69 @@
 MODULE_ALIAS("ip6t_owner");
 MODULE_ALIAS("ipt_qtaguid");
 MODULE_ALIAS("ip6t_qtaguid");
+
+
+/* Separate opt-in ABI: never reinterpret unknown bits in owner revision 1.
+ * Android17 treats missing/overflow socket UIDs as root before owner policy.
+ * Reuse this kernel's real INPUT socket lookup and its reference contract.
+ */
+static bool gta3xlwifi_appid_mt(const struct sk_buff *skb,
+                               struct xt_action_param *par)
+{
+	const struct gta3xlwifi_appid_match *info = par->matchinfo;
+	struct sock *sk;
+	bool referenced = false;
+	uid_t uid = 65534;
+	unsigned int appid;
+
+	if (!skb)
+		return false;
+	sk = skb_to_full_sk(skb);
+	if (sk && sk->sk_state == TCP_TIME_WAIT)
+		sk = NULL;
+	if (!sk) {
+		sk = qtaguid_find_sk(skb, par);
+		referenced = sk != NULL;
+	}
+	if (sk)
+		uid = from_kuid_munged(&init_user_ns, sk->sk_uid);
+	if (uid == 65534)
+		uid = 0;
+	appid = uid % GTA3XLWIFI_APPID_USER_OFFSET;
+	if (referenced)
+		sock_gen_put(sk);
+	return appid >= info->minimum && appid <= info->maximum;
+}
+
+static int gta3xlwifi_appid_check(const struct xt_mtchk_param *par)
+{
+	const struct gta3xlwifi_appid_match *info = par->matchinfo;
+
+	if (current_user_ns() != &init_user_ns ||
+	    (par->family != NFPROTO_IPV4 && par->family != NFPROTO_IPV6) ||
+	    info->minimum > info->maximum ||
+	    info->maximum >= GTA3XLWIFI_APPID_USER_OFFSET)
+		return -EINVAL;
+	return 0;
+}
+
+static struct xt_match gta3xlwifi_appid_reg __read_mostly = {
+	.name = GTA3XLWIFI_APPID_MATCH,
+	.revision = 0,
+	.family = NFPROTO_UNSPEC,
+	.hooks = (1 << NF_INET_LOCAL_IN) | (1 << NF_INET_LOCAL_OUT),
+	.match = gta3xlwifi_appid_mt,
+	.checkentry = gta3xlwifi_appid_check,
+	.matchsize = sizeof(struct gta3xlwifi_appid_match),
+	.me = THIS_MODULE,
+};
+
+static int __init gta3xlwifi_appid_init(void)
+{
+	return xt_register_match(&gta3xlwifi_appid_reg);
+}
+
+/* QTAGUID is built in (Kconfig y/n), so this is an independent initcall. */
+module_init(gta3xlwifi_appid_init);
+MODULE_ALIAS("ipt_gta3xlwifi_appid");
+MODULE_ALIAS("ip6t_gta3xlwifi_appid");
diff --git a/include/uapi/linux/netfilter/gta3xlwifi_appid.h b/include/uapi/linux/netfilter/gta3xlwifi_appid.h
new file mode 100644
--- /dev/null
+++ b/include/uapi/linux/netfilter/gta3xlwifi_appid.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_GTA3XLWIFI_APPID_H
+#define _UAPI_GTA3XLWIFI_APPID_H
+#include <linux/types.h>
+#define GTA3XLWIFI_APPID_MATCH "gta3xlwifi_appid"
+#define GTA3XLWIFI_APPID_USER_OFFSET 100000U
+struct gta3xlwifi_appid_match {
+	__u32 minimum;
+	__u32 maximum;
+};
+#endif
