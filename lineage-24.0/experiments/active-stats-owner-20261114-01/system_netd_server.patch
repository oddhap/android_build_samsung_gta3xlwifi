+int SocketPolicyProjection::readTaggingBudget(int32_t uid, TaggingBudget* output) {
+  if (uid < 0 || !output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  int result = packetAccountingAvailableLocked();
+  if (result) return result;
+  NetpolicyLease::PacketState state;
+  result = mLease.readPacketState(&state);
+  if (result) return quarantine(result);
+  NetpolicyLease::PacketSnapshot snapshot;
+  result = mLease.readActivePacketStats(state.activeEpoch, &snapshot);
+  if (result) return quarantine(result);
+  TaggingBudget next;
+  next.totalEntries = snapshot.entries.size();
+  next.epoch = snapshot.epoch;
+  next.sequence = snapshot.sequence;
+  next.lostUpdates = snapshot.lostUpdates;
+  for (const auto& row : snapshot.entries)
+    if (row.uid == static_cast<uint32_t>(uid)) ++next.uidEntries;
+  *output = next;
+  return 0;
+}
