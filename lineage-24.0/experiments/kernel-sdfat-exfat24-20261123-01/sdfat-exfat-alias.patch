--- a/fs/sdfat/sdfat.c
+++ b/fs/sdfat/sdfat.c
@@ -5177,6 +5177,23 @@
 	.fs_flags    = FS_REQUIRES_DEV,
 };
 
+/*
+ * gta3xlwifi: also register as "exfat" so Android vold (Exfat::IsSupported
+ * checks /proc/filesystems for "exfat") can mount exFAT public volumes with
+ * the built-in sdfat driver. Same mount and teardown paths as "sdfat".
+ */
+static struct file_system_type exfat_fs_type = {
+	.owner       = THIS_MODULE,
+	.name        = "exfat",
+	.mount       = sdfat_fs_mount,
+#ifdef CONFIG_SDFAT_DBG_IOCTL
+	.kill_sb    = sdfat_debug_kill_sb,
+#else
+	.kill_sb    = kill_block_super,
+#endif /* CONFIG_SDFAT_DBG_IOCTL */
+	.fs_flags    = FS_REQUIRES_DEV,
+};
+
 static int __init init_sdfat_fs(void)
 {
 	int err;
@@ -5216,6 +5233,13 @@
 	err = register_filesystem(&sdfat_fs_type);
 	if (err) {
 		pr_err("[SDFAT] failed to register filesystem\n");
+		goto error;
+	}
+
+	err = register_filesystem(&exfat_fs_type);
+	if (err) {
+		pr_err("[SDFAT] failed to register exfat alias\n");
+		unregister_filesystem(&sdfat_fs_type);
 		goto error;
 	}
 
@@ -5256,6 +5280,7 @@
 	}
 
 	sdfat_destroy_inodecache();
+	unregister_filesystem(&exfat_fs_type);
 	unregister_filesystem(&sdfat_fs_type);
 
 	fsapi_shutdown();
