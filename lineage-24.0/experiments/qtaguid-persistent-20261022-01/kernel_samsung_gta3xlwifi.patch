 	.owner = THIS_MODULE,
 	.open = qtudev_open,
 	.release = qtudev_release,
+	.unlocked_ioctl = qtudev_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = qtudev_ioctl,
+#endif
 };
 
