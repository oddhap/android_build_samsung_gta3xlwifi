+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiPermissionBootstrap.h"
+#include <cerrno>
+#include <limits>
+#include <map>
+#include <set>
+#include <utility>
+namespace android::net::gta3xlwifi {
+int PermissionBootstrap::convert(uint32_t raw, bool loopback, uint32_t* output) {
+  if (!output || (raw & ~RawKnownMask)) return -EINVAL;
+  uint32_t value = 0;
+  if ((raw & (1u << 0)) || (raw & (1u << 8))) value |= UidPermissionState::AccessLocalNetwork;
+  if (raw & (1u << 1)) value |= UidPermissionState::UpdateDeviceStats;
+  if (!(raw & (1u << 2))) value |= UidPermissionState::NoInternet;
+  if (loopback) {
+    if (raw & (1u << 3)) value |= UidPermissionState::UseLoopbackInterface;
+    if (raw & (1u << 4)) value |= UidPermissionState::ForceUseLoopbackInterface;
+    if (raw & (1u << 5)) value |= UidPermissionState::InteractAcrossUsersFull;
+    if ((raw & (1u << 6)) || (raw & (1u << 7))) value |= UidPermissionState::InteractAcrossUsersOrProfiles;
+  }
+  *output = value;
+  return 0;
+}
+int PermissionBootstrap::compile(const Snapshot& input, UidPermissionState* output) {
+  if (!output) return -EINVAL;
+  if (input.users.size() > MaxEntries || input.knownUids.size() > MaxEntries ||
+      input.observed.size() > MaxEntries) return -E2BIG;
+  std::set<int32_t> users;
+  for (int32_t user : input.users) {
+    if (user < 0 || user > (std::numeric_limits<int32_t>::max() - 1000) / PerUserRange ||
+        !users.insert(user).second) return -EINVAL;
+  }
+  if (!users.count(0)) return -EPROTO;
+  std::map<int32_t, uint32_t> raw;
+  for (const auto& row : input.observed) {
+    if (row.uid < 0 || (row.bits & ~RawKnownMask) || !raw.emplace(row.uid, row.bits).second)
+      return -EINVAL;
+    if (!users.count(row.uid / PerUserRange)) return -EPROTO;
+  }
+  // PermissionService's initial callback explicitly supplies all-granted core
+  // rows for every user. Do not invent these rows or silently allow an omitted
+  // core frame. Runtime updates still retain their existing independent API.
+  for (int32_t user : users) {
+    for (int32_t appId : {0, 1000}) {
+      auto row = raw.find(user * PerUserRange + appId);
+      if (row == raw.end() || row->second != RawKnownMask) return -EPROTO;
+    }
+  }
+  // Preserve membership even when conversion produces0. It proves INTERNET
+  // was observed; absence from the canonical nonzero-only store does not.
+  std::map<int32_t, uint32_t> canonical;
+  for (const auto& row : raw) {
+    uint32_t value = 0;
+    int result = convert(row.second, input.loopbackPermissionEnabled, &value);
+    if (result) return result;
+    canonical.emplace(row.first, value);
+  }
+  for (int32_t uid : input.knownUids) {
+    if (uid < 0) return -EINVAL;
+    if (!users.count(uid / PerUserRange)) return -EPROTO;
+    canonical.emplace(uid, UidPermissionState::NoInternet);
+  }
+  std::vector<UidPermissionState::Entry> rows;
+  for (const auto& row : canonical) {
+    if (!row.second) continue;
+    if (rows.size() == MaxEntries) return -E2BIG;
+    rows.push_back({row.first, row.second});
+  }
+  UidPermissionState next;
+  int result = next.replace(rows);
+  if (result) return result;
+  *output = std::move(next);
+  return 0;
+}
+}  // namespace android::net::gta3xlwifi
