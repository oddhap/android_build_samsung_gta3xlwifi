+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <vector>
+#include "Gta3xlwifiUidPermissionState.h"
+namespace android::net::gta3xlwifi {
+// Compile a COMPLETE, immutable caller-supplied Android17 permission snapshot.
+// No observer registration, snapshot collection, IPC, kernel I/O or Ready here.
+class PermissionBootstrap final {
+ public:
+  struct RawPermission { int32_t uid; uint32_t bits; };
+  struct Snapshot {
+    std::vector<int32_t> users;
+    // Shared-UID packages may repeat a UID. Include SDK sandbox UIDs as needed.
+    std::vector<int32_t> knownUids;
+    std::vector<RawPermission> observed;
+    bool loopbackPermissionEnabled = false;
+  };
+  static constexpr uint32_t RawKnownMask = (1u << 10) - 1;
+  static constexpr uint32_t MaxEntries = 65536;
+  static constexpr int32_t PerUserRange = 100000;
+  // Exact pinned PermissionMonitor conversion. Zero is a real observed value:
+  // INTERNET-only maps to canonical0 and must not become a missing UID.
+  static int convert(uint32_t raw, bool loopbackPermissionEnabled, uint32_t* output);
+  // Requires user0 and actual framework all-granted root/system rows per user.
+  // Missing known UID gets explicit NoInternet, preserving observed canonical0.
+  // Unknown users/incomplete core coverage reject before changing output.
+  static int compile(const Snapshot& snapshot, UidPermissionState* output);
+};
+}  // namespace android::net::gta3xlwifi
