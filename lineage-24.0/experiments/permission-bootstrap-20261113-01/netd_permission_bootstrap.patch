+
+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::publishInitialPermissions(
+    const State& policy, const PermissionBootstrap::Snapshot& permissions) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -ENOTCONN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  if (mCommit) return -EALREADY;
+  std::vector<UidPermissionState::Entry> existing;
+  int result = policy.permissions.snapshot(&existing);
+  if (result) return result;
+  if (!existing.empty()) return -EINVAL;
+  State next = policy;
+  result = PermissionBootstrap::compile(permissions, &next.permissions);
+  if (result) return result;
+  return applyLocked(std::move(next));
+}
+}  // namespace android::net::gta3xlwifi
