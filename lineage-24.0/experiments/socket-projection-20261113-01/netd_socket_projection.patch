+namespace {
+bool guarded(const std::string& chain, const std::string& text) {
+    if (text.empty() || text.size() > 1024 * 1024 || text.back() != '\n') return false;
+    for (unsigned char c : text) if ((c < 32 && c != '\n') || c == 127) return false;
+    std::istringstream input(text);
+    std::string line;
+    if (!std::getline(input, line) || (line != "-P " + chain + " ACCEPT" &&
+                                     line != "-P " + chain + " DROP")) return false;
+    if (!std::getline(input, line) ||
+        line != "-A " + chain + " -m gta3xlwifi_guard -j DROP") return false;
+    while (std::getline(input, line)) {
+        if (line.size() > 65536 || line.rfind("-A " + chain + " ", 0) != 0) return false;
+    }
+    return true;
+}
+}
+int SocketPolicyProjection::prepareHooks(HookMode mode) {
+    if (mode == HookMode::VerifyOnly) return verifyHooks();
+    if (mode != HookMode::InstallMissing) return -EINVAL;
+    struct Hook { IptablesTarget family; std::string chain, expected; bool missing; };
+    std::vector<Hook> hooks;
+    // Capture and validate every root before touching either family. Never
+    // submit existing/foreign rule text back to the command interpreter.
+    for (const auto family : {V4, V6}) {
+        for (const auto chain : {"INPUT", "FORWARD", "OUTPUT"}) {
+            const std::string name(chain);
+            std::string text;
+            if (mKernel.execute(family, "*filter\n-S " + name + "\nCOMMIT\n", &text))
+                return -EREMOTEIO;
+            if (guarded(name, text)) { hooks.push_back({family, name, text, false}); continue; }
+            if (text.empty() || text.size() > 1024 * 1024 || text.back() != '\n' ||
+                text.find("gta3xlwifi_guard") != std::string::npos) return -EPROTO;
+            for (unsigned char c : text) if ((c < 32 && c != '\n') || c == 127) return -EPROTO;
+            std::istringstream input(text);
+            std::string policy, line;
+            if (!std::getline(input, policy) || (policy != "-P " + name + " ACCEPT" &&
+                                                policy != "-P " + name + " DROP")) return -EPROTO;
+            while (std::getline(input, line)) {
+                if (line.size() > 65536 || line.rfind("-A " + name + " ", 0) != 0) return -EPROTO;
+            }
+            const std::string expected = policy + "\n-A " + name +
+                " -m gta3xlwifi_guard -j DROP\n" + text.substr(policy.size() + 1);
+            hooks.push_back({family, name, expected, true});
+        }
+    }
+    for (const auto family : {V4, V6}) {
+        std::string command = "*filter\n";
+        for (const auto& hook : hooks) {
+            if (hook.family == family && hook.missing)
+                command += "-I " + hook.chain + " 1 -m gta3xlwifi_guard -j DROP\n";
+        }
+        if (command != "*filter\n" && mKernel.execute(family, command + "COMMIT\n", nullptr))
+            return -EREMOTEIO;  // May have committed: retain guards and the held kernel state.
+    }
+    for (const auto& hook : hooks) {
+        std::string actual;
+        if (mKernel.execute(hook.family, "*filter\n-S " + hook.chain + "\nCOMMIT\n", &actual))
+            return -EREMOTEIO;
+        if (actual != hook.expected || !guarded(hook.chain, actual)) return -EPROTO;
+    }
+    return 0;  // All six actual images verified, but the barrier remains held.
+}
+int SocketPolicyProjection::verifyHooks() {
+    for (const auto family : {V4, V6}) {
+        for (const auto chain : {"INPUT", "FORWARD", "OUTPUT"}) {
+            std::string output;
+            if (mKernel.execute(family, "*filter\n-S " + std::string(chain) + "\nCOMMIT\n",
+                                &output)) return -EREMOTEIO;
+            if (!guarded(chain, output)) return -EPROTO;
+        }
+    }
+    return 0;
+}
