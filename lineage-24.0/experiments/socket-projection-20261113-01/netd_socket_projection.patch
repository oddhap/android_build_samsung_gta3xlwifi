+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <functional>
+#include <memory>
+
+#include "Gta3xlwifiIngressPolicy.h"
+#include "Gta3xlwifiLocalNetworkState.h"
+#include "Gta3xlwifiMeteredRoots.h"
+#include "Gta3xlwifiSocketRoots.h"
+#include "Gta3xlwifiUidPermissionState.h"
+#include "Gta3xlwifiUidPolicy.h"
+namespace android::net::gta3xlwifi {
+// Four-state POLICY projection only; not accounting/Binder/startup/readiness.
+// Sole owner of ONE real lease and one mutex. All rules/parents/guards in both
+// families finish before LNA SET, then UID SET LAST. Error withdraws every
+// value and closes/holds the gate; no post-SET firewall I/O or automatic policy
+// repair.
+class SocketPolicyProjection final {
+ public:
+  struct State {
+    UidPolicy policy;
+    IngressPolicy ingress;
+    UidPermissionState permissions;
+    LocalNetworkState local;
+  };
+  enum class HookMode { VerifyOnly, InstallMissing };
+  explicit SocketPolicyProjection(IptablesRestoreInterface& kernel)
+      : mKernel(kernel),
+        mSocket(kernel, mLease),
+        mMeter(kernel, mLease),
+        mSocketWriter(kernel, CheckedUidChains::Table::Socket),
+        mFilterWriter(kernel) {}
+  ~SocketPolicyProjection() { stop(); }
+  int start(HookMode mode = HookMode::VerifyOnly);
+  void stop();
+  // expectedGeneration=0 is explicit first commit after start. Stale updates
+  // fail before kernel I/O. Readers see one complete committed state or EAGAIN.
+  int replace(const State& state, uint64_t expectedGeneration);
+  int snapshot(State* output, uint64_t* generation);
+  int removeUid(int32_t uid);
+  int setUidRule(int32_t chain, int32_t uid, int32_t rule);
+  int setChainEnabled(int32_t chain, bool enabled);
+  int setDataSaver(bool enabled);
+  int setUidPermission(int32_t uid, uint32_t permissions);
+  int setIif(int32_t uid, uint32_t ifindex);
+  int clearIif(int32_t uid);
+  int setLockdown(int32_t uid, bool enabled);
+  int setDiscard(const IngressPolicy::Address& address, uint32_t first,
+                 uint32_t second);
+  int clearDiscard(const IngressPolicy::Address& address);
+  int setLocalEntry(LocalNetworkState::Table table,
+                    LocalNetworkState::Entry entry);
+  int clearLocalEntry(LocalNetworkState::Table table,
+                      LocalNetworkState::Entry entry);
+  int readLoopbackEvents(NetpolicyLease::LoopbackBatch* output);
+
+ private:
+  using Image = std::vector<CheckedUidChains::Chain>;
+  struct Commit {
+    State value;
+    Image ordinary, metered;
+    NetpolicyLease::PermissionImage uid;
+    NetpolicyLease::LocalNetworkImage local;
+    uint64_t generation = 0;
+  };
+  int applyLocked(State value);
+  int update(const std::function<int(State&)>& mutation);
+  int prepareHooks(HookMode mode);
+  int verifyHooks();
+  int quarantine(int error);
+  IptablesRestoreInterface& mKernel;
+  NetpolicyLease mLease;
+  SocketRoots mSocket;
+  MeteredRoots mMeter;
+  CheckedUidChains mSocketWriter, mFilterWriter;
+  std::mutex mMutex;
+  bool mStarted = false;
+  uint64_t mGeneration = 0;
+  std::unique_ptr<Commit> mCommit;
+};
