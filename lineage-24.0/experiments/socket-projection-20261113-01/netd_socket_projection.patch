+int SocketPolicyProjection::quarantine(int error) {
+  mCommit.reset();
+  mStarted = false;
+  mLease.stop();
+  return error;
+}
+int SocketPolicyProjection::start(HookMode mode) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (mStarted) return -EALREADY;
+  int r = mLease.start();
+  if (r) return r;
+  r = mLease.requirePolicyPrimitives();
+  if (r) return quarantine(r);
+  r = prepareHooks(mode);
+  if (!r) r = mSocket.prepare();
+  if (!r) r = mMeter.prepare();
+  if (r) return quarantine(r);
+  mStarted = true;
+  return 0;  // Still held/unpublished.
+}
+void SocketPolicyProjection::stop() {
+  std::lock_guard<std::mutex> lock(mMutex);
+  quarantine(0);
+}
+int SocketPolicyProjection::replace(const State& value, uint64_t expected) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -ENOTCONN;
+  if (expected != (mCommit ? mCommit->generation : 0)) return -ESTALE;
+  return applyLocked(value);
+}
+int SocketPolicyProjection::snapshot(State* output, uint64_t* generation) {
+  if (!output || !generation) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mCommit) return -EAGAIN;
+  State copy = mCommit->value;
+  *output = std::move(copy);
+  *generation = mCommit->generation;
+  return 0;
+}
+int SocketPolicyProjection::applyLocked(State value) {
+  if (mGeneration == UINT64_MAX) return -EOVERFLOW;
+  auto next = std::make_unique<Commit>();
+  next->value = std::move(value);
+  next->generation = mGeneration + 1;
+  // Exact shared A17 uid_owner_map union, including disabled-chain members
+  // and explicitly present wildcard IIF0. Permission/LNA stores are separate.
+  std::set<int32_t> owners;
+  std::vector<int32_t> uids;
+  for (const auto& chain : UidPolicy::chains()) {
+    int r = next->value.policy.matchingUids(chain.id, &uids);
+    if (r) return r;
+    owners.insert(uids.begin(), uids.end());
+    if (owners.size() > 20000) return -E2BIG;
+  }
+  int r = next->value.ingress.ownerUids(&uids);
+  if (r) return r;
+  owners.insert(uids.begin(), uids.end());
+  if (owners.size() > 20000) return -E2BIG;
+  Image ordinary;
+  r = UidChainProgram::ordinary(next->value.policy, &ordinary);
+  if (!r) r = OrdinaryDispatch::append(&ordinary);
+  if (!r) r = next->value.ingress.compile(ordinary, &next->ordinary);
+  if (!r) r = MeteredChainProgram::compile(next->value.policy, &next->metered);
+  if (!r) r = MeteredRoots::validateImage(next->metered);
+  if (r) return r;
+  std::vector<UidPermissionState::Entry> permissions;
+  r = next->value.permissions.snapshot(&permissions);
+  if (r) return r;
+  if (permissions.size() > 65536) return -E2BIG;
+  next->uid.entries.reserve(permissions.size());
+  for (const auto& e : permissions)
+    next->uid.entries.push_back({e.uid, e.permissions});
+  r = next->value.local.snapshot(&next->local.network, &next->local.host);
+  if (r) return r;
+  // Everything above is pure validation/allocation. Invalid values preserve
+  // the old released state and perform NO ioctl or firewall operation.
+  r = mLease.hold();
+  if (r) return quarantine(r);
+  r = verifyHooks();
+  if (!r) r = mSocket.verifyPrepared();
+  if (!r) r = mMeter.verifyPrepared();
+  if (!r && mCommit) r = mSocket.verify(mCommit->ordinary);
+  if (!r && mCommit) r = mMeter.verify(mCommit->metered);
+  if (r) return quarantine(r);
+  NetpolicyLease::PermissionImage beforeUid;
+  NetpolicyLease::LocalNetworkImage beforeLocal;
+  r = mLease.readUidPermissions(&beforeUid);
+  if (!r) r = mLease.readLocalNetwork(&beforeLocal);
+  if (r) return quarantine(r);
+  if (beforeUid.revision == UINT64_MAX || beforeLocal.revision == UINT64_MAX)
+    return quarantine(-EOVERFLOW);
+  if (mCommit &&
+      (!same(beforeUid, mCommit->uid) || !same(beforeLocal, mCommit->local)))
+    return quarantine(-EUCLEAN);
+  Image beforeOrd[2], beforeMeter[2];
+  unsigned index = 0;
+  for (auto family : {V4, V6}) {
+    r = mSocketWriter.read(family, chainNames(next->ordinary),
+                           &beforeOrd[index]);
+    if (!r)
+      r = mFilterWriter.read(family, chainNames(next->metered),
+                             &beforeMeter[index]);
+    if (r) return quarantine(r);
+    if (mCommit && (beforeOrd[index] != mCommit->ordinary ||
+                    beforeMeter[index] != mCommit->metered))
+      return quarantine(-EUCLEAN);
+    ++index;
+  }
+  // Any uncertain program/parent result withdraws all four states, even when
+  // a component restored itself. No mixed-family old/new state is released.
+  for (auto family : {V4, V6}) {
+    r = mSocketWriter.replace(family, next->ordinary);
+    if (r) return quarantine(r);
+  }
+  for (auto family : {V4, V6}) {
+    r = mFilterWriter.replace(family, next->metered);
+    if (r) return quarantine(r);
+  }
+  r = mSocket.activate(next->ordinary);
+  if (!r) r = mMeter.activate(next->metered);
+  if (!r) r = mSocket.verify(next->ordinary);
+  if (!r) r = mMeter.verify(next->metered);
+  if (!r) r = verifyHooks();
+  if (r) return quarantine(r);
+  // HARD firewall cutoff: nothing below may open/query/change iptables.
+  r = mLease.replaceLocalNetwork(beforeLocal.revision, next->local.network,
+                                 next->local.host, &next->local.revision);
+  if (r) return quarantine(-EUCLEAN);
+  r = mLease.replaceUidPermissions(beforeUid.revision, next->uid.entries,
+                                   &next->uid.revision);
+  if (r) return quarantine(-EUCLEAN);
+  if (mLease.release()) return quarantine(-EUCLEAN);
+  mGeneration = next->generation;
+  mCommit = std::move(next);
+  return 0;
+}
+int SocketPolicyProjection::update(const std::function<int(State&)>& mutation) {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mCommit) return -EAGAIN;
+  State next = mCommit->value;
+  int r = mutation(next);
+  return r ? r : applyLocked(std::move(next));
+}
+int SocketPolicyProjection::removeUid(int32_t uid) {
+  return update([uid](State& s) {
+    int r = s.policy.removeUid(uid);
+    if (!r) r = s.ingress.removeUid(uid);
+    if (!r) r = s.permissions.remove(uid);
+    if (!r) r = s.local.removeUid(uid);
+    return r;
+  });
+}
+int SocketPolicyProjection::setUidRule(int32_t c, int32_t u, int32_t r) {
+  return update([=](State& s) { return s.policy.setUidRule(c, u, r); });
+}
+int SocketPolicyProjection::setChainEnabled(int32_t c, bool e) {
+  return update([=](State& s) { return s.policy.setChainEnabled(c, e); });
+}
+int SocketPolicyProjection::setDataSaver(bool e) {
+  return update([=](State& s) {
+    s.policy.setDataSaver(e);
+    return 0;
+  });
+}
+int SocketPolicyProjection::setUidPermission(int32_t u, uint32_t p) {
+  return update([=](State& s) { return s.permissions.set(u, p); });
+}
+int SocketPolicyProjection::setIif(int32_t u, uint32_t i) {
+  return update([=](State& s) { return s.ingress.setIif(u, i); });
+}
+int SocketPolicyProjection::clearIif(int32_t u) {
+  return update([=](State& s) { return s.ingress.clearIif(u); });
+}
+int SocketPolicyProjection::setLockdown(int32_t u, bool e) {
+  return update([=](State& s) { return s.ingress.setLockdown(u, e); });
+}
+int SocketPolicyProjection::setDiscard(const IngressPolicy::Address& a,
+                                       uint32_t f, uint32_t b) {
+  return update([=](State& s) { return s.ingress.setDiscard(a, f, b); });
+}
+int SocketPolicyProjection::clearDiscard(const IngressPolicy::Address& a) {
+  return update([=](State& s) { return s.ingress.clearDiscard(a); });
+}
+int SocketPolicyProjection::setLocalEntry(LocalNetworkState::Table t,
+                                          LocalNetworkState::Entry e) {
+  return update([=](State& s) { return s.local.set(t, e); });
+}
+int SocketPolicyProjection::clearLocalEntry(LocalNetworkState::Table t,
+                                            LocalNetworkState::Entry e) {
+  return update([=](State& s) { return s.local.erase(t, e); });
+}
+int SocketPolicyProjection::readLoopbackEvents(
+    NetpolicyLease::LoopbackBatch* output) {
+  if (!output) return -EINVAL;
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mCommit) return -EAGAIN;
+  int r = mLease.readLoopbackEvents(output);
+  return r ? quarantine(r) : 0;
+}
