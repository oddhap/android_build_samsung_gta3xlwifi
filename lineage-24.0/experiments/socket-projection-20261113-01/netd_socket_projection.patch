+std::vector<std::string> chainNames(
+    const std::vector<CheckedUidChains::Chain>& image) {
+  std::vector<std::string> next;
+  for (const auto& c : image) next.push_back(c.name);
+  return next;
+}
+bool same(const NetpolicyLease::PermissionImage& a,
+          const NetpolicyLease::PermissionImage& b) {
+  return a.revision == b.revision && a.entries == b.entries;
+}
+bool same(const NetpolicyLease::LocalNetworkImage& a,
+          const NetpolicyLease::LocalNetworkImage& b) {
+  return a.revision == b.revision && a.network == b.network && a.host == b.host;
