+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiCheckedUidChains.h"
+#include "Gta3xlwifiNetpolicyLease.h"
+#include <array>
+#include <set>
+
+namespace android::net::gta3xlwifi {
+// Private table bootstrap only. The sole backend owner MUST hold its complete
+// transaction mutex across this object, chain writes and UID/LNA publication.
+// Never releases the gate or advertises backend readiness. A failure closes the
+// lease, retaining the gate even after a partial family/root update.
+class SocketRoots final {
+public:
+    using Image = std::vector<CheckedUidChains::Chain>;
+    SocketRoots(IptablesRestoreInterface& kernel, NetpolicyLease& lease)
+        : mKernel(kernel), mLease(lease), mChains(kernel, CheckedUidChains::Table::Socket) {}
+    // Create missing chains only in an inert DROP table with no rules. Existing
+    // complete programs are parsed and retained; foreign input is never replayed.
+    int prepare();
+    // Requires a complete checked ordinary image already installed in BOTH
+    // families. Adds owned jumps before ACCEPT policy; exact readback required.
+    int activate(const Image& expected);
+    int verify(const Image& expected);
+private:
+    struct Inventory {
+        std::set<std::string> users;
+        std::array<bool, 2> accept{}, jump{};
+        bool userRules = false;
+    };
+    static std::vector<std::string> names();
+    static int validate(const Image& image);
+    int held();
+    int fail(int error);
+    int inventory(IptablesTarget family, Inventory* output);
+    int readImage(IptablesTarget family, const Image* expected);
+    int check(IptablesTarget family, const Inventory& state, const Image& expected, bool active);
+    int verifyLocked(const Image& expected);
+    IptablesRestoreInterface& mKernel;
+    NetpolicyLease& mLease;
+    CheckedUidChains mChains;
+    std::mutex mMutex;
+};
+}  // namespace android::net::gta3xlwifi
