+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiPolicyFrame.h"
+#include <cerrno>
+#include <set>
+namespace android::net::gta3xlwifi {
+namespace {
+constexpr std::array<uint32_t, PolicyFrame::SectionCount> Width{1,1,2,2,2,4,6,8,8,1};
+constexpr std::array<uint32_t, PolicyFrame::SectionCount> Limit{
+    65536,65536,131072,24,480000,80000,600,8000,8000,1000};
+bool boolean(int32_t value) { return value == 0 || value == 1; }
+void addressWord(uint32_t word, uint8_t* out) {
+  // Explicit network byte order, independent of host/Parcel CPU byte order.
+  for (unsigned n=0;n<4;++n) out[n] = word >> (24-8*n);
+}
+}
+void PolicyFrame::clear() {
+  mBegun = false;
+  mCounts.fill(0);
+  for (auto& section : mWords) std::vector<int32_t>().swap(section);
+}
+int PolicyFrame::begin(const std::vector<int32_t>& counts, uint32_t flags,
+                       bool loopback, bool migration, bool dataSaver) {
+  if (mBegun) return -EBUSY;
+  if (!migration) return -EOPNOTSUPP; // Actual A17 canonical full-UID mode required.
+  if (counts.size()!=SectionCount || (flags & ~7u)) return -EINVAL;
+  uint32_t total = 0;
+  for (size_t i=0;i<SectionCount;++i) {
+    if (counts[i]<0 || static_cast<uint32_t>(counts[i])>Limit[i] ||
+        counts[i]%Width[i]) return -EINVAL;
+    total += counts[i];
+  }
+  if (total>MaxWords) return -E2BIG;
+  // Every actual chain, including disabled chains, must be supplied explicitly.
+  if (counts[ChainConfiguration]!=24) return -EPROTO;
+  for (size_t i=0;i<SectionCount;++i) mCounts[i]=counts[i];
+  mFlags=flags; mLoopback=loopback; mDataSaver=dataSaver; mBegun=true;
+  return 0;
+}
+int PolicyFrame::append(uint32_t section, uint32_t offset,
+                        const std::vector<int32_t>& words) {
+  if (!mBegun) return -ENOTCONN;
+  if (section>=SectionCount || words.empty() || words.size()>ChunkWords) return -EINVAL;
+  auto& destination=mWords[section];
+  if (offset!=destination.size()) return -ESTALE;
+  if (words.size()>mCounts[section]-destination.size()) return -E2BIG;
+  destination.insert(destination.end(),words.begin(),words.end());
+  return 0;
+}
+int PolicyFrame::compile(SocketPolicyProjection::State* output) const {
+  if (!output) return -EINVAL;
+  if (!mBegun) return -ENOTCONN;
+  for (size_t i=0;i<SectionCount;++i) if (mWords[i].size()!=mCounts[i]) return -EAGAIN;
+  SocketPolicyProjection::State next;
+  PermissionBootstrap::Snapshot permissions;
+  permissions.users=mWords[Users]; permissions.knownUids=mWords[KnownUids];
+  permissions.loopbackPermissionEnabled=mLoopback;
+  const auto& raw=mWords[RawPermissions];
+  for (size_t i=0;i<raw.size();i+=2) permissions.observed.push_back({raw[i],static_cast<uint32_t>(raw[i+1])});
+  int result=PermissionBootstrap::compile(permissions,&next.permissions);
+  if (result) return result;
+  std::set<int32_t> chains;
+  const auto& config=mWords[ChainConfiguration];
+  for (size_t i=0;i<config.size();i+=2) {
+    if (!boolean(config[i+1]) || !chains.insert(config[i]).second) return -EINVAL;
+    if ((result=next.policy.setChainEnabled(config[i],config[i+1]))) return result;
+  }
+  for (const auto& chain:UidPolicy::chains()) if (!chains.count(chain.id)) return -EPROTO;
+  std::set<std::pair<int32_t,int32_t>> memberships;
+  const auto& members=mWords[ChainMembership];
+  for (size_t i=0;i<members.size();i+=2) {
+    if (!memberships.emplace(members[i],members[i+1]).second) return -EINVAL;
+  }
+  for (const auto& chain:UidPolicy::chains()) {
+    std::vector<int32_t> uids;
+    for (const auto& member:memberships) if (member.first==chain.id) uids.push_back(member.second);
+    if ((result=next.policy.replaceUidChain(chain.id,uids))) return result;
+  }
+  for (const auto& member:memberships) if (!chains.count(member.first)) return -EINVAL;
+  next.policy.setDataSaver(mDataSaver);
+  std::set<int32_t> owners;
+  const auto& ingress=mWords[IngressOwners];
+  for (size_t i=0;i<ingress.size();i+=4) {
+    if (!boolean(ingress[i+1]) || !boolean(ingress[i+3]) ||
+        (!ingress[i+1] && ingress[i+2]) || !owners.insert(ingress[i]).second) return -EINVAL;
+    if (ingress[i+1] && (result=next.ingress.setIif(ingress[i],static_cast<uint32_t>(ingress[i+2])))) return result;
+    if ((result=next.ingress.setLockdown(ingress[i],ingress[i+3]))) return result;
+  }
+  std::set<IngressPolicy::Address> discards;
+  const auto& discard=mWords[DiscardAddresses];
+  for (size_t i=0;i<discard.size();i+=6) {
+    IngressPolicy::Address address{};
+    for (unsigned n=0;n<4;++n) addressWord(discard[i+n],address.data()+4*n);
+    if (!discards.insert(address).second) return -EINVAL;
+    if ((result=next.ingress.setDiscard(address,static_cast<uint32_t>(discard[i+4]),static_cast<uint32_t>(discard[i+5])))) return result;
+  }
+  for (auto section:{LocalNetworks,LocalHosts}) {
+    std::vector<LocalNetworkState::Entry> entries;
+    const auto& words=mWords[section];
+    for (size_t i=0;i<words.size();i+=8) {
+      if (words[i]<0 || !boolean(words[i+7])) return -EINVAL;
+      LocalNetworkState::Entry entry{static_cast<uint32_t>(words[i]),{},words[i+7]!=0};
+      for (unsigned n=0;n<6;++n) addressWord(words[i+1+n],entry.key.data()+4*n);
+      entries.push_back(entry);
+    }
+    // replace validates duplicate canonical prefixes rather than overwriting.
+    std::vector<LocalNetworkState::Entry> network,host;
+    if ((result=next.local.snapshot(&network,&host))) return result;
+    if (section==LocalNetworks) network=std::move(entries); else host=std::move(entries);
+    if ((result=next.local.replace(network,host))) return result;
+  }
+  next.runtime.supplied=true; next.runtime.flags=mFlags;
+  for (int32_t uid:mWords[LegacyBlockedUids]) {
+    if (uid<0 || (!next.runtime.legacyBlockedUids.empty() &&
+        next.runtime.legacyBlockedUids.back()>=static_cast<uint32_t>(uid))) return -EINVAL;
+    next.runtime.legacyBlockedUids.push_back(uid);
+  }
+  *output=std::move(next);
+  return 0;
+}
