+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.net;
+/**
+ * Private gta3xlwifi complete policy transport, separate from frozen INetd.
+ * Protocol 1. Every call requires the system UID, including transferred handles.
+ * A session or completed transport is not a networking readiness signal.
+ * Sections/word encoding are defined by Gta3xlwifiPolicyFrame.h/.cpp.
+ * Chunks have at most 4096 ints; the complete image is bounded independently.
+ * @hide
+ */
+interface IGta3xlwifiNetpolicy {
+    long openSession(IBinder client, int protocolVersion);
+    void beginFrame(long session, long expectedGeneration, in int[] wordCounts,
+            int runtimeFlags, boolean loopbackPermissionEnabled,
+            boolean uidMigrationEnabled, boolean dataSaverEnabled);
+    void appendFrame(long session, int section, int offset, in int[] words);
+    long commitFrame(long session);
+    void abandonFrame(long session);
+}
