+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <array>
+#include "Gta3xlwifiSocketPolicyProjection.h"
+namespace android::net::gta3xlwifi {
+// Bounded ordered IPC staging. All sections are explicitly declared, including
+// empty ones. Nothing changes the owner/kernel until a complete frame compiles.
+class PolicyFrame final {
+ public:
+  enum Section : uint32_t {
+    Users, KnownUids, RawPermissions, ChainConfiguration, ChainMembership,
+    IngressOwners, DiscardAddresses, LocalNetworks, LocalHosts, LegacyBlockedUids,
+    SectionCount
+  };
+  static constexpr uint32_t ChunkWords = 4096;
+  static constexpr uint32_t MaxWords = 1000000;
+  int begin(const std::vector<int32_t>& wordCounts, uint32_t runtimeFlags,
+            bool loopbackPermission, bool uidMigration, bool dataSaver);
+  int append(uint32_t section, uint32_t offset, const std::vector<int32_t>& words);
+  int compile(SocketPolicyProjection::State* output) const;
+  void clear();
+ private:
+  bool mBegun = false, mLoopback = false, mDataSaver = false;
+  uint32_t mFlags = 0;
+  std::array<size_t, SectionCount> mCounts{};
+  std::array<std::vector<int32_t>, SectionCount> mWords;
+};
+}  // namespace android::net::gta3xlwifi
