+#define _NET_GTA3XLWIFI_LOCAL_NETWORK_H
+#include <linux/types.h>
+struct in6_addr;
+/* ONLY authenticated exclusive owner dispatch under its mutex may call ioctl.
+ * SET additionally requires the real shared gate held and readers drained.
+ */
+long gta3xlwifi_lna_ioctl(unsigned int cmd, unsigned long arg);
+/* UID already normalized as A17 traffic-accounting caller: raw65534 ->0.
+ * Caller supplies the parsed remote endpoint/current interface. No cache or
+ * packet/DNS/loopback applicability decision is invented by this store helper.
+ */
+bool gta3xlwifi_lna_blocked(u32 uid, u32 if_index, const struct in6_addr *remote,
+                           u16 protocol, __be16 remote_port);
+#endif
