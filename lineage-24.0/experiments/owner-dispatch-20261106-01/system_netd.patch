diff --git a/server/Gta3xlwifiOrdinaryDispatch.cpp b/server/Gta3xlwifiOrdinaryDispatch.cpp
new file mode 100644
--- /dev/null
+++ b/server/Gta3xlwifiOrdinaryDispatch.cpp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiOrdinaryDispatch.h"
+#include <cerrno>
+#include <utility>
+namespace android::net::gta3xlwifi {
+int OrdinaryDispatch::append(UidChainProgram::Image* image) {
+    if (!image) return -EINVAL;
+    using C = CheckedUidChains;
+    auto next = *image;
+    for (const auto name : {"g24_owner_in", "g24_owner_out"}) {
+        C::Chain root{name, {{C::UidRange{0, 9999}, C::Verdict::Return, C::Selector::RawAppId},
+                            {std::nullopt, C::Verdict::Return, C::Selector::OwnerSkip}}};
+        for (uint8_t id = 1; id <= 9; ++id) {
+            root.rules.push_back({std::nullopt, C::Verdict::UidCall,
+                id == 6 ? C::Selector::NonLoopback : C::Selector::Owner, id});
+        }
+        root.rules.push_back({std::nullopt, C::Verdict::Return});
+        next.push_back(std::move(root));
+    }
+    int result = C::validateImage(next);
+    if (result) return result;
+    *image = std::move(next);
+    return 0;
+}
+}  // namespace android::net::gta3xlwifi
diff --git a/server/Gta3xlwifiOrdinaryDispatch.h b/server/Gta3xlwifiOrdinaryDispatch.h
new file mode 100644
--- /dev/null
+++ b/server/Gta3xlwifiOrdinaryDispatch.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiUidChainProgram.h"
+namespace android::net::gta3xlwifi {
+// Append ONLY the ordinary UID dispatch portion. Requires all nine owned child
+// chains already in the image. No attachments or independent LNA/loopback/VPN,
+// DNS/CLAT exemptions, complete owner lifecycle or network readiness are supplied.
+class OrdinaryDispatch {
+public:
+    static int append(UidChainProgram::Image* image);
+};
+}  // namespace android::net::gta3xlwifi
