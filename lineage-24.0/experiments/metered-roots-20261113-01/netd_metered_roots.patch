+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiCheckedUidChains.h"
+#include "Gta3xlwifiNetpolicyLease.h"
+#include <array>
+#include <set>
+namespace android::net::gta3xlwifi {
+// Bridge from EXISTING BandwidthController costly-interface paths to the three
+// owned metered chains. Caller must serialize all firewall changes/transactions.
+// Existing parent rules must be EMPTY or exact known prefixes; foreign/BPF
+// rules are rejected, never automatically replaced. No release/Ready callback.
+class MeteredRoots final {
+public:
+    using Image=std::vector<CheckedUidChains::Chain>;
+    MeteredRoots(IptablesRestoreInterface& kernel,NetpolicyLease& lease)
+        : mKernel(kernel),mLease(lease),mChains(kernel) {}
+    static int validateImage(const Image& image);
+    int prepare();
+    int verifyPrepared();
+    int activate(const Image& expected);
+    int verify(const Image& expected);
+private:
+    struct Inventory {
+        std::set<std::string> users;
+        std::array<std::vector<std::string>,2> parents;
+        std::vector<std::string> foreign;
+        bool ownedRules=false;
+    };
+    static std::vector<std::string> names();
+    static std::array<std::vector<std::string>,2> parentRules(IptablesTarget family);
+    int fail(int error);
+    int held();
+    int inventory(IptablesTarget family,Inventory* output);
+    int image(IptablesTarget family,Image* output);
+    int verifyLocked(const Image* expected,bool active);
+    IptablesRestoreInterface& mKernel;
+    NetpolicyLease& mLease;
+    CheckedUidChains mChains;
+    std::mutex mMutex;
+};
+}  // namespace android::net::gta3xlwifi
