diff --git a/net/netfilter/xt_qtaguid.c b/net/netfilter/xt_qtaguid.c
--- a/net/netfilter/xt_qtaguid.c
+++ b/net/netfilter/xt_qtaguid.c
@@ -23,6 +23,7 @@
 #include <linux/netfilter/xt_qtaguid.h>
 #include <uapi/linux/netfilter/xt_qtaguid_sock.h>
 #include <uapi/linux/netfilter/gta3xlwifi_appid.h>
+#include <uapi/linux/netfilter/gta3xlwifi_socket_uid.h>
 #include <linux/ratelimit.h>
 #include <linux/seq_file.h>
 #include <linux/skbuff.h>
@@ -3098,7 +3099,7 @@
 	const struct gta3xlwifi_appid_match *info = par->matchinfo;
 	struct sock *sk;
 	bool referenced = false;
-	uid_t uid = 65534;
+	uid_t uid = overflowuid;
 	unsigned int appid;
 
 	if (!skb)
@@ -3152,3 +3153,101 @@
 module_init(gta3xlwifi_appid_init);
 MODULE_ALIAS("ipt_gta3xlwifi_appid");
 MODULE_ALIAS("ip6t_gta3xlwifi_appid");
+
+/* Match the raw socket-UID semantics used by Android17's xtbpf allow/deny
+ * helpers. No slow socket lookup here: absent/non-full sockets use the actual
+ * overflowuid, and only the appId/core view normalizes default65534 to root.
+ */
+static uid_t gta3xlwifi_raw_socket_uid(const struct sk_buff *skb)
+{
+	struct sock *sk = skb_to_full_sk(skb);
+	struct net *net;
+
+	if (!sk || !sk_fullsock(sk))
+		return overflowuid;
+	net = sock_net(sk);
+	return from_kuid_munged(net->user_ns, sock_net_uid(net, sk));
+}
+
+static bool gta3xlwifi_raw_uid_mt(const struct sk_buff *skb,
+                                struct xt_action_param *par)
+{
+	const struct gta3xlwifi_socket_uid_match *info = par->matchinfo;
+	uid_t uid;
+
+	if (!skb)
+		return false;
+	uid = gta3xlwifi_raw_socket_uid(skb);
+	return uid >= info->minimum && uid <= info->maximum;
+}
+
+static bool gta3xlwifi_raw_appid_mt(const struct sk_buff *skb,
+                                  struct xt_action_param *par)
+{
+	const struct gta3xlwifi_socket_uid_match *info = par->matchinfo;
+	uid_t uid;
+
+	if (!skb)
+		return false;
+	uid = gta3xlwifi_raw_socket_uid(skb);
+	if (uid == 65534)
+		uid = 0;
+	uid %= GTA3XLWIFI_APPID_USER_OFFSET;
+	return uid >= info->minimum && uid <= info->maximum;
+}
+
+static int gta3xlwifi_raw_uid_check(const struct xt_mtchk_param *par)
+{
+	const struct gta3xlwifi_socket_uid_match *info = par->matchinfo;
+
+	if (current_user_ns() != &init_user_ns ||
+	    (par->family != NFPROTO_IPV4 && par->family != NFPROTO_IPV6) ||
+	    info->minimum > info->maximum)
+		return -EINVAL;
+	return 0;
+}
+
+static int gta3xlwifi_raw_appid_check(const struct xt_mtchk_param *par)
+{
+	const struct gta3xlwifi_socket_uid_match *info = par->matchinfo;
+	int result = gta3xlwifi_raw_uid_check(par);
+
+	if (result)
+		return result;
+	return info->maximum < GTA3XLWIFI_APPID_USER_OFFSET ? 0 : -EINVAL;
+}
+
+static struct xt_match gta3xlwifi_raw_uid_reg[] __read_mostly = {
+	{
+		.name = GTA3XLWIFI_RAW_UID_MATCH,
+		.revision = 0,
+		.family = NFPROTO_UNSPEC,
+		.hooks = (1 << NF_INET_LOCAL_IN) | (1 << NF_INET_FORWARD) |
+		         (1 << NF_INET_LOCAL_OUT),
+		.match = gta3xlwifi_raw_uid_mt,
+		.checkentry = gta3xlwifi_raw_uid_check,
+		.matchsize = sizeof(struct gta3xlwifi_socket_uid_match),
+		.me = THIS_MODULE,
+	}, {
+		.name = GTA3XLWIFI_RAW_APPID_MATCH,
+		.revision = 0,
+		.family = NFPROTO_UNSPEC,
+		.hooks = (1 << NF_INET_LOCAL_IN) | (1 << NF_INET_FORWARD) |
+		         (1 << NF_INET_LOCAL_OUT),
+		.match = gta3xlwifi_raw_appid_mt,
+		.checkentry = gta3xlwifi_raw_appid_check,
+		.matchsize = sizeof(struct gta3xlwifi_socket_uid_match),
+		.me = THIS_MODULE,
+	},
+};
+
+static int __init gta3xlwifi_raw_uid_init(void)
+{
+	return xt_register_matches(gta3xlwifi_raw_uid_reg,
+	                          ARRAY_SIZE(gta3xlwifi_raw_uid_reg));
+}
+module_init(gta3xlwifi_raw_uid_init);
+MODULE_ALIAS("ipt_gta3xlwifi_raw_uid");
+MODULE_ALIAS("ip6t_gta3xlwifi_raw_uid");
+MODULE_ALIAS("ipt_gta3xlwifi_raw_appid");
+MODULE_ALIAS("ip6t_gta3xlwifi_raw_appid");
diff --git a/include/uapi/linux/netfilter/gta3xlwifi_socket_uid.h b/include/uapi/linux/netfilter/gta3xlwifi_socket_uid.h
