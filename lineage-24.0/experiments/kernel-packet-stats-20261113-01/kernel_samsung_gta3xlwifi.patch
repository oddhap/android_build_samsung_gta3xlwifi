+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_GTA3XLWIFI_PACKET_STATS_H
+#define _NET_GTA3XLWIFI_PACKET_STATS_H
+#include <linux/types.h>
+#include <uapi/linux/netfilter/gta3xlwifi_packet_stats.h>
+struct sock;struct sk_buff;
+/* Caller protects actual supplied socket/skb. No tag lookup/permission verdict,
+ * skb mutation/free or user-injectable counter API. Errors are diagnostic;
+ * accounting capacity must never change a packet's security verdict.
+ */
+int gta3xlwifi_packet_stats_record(struct sock *sk,const struct sk_buff *skb,
+                                 u32 stats_uid,u32 tag,u32 ifindex,bool output);
+void gta3xlwifi_packet_stats_lost(void);
+u32 gta3xlwifi_packet_stats_features(void);
+long gta3xlwifi_packet_stats_ioctl(unsigned int cmd,unsigned long arg);
+#endif
