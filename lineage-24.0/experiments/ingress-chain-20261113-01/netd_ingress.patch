+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Gta3xlwifiCheckedUidChains.h"
+#include <map>
+namespace android::net::gta3xlwifi {
+// Canonical private control state only. No kernel I/O, release or publication.
+// The backend must transact this with ordinary/metered/UID/LNA state together.
+class IngressPolicy final {
+public:
+    using Address = std::array<uint8_t,16>;
+    int setIif(int32_t uid, uint32_t ifindex);
+    int clearIif(int32_t uid);
+    int setLockdown(int32_t uid, bool enabled);
+    int removeUid(int32_t uid);
+    int setDiscard(const Address& address, uint32_t first, uint32_t second);
+    int clearDiscard(const Address& address);
+    // Input must be the complete original11-chain ordinary compiler image.
+    // Adds discard then IIF DROP records inside the existing input exemptions.
+    // Output is unchanged on any validation/encoding error.
+    int compile(const std::vector<CheckedUidChains::Chain>& ordinary,
+                std::vector<CheckedUidChains::Chain>* output) const;
+private:
+    struct Owner { bool hasIif=false; uint32_t ifindex=0; bool lockdown=false; };
+    int update(int32_t uid, const Owner& owner);
+    std::map<int32_t,Owner> mOwners;
+    std::map<Address,std::array<uint32_t,2>> mDiscard;
+};
+}  // namespace android::net::gta3xlwifi
