+
+void security_netlink_state(struct selinux_netlink_state *state)
+{
+	read_lock(&policy_rwlock);
+	state->seqno = latest_granting;
+	state->initialized = ss_initialized;
+	state->xperm = ss_initialized ? selinux_policycap_netlink_xperm : 0;
+	state->route = ss_initialized ? selinux_android_netlink_route : 0;
+	state->alwaysnetwork = ss_initialized ? selinux_policycap_alwaysnetwork : 0;
+	state->allow_unknown = ss_initialized ? policydb.allow_unknown : 0;
+	read_unlock(&policy_rwlock);
+}
+
+int security_netlink_state_valid(const struct selinux_netlink_state *state)
+{
+	int valid;
+
+	read_lock(&policy_rwlock);
+	valid = state->seqno == latest_granting &&
+		state->initialized == ss_initialized;
+	read_unlock(&policy_rwlock);
+	return valid;
 }
 
