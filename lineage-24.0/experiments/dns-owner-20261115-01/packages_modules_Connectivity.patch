+// Local port extension, deliberately distinct from the older bool callback ABI.
+// Register only after real held firewall/producer verification.
+// Registration is transport presence, never policy or networking Ready.
+int ADnsHelper_setLegacyCallbackV2(int (*callback)(uid_t uid, bool metered));
+// Explicit resolver DSO wrapper: native netd must register the helper instance
+// actually linked into the resolver, never a second static-library copy.
+__attribute__((visibility("default"))) int resolv_set_gta3xlwifi_policy(int (*callback)(uid_t uid, bool metered));
