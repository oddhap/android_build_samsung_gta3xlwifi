+Status NetpolicyService::readGeneration(int64_t session,int64_t* output) {
+  if (!authorized()) return denied();
+  if (!output) return status(-EINVAL);
+  std::lock_guard lock(mMutex);
+  int result=validateSession(session);
+  if (result) return status(result);
+  uint64_t generation=0;
+  result=mOwner.frameworkGeneration(&generation);
+  if (result) return status(result);
+  if (generation>INT64_MAX) return status(-EOVERFLOW);
+  *output=static_cast<int64_t>(generation);
+  return Status::ok();
+}
+Status NetpolicyService::closeSession(const sp<IBinder>& client) {
+  if (!authorized()) return denied();
+  std::lock_guard lock(mMutex);
+  if (!client || !mClient || client!=mClient) return status(-ESTALE);
+  mFrame.clear();
+  int result=mOwner.suspendFrameworkClient();
+  // Death may already be queued: its session check still rejects a later owner.
+  mClient->unlinkToDeath(mDeath);
+  mClient.clear(); mDeath.clear(); mSession=0;
+  return status(result);
+}
 void NetpolicyService::clientDied(int64_t session) {
