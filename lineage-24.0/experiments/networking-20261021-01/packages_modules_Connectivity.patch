@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace android::bpf::legacy {
+// Kernel counters are cumulative. The upper bound matches NetworkStats' jlong ABI.
+struct Record {
+    std::string iface;
+    uint32_t uid = 0;
+    uint32_t set = 0;
+    uint32_t tag = 0;
+    std::array<int64_t, 4> counters{};  // rx bytes/packets, tx bytes/packets
+};
+
+// Parse the actual Samsung xt_qtaguid schemas. On error, leave output unchanged.
+// A header-only table is valid; an absent/malformed table is not zero traffic.
+int readStats(FILE* file, bool detail, std::vector<Record>* output);
+int addCounters(const std::array<int64_t, 4>& value, std::array<int64_t, 4>* sum);
+}  // namespace android::bpf::legacy
