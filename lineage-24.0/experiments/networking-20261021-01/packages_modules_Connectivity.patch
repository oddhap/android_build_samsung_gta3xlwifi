diff --git a/bpf/dns_helper/LegacyDnsPolicy.h b/bpf/dns_helper/LegacyDnsPolicy.h
new file mode 100644
--- /dev/null
+++ b/bpf/dns_helper/LegacyDnsPolicy.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <atomic>
+#include <cerrno>
+#include <sys/types.h>
+
+namespace android::net {
+// Private device-port extension, not an Android SDK API. Errors are never an
+// allow decision. The policy owner must register only after its real firewall
+// state is initialized; subsequent policy updates are synchronized by that owner.
+class LegacyDnsPolicy {
+ public:
+  using Callback = int (*)(uid_t, bool);  // 0 allow, 1 block, negative errno.
+
+  int setCallback(Callback callback) {
+    if (!callback) return -EINVAL;
+    Callback expected = nullptr;
+    if (mCallback.compare_exchange_strong(expected, callback, std::memory_order_acq_rel,
+                                         std::memory_order_acquire)) return 0;
+    return expected == callback ? 0 : -EALREADY;
+  }
+
+  bool ready() const { return mCallback.load(std::memory_order_acquire) != nullptr; }
+
+  int evaluate(uid_t uid, bool metered) const {
+    Callback callback = mCallback.load(std::memory_order_acquire);
+    if (!callback) return -ENOTCONN;
+    const int result = callback(uid, metered);
+    // Bound errno before any caller negates it; reject malformed bool/status values.
+    return result < -4095 || result > 1 ? -EPROTO : result;
+  }
+
+ private:
+  std::atomic<Callback> mCallback{nullptr};
+};
+}  // namespace android::net
