diff --git a/service-t/native/libs/libnetworkstats/QtaguidStats.cpp b/service-t/native/libs/libnetworkstats/QtaguidStats.cpp
new file mode 100644
--- /dev/null
+++ b/service-t/native/libs/libnetworkstats/QtaguidStats.cpp
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "QtaguidStats.h"
+
+#include <cerrno>
+#include <charconv>
+#include <cstdlib>
+#include <limits>
+#include <set>
+#include <string_view>
+#include <tuple>
+#include <sys/types.h>
+
+namespace android::bpf::legacy {
+namespace {
+constexpr std::string_view kDetailHeader =
+        "idx iface acct_tag_hex uid_tag_int cnt_set rx_bytes rx_packets tx_bytes tx_packets "
+        "rx_tcp_bytes rx_tcp_packets rx_udp_bytes rx_udp_packets rx_other_bytes rx_other_packets "
+        "tx_tcp_bytes tx_tcp_packets tx_udp_bytes tx_udp_packets tx_other_bytes tx_other_packets";
+constexpr std::string_view kIfaceHeader =
+        "ifname total_skb_rx_bytes total_skb_rx_packets total_skb_tx_bytes total_skb_tx_packets "
+        "rx_tcp_bytes rx_tcp_packets rx_udp_bytes rx_udp_packets rx_other_bytes rx_other_packets "
+        "tx_tcp_bytes tx_tcp_packets tx_udp_bytes tx_udp_packets tx_other_bytes tx_other_packets";
+
+struct Line {
+    char* data = nullptr;
+    size_t capacity = 0;
+    ~Line() { free(data); }
+};
+
+bool space(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }
+
+std::vector<std::string_view> fields(std::string_view line) {
+    std::vector<std::string_view> result;
+    while (!line.empty()) {
+        if (space(line.front())) { line.remove_prefix(1); continue; }
+        size_t n = 0;
+        while (n < line.size() && !space(line[n])) ++n;
+        result.push_back(line.substr(0, n));
+        line.remove_prefix(n);
+    }
+    return result;
+}
+
+int number(std::string_view token, uint64_t max, uint64_t* value, int base = 10) {
+    if (token.empty() || token.front() == '-' || token.front() == '+') return -EINVAL;
+    auto result = std::from_chars(token.data(), token.data() + token.size(), *value, base);
+    if (result.ec == std::errc::result_out_of_range || *value > max) return -EOVERFLOW;
+    return result.ec == std::errc{} && result.ptr == token.data() + token.size() ? 0 : -EINVAL;
+}
+
+bool ifaceName(std::string_view name) {
+    // Match Linux interface length; never allow whitespace, paths or truncated names.
+    if (name.empty() || name.size() >= 16 || name == "." || name == "..") return false;
+    for (unsigned char c : name) if (c <= ' ' || c == '/' || c == ':' || c == 127) return false;
+    return true;
+}
+}  // namespace
+
+int addCounters(const std::array<int64_t, 4>& value, std::array<int64_t, 4>* sum) {
+    if (!sum) return -EINVAL;
+    auto next = *sum;
+    for (size_t i = 0; i < next.size(); ++i) {
+        if (next[i] < 0 || value[i] < 0) return -EINVAL;
+        if (value[i] > std::numeric_limits<int64_t>::max() - next[i]) return -EOVERFLOW;
+        next[i] += value[i];
+    }
+    *sum = next;
+    return 0;
+}
+
+int readStats(FILE* file, bool detail, std::vector<Record>* output) {
+    if (!file || !output) return -EINVAL;
+    Line line;
+    errno = 0;
+    ssize_t n = getline(&line.data, &line.capacity, file);
+    if (n < 0) return ferror(file) ? -(errno ? errno : EIO) : -EINVAL;
+    if (n > 4096 || std::string_view(line.data, n).find('\0') != std::string_view::npos)
+        return -EINVAL;
+    if (fields({line.data, static_cast<size_t>(n)}) != fields(detail ? kDetailHeader : kIfaceHeader))
+        return -EINVAL;
+
+    std::vector<Record> next;
+    std::set<std::tuple<std::string, uint32_t, uint32_t, uint32_t>> seen;
+    uint64_t previousIndex = 1;  // Samsung pp_stats_line starts at index 2.
+    while (true) {
+        errno = 0;
+        n = getline(&line.data, &line.capacity, file);
+        if (n < 0) {
+            if (ferror(file)) return -(errno ? errno : EIO);
+            break;
+        }
+        if (n > 4096 || std::string_view(line.data, n).find('\0') != std::string_view::npos)
+            return -EINVAL;
+        auto columns = fields({line.data, static_cast<size_t>(n)});
+        if (columns.size() != (detail ? 21U : 17U)) return -EINVAL;
+        Record row;
+        row.iface = std::string(columns[detail ? 1 : 0]);
+        if (!ifaceName(row.iface)) return -EINVAL;
+        if (detail) {
+            uint64_t index = 0, tag = 0, uid = 0, set = 0;
+            int error = number(columns[0], UINT32_MAX, &index);
+            if (error) return error;
+            if (index != previousIndex + 1) return -EINVAL;
+            previousIndex = index;
+            auto tagText = columns[2];
+            if (tagText.size() <= 2 || tagText.substr(0, 2) != "0x") return -EINVAL;
+            if ((error = number(tagText.substr(2), UINT64_MAX, &tag, 16))) return error;
+            if (tag & UINT32_MAX) return -EINVAL;  // Kernel acct_tag excludes low UID bits.
+            if ((error = number(columns[3], INT32_MAX, &uid))) return error;
+            if ((error = number(columns[4], UINT32_MAX, &set))) return error;
+            if (set > 1) return -EINVAL;
+            row.uid = static_cast<uint32_t>(uid);
+            row.set = static_cast<uint32_t>(set);
+            row.tag = static_cast<uint32_t>(tag >> 32);
+        }
+        const size_t start = detail ? 5 : 1;
+        // Validate protocol-breakdown columns too, not just the four aggregate counters.
+        for (size_t i = start; i < columns.size(); ++i) {
+            uint64_t value = 0;
+            int error = number(columns[i], INT64_MAX, &value);
+            if (error) return error;
+            if (i < start + row.counters.size()) row.counters[i - start] = static_cast<int64_t>(value);
+        }
+        if (!seen.emplace(row.iface, row.uid, row.set, row.tag).second) return -EINVAL;
+        next.push_back(std::move(row));
+    }
+    *output = std::move(next);
+    return 0;
+}
+}  // namespace android::bpf::legacy
