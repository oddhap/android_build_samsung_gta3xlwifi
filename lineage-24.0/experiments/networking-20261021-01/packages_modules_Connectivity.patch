diff --git a/service-t/native/libs/libnetworkstats/Gta3xlwifiLegacyStats.cpp b/service-t/native/libs/libnetworkstats/Gta3xlwifiLegacyStats.cpp
new file mode 100644
--- /dev/null
+++ b/service-t/native/libs/libnetworkstats/Gta3xlwifiLegacyStats.cpp
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Gta3xlwifiLegacyStats.h"
+#include "QtaguidStats.h"
+
+#include <android-base/properties.h>
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+
+namespace android::bpf {
+bool gta3xlwifiLegacyStatsEnabled() {
+    return android::base::GetBoolProperty("ro.gta3xlwifi.legacy_networking", false);
+}
+
+static int readRecords(bool detail, std::vector<legacy::Record>* records) {
+    const char* path = detail ? "/proc/net/xt_qtaguid/stats" : "/proc/net/xt_qtaguid/iface_stat_fmt";
+    FILE* file = fopen(path, "re");
+    if (!file) return -errno;
+    int error = legacy::readStats(file, detail, records);
+    if (fclose(file) && !error) error = -(errno ? errno : EIO);
+    return error;
+}
+
+static int readLines(bool detail, std::vector<stats_line>* lines) {
+    if (!lines) return -EINVAL;
+    std::vector<legacy::Record> records;
+    int error = readRecords(detail, &records);
+    if (error) return error;
+    std::vector<stats_line> next;
+    for (const auto& row : records) {
+        stats_line value{};
+        static_assert(sizeof(value.iface) >= 16);
+        memcpy(value.iface, row.iface.c_str(), row.iface.size() + 1);
+        value.uid = detail ? row.uid : UID_ALL;
+        value.set = detail ? row.set : SET_ALL;
+        value.tag = detail ? row.tag : TAG_NONE;
+        value.rxBytes = row.counters[0];
+        value.rxPackets = row.counters[1];
+        value.txBytes = row.counters[2];
+        value.txPackets = row.counters[3];
+        next.push_back(value);
+    }
+    // Kernel keys were checked for uniqueness, so sorting needs no unchecked summation.
+    std::sort(next.begin(), next.end());
+    *lines = std::move(next);
+    return 0;
+}
+
+int gta3xlwifiLegacyDetail(std::vector<stats_line>* lines) { return readLines(true, lines); }
+int gta3xlwifiLegacyDev(std::vector<stats_line>* lines) { return readLines(false, lines); }
+
+static int totalStats(bool detail, uid_t uid, const char* iface, StatsValue* stats) {
+    if (!stats) return -EINVAL;
+    *stats = {};
+    std::vector<legacy::Record> records;
+    int error = readRecords(detail, &records);
+    if (error) return error;
+    std::array<int64_t, 4> sum{};
+    for (const auto& row : records) {
+        if (detail && (row.uid != uid || row.tag != 0)) continue;
+        if (iface && row.iface != iface) continue;
+        if ((error = legacy::addCounters(row.counters, &sum))) return error;
+    }
+    stats->rxBytes = sum[0];
+    stats->rxPackets = sum[1];
+    stats->txBytes = sum[2];
+    stats->txPackets = sum[3];
+    return 0;
+}
+
+int gta3xlwifiLegacyUidStats(uid_t uid, StatsValue* stats) {
+    return totalStats(true, uid, nullptr, stats);
+}
+int gta3xlwifiLegacyIfaceStats(const char* iface, StatsValue* stats) {
+    return totalStats(false, 0, iface, stats);
+}
+}  // namespace android::bpf
