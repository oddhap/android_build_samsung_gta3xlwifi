+int NetpolicyLease::readIfaceStats(IfaceSnapshot* output) {
+    if(!output)return -EINVAL;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if(mFd<0)return -ENOTCONN;
+    std::vector<gta3xlwifi_iface_stats_entry> rows(GTA3XLWIFI_IFACE_STATS_MAX);
+    int result;
+    do{result=ioctl(mFd,GTA3XLWIFI_UID_FEATURES,0UL);}while(result<0&&errno==EINTR);
+    if(result<0)return imageErrorLocked(errno?-errno:-EIO);
+    if(!(result&GTA3XLWIFI_UID_CAP_IFACE_STATS))return imageErrorLocked(-EOPNOTSUPP);
+    gta3xlwifi_iface_stats_transfer request{};
+    do{
+        // A retry takes a FRESH snapshot and resets all output-only metadata.
+        request={};request.version=GTA3XLWIFI_IFACE_STATS_VERSION;
+        request.count=GTA3XLWIFI_IFACE_STATS_MAX;
+        request.entries=reinterpret_cast<uintptr_t>(rows.data());
+        result=ioctl(mFd,GTA3XLWIFI_IFACE_STATS_GET,reinterpret_cast<unsigned long>(&request));
+    }while(result<0&&errno==EINTR);
+    if(result)return imageErrorLocked(result<0?(errno?-errno:-EIO):-EPROTO);
+    if(request.version!=1||request.count>GTA3XLWIFI_IFACE_STATS_MAX||
+       request.entries!=reinterpret_cast<uintptr_t>(rows.data()))return imageErrorLocked(-EPROTO);
+    IfaceSnapshot next;next.entries.reserve(request.count);
+    next.lostUpdates=request.lost_updates;next.updateSequence=request.update_sequence;
+    for(size_t i=0;i<request.count;++i){const auto&r=rows[i];
+        if(r.reserved||r.ifindex>INT_MAX||(i&&rows[i-1].ifindex>=r.ifindex))return imageErrorLocked(-EPROTO);
+        next.entries.push_back({r.ifindex,r.rx_packets,r.rx_bytes,r.tx_packets,r.tx_bytes});
+    }
+    *output=std::move(next);return 0;
+}
