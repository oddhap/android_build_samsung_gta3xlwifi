+namespace android::net::gta3xlwifi {
+int SocketPolicyProjection::verifyHeldProviderStartup() {
+  std::lock_guard<std::mutex> lock(mMutex);
+  if (!mStarted) return -ENOTCONN;
+  if (!mAccountingEnabled) return -EOPNOTSUPP;
+  if (mCommit) return -EALREADY;
+  bool held = false;
+  int result = mLease.isHeld(&held);
+  if (!result && !held) result = -EBUSY;
+  if (!result) result = mLease.requirePolicyPrimitives();
+  if (!result) result = mLease.requireRuntimePolicy();
+  if (!result) result = mLease.requireIfaceAccountingPrimitives();
+  if (!result) result = mLease.requirePacketAccountingPrimitives();
+  if (!result) result = verifyHooks();
+  if (!result) result = mAccounting.verifyProducers();
+  if (!result) result = mSocket.verifyPrepared();
+  if (!result) result = mMeter.verifyPrepared();
+  NetpolicyLease::PacketState state;
+  NetpolicyLease::PacketSnapshot counters;
+  if (!result) result = mLease.readPacketState(&state);
+  if (!result) result = mLease.readActivePacketStats(state.activeEpoch, &counters);
+  return result ? quarantine(result) : 0;
+}
